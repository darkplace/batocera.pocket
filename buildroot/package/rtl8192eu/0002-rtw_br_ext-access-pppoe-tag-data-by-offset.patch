From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Fri, 10 Jul 2026 00:00:00 +000
Subject: [PATCH] rtw_br_ext: access PPPoE tag data by offset

Linux 7.1 hides the trailing flexible-array member in struct pppoe_tag from
kernel code.  Use the payload helper added by the previous patch instead of
naming tag->tag_data directly.

Signed-off-by: suckbluefrog <suckbluefrog@proton.me>
Upstream: not submitted
---
 core/rtw_br_ext.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/core/rtw_br_ext.c b/core/rtw_br_ext.c
index 38c94c3..c4dbd6b 100644
--- a/core/rtw_br_ext.c
+++ b/core/rtw_br_ext.c
@@ -1160,10 +1160,10 @@ int nat25_db_handle(_adapter *priv, struct sk_buff *skb, int method)
 								DEBUG_ERR("SID tag length too long!\n");
 								return -1;
 							}
 
-							memcpy(tag->tag_data + MAGIC_CODE_LEN + RTL_RELAY_TAG_LEN,
-							       pOldTag->tag_data, old_tag_len);
+							memcpy(rtw_pppoe_tag_data(tag) + MAGIC_CODE_LEN + RTL_RELAY_TAG_LEN,
+							       rtw_pppoe_tag_data(pOldTag), old_tag_len);
 
 							if (skb_pull_and_merge(skb, (unsigned char *)pOldTag, TAG_HDR_LEN + old_tag_len) < 0) {
 								DEBUG_ERR("call skb_pull_and_merge() failed in PADI/R packet!\n");
 								return -1;
@@ -1175,9 +1175,9 @@ int nat25_db_handle(_adapter *priv, struct sk_buff *skb, int method)
 						tag->tag_len = htons(MAGIC_CODE_LEN + RTL_RELAY_TAG_LEN + old_tag_len);
 
 						/* insert the magic_code+client mac in relay tag */
-						pMagic = (unsigned short *)tag->tag_data;
+						pMagic = (unsigned short *)rtw_pppoe_tag_data(tag);
 						*pMagic = htons(MAGIC_CODE);
-						memcpy(tag->tag_data + MAGIC_CODE_LEN, skb->data + ETH_ALEN, ETH_ALEN);
+						memcpy(rtw_pppoe_tag_data(tag) + MAGIC_CODE_LEN, skb->data + ETH_ALEN, ETH_ALEN);
 
 						/* Add relay tag */
 						if (__nat25_add_pppoe_tag(skb, tag) < 0)
@@ -1237,16 +1237,16 @@ int nat25_db_handle(_adapter *priv, struct sk_buff *skb, int method)
 						DEBUG_ERR("Invalid PTT_RELAY_SID tag length [%d]!\n", tagLen);
 						return -1;
 					}
 
-					pMagic = (unsigned short *)tag->tag_data;
+					pMagic = (unsigned short *)rtw_pppoe_tag_data(tag);
 					if (ntohs(*pMagic) != MAGIC_CODE) {
 						DEBUG_ERR("Can't find MAGIC_CODE in %s packet!\n",
 							(ph->code == PADO_CODE ? "PADO" : "PADS"));
 						return -1;
 					}
 
-					memcpy(skb->data, tag->tag_data + MAGIC_CODE_LEN, ETH_ALEN);
+					memcpy(skb->data, rtw_pppoe_tag_data(tag) + MAGIC_CODE_LEN, ETH_ALEN);
 
 					if (tagLen > MAGIC_CODE_LEN + RTL_RELAY_TAG_LEN)
 						offset = TAG_HDR_LEN;
 
-- 

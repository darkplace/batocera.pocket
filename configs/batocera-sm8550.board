include batocera-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a76_a55=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_BINUTILS_VERSION_2_43_X=y
BR2_PACKAGE_BATOCERA_TARGET_SM8550=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char -march=armv9-a+i8mm+sm4+sha3+rcpc+crypto+nosve+nosve2"
BR2_STRIP_EXCLUDE_FILES="gk goalc extractor"
BR2_TARGET_GENERIC_GETTY_PORT="ttyMSM0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_BATOCERA_IMAGES="qualcomm/sm8550"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/fsoverlay $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/fsoverlay"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/patches $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/patches"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.0.11"
BR2_KERNEL_HEADERS_7_0=y
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/linux_sm8550-defconfig.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayaneo-pocketace.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayaneo-pocketdmg.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayaneo-pocketds.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayaneo-pocketevo.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayaneo-pockets2k.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayn-odin2.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayn-odin2mini.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayn-odin2portal.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayn-thor.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-retroidpocket-rp6-top-dpad.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-retroidpocket-rp6.dts $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayaneo-pocket-common.dtsi $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8550/dts/qcom/qcs8550-ayn-common.dtsi"
                                                                              
# Filesystem tools
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# GPU
BR2_PACKAGE_BATOCERA_FREEDRENO_MESA3D=y
BR2_PACKAGE_BATOCERA_WAYLAND_SWAY=y
BR2_PACKAGE_BATOCERA_XWAYLAND=y

# Firmware
BR2_PACKAGE_FIRMWARE_ARMBIAN=y

# Bootloader
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_ARM64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 part_msdos part_gpt normal efi_gop search search_fs_file search_fs_uuid search_label chain reboot"

# ABL
BR2_PACKAGE_ROCKNIX_ABL=y
BR2_PACKAGE_HOST_PYTHON_MKBOOTIMG=y

# Batocera Splash Support
BR2_PACKAGE_BATOCERA_SPLASH_MPV=y
BR2_PACKAGE_BATOCERA_KODI21=y

# Arch Plasma LXC desktop
BR2_PACKAGE_BATOCERA_ARCH_PLASMA_LXC=y

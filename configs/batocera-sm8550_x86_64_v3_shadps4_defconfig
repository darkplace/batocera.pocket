# Common configuration for x86-64-v3 shadPS4 guest rootfs builds.

# users
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/users.txt"

# toolchain definition
BR2_OPTIMIZE_2=y
BR2_ENABLE_LTO=y
BR2_SHARED_STATIC_LIBS=y
BR2_GCC_ENABLE_GRAPHITE=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_GCC_VERSION_14_X=y
BR2_EXTRA_GCC_CONFIG_OPTIONS="--disable-libsanitizer"
BR2_INSTALL_LIBSTDCPP=y
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y

# Allow to build GOLD linker, but do not use as default
BR2_BINUTILS_EXTRA_CONFIG_OPTIONS="--enable-gold --enable-plugins"

# Keep the guest rootfs lean; FEX launches shadPS4 directly.
BR2_PACKAGE_BUSYBOX=n

# system
BR2_TARGET_GENERIC_HOSTNAME="batocera"
BR2_TARGET_GENERIC_ISSUE="batocera-shadps4-fex"
BR2_INIT_SYSV=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_ROOT_PASSWD="linux"
BR2_SYSTEM_ENABLE_NLS=y
BR2_ENABLE_LOCALE_WHITELIST="C en"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Paris"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

# Disable full Batocera system packages; this build only feeds the FEX rootfs.
BR2_PACKAGE_BATOCERA_SYSTEM=n
BR2_PACKAGE_BATOCERA_EXTRAS=n
BR2_PACKAGE_BATOCERA_TOOLS=n
BR2_PACKAGE_BATOCERA_ALL_SYSTEMS=n
BR2_PACKAGE_BATOCERA_LINUX_FIRMWARES=n
BR2_SYSTEM_BIN_SH_DASH=y

# Build tar file only - no image, no squashfs
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_NONE=y

# Enables ccache
BR2_CCACHE=y

# Don't purge locales
BR2_ENABLE_LOCALE_PURGE=n

# from file batocera-sm8x50_x86_64_v3_shadps4.packages
# SPDX-FileCopyrightText: Added/modified by suckbluefrog
# x86-64-v3 shadPS4 guest payload for FEX on SM8X50 hosts.

BR2_PACKAGE_SHADPS4=y

# Match the SM8X50 host display path: Wayland client + Qt Wayland + SDL3 Wayland.
BR2_PACKAGE_BATOCERA_WAYLAND=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_UTILS=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_CONCURRENT=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_VULKAN=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="wayland"
BR2_PACKAGE_QT6WAYLAND=y
BR2_PACKAGE_SDL3_WAYLAND=y

# Provide guest GL/EGL/GLES ABI libraries for Qt/Wayland. FEX thunks overlay
# the host-backed libraries at runtime.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_OPENGL_ES2=y
BR2_PACKAGE_SDL3_OPENGLES=y

# Prefer the same audio path as the host image when Qt multimedia is present.
BR2_PACKAGE_QT6MULTIMEDIA_PULSEAUDIO=y

### from board file ###
# SPDX-FileCopyrightText: Added/modified by suckbluefrog
# x86-64-v3 shadPS4 guest rootfs for FEX on SM8550 hosts.


# Target definition - x86-64-v3 userspace
BR2_x86_64=y
BR2_x86_x86_64_v3=y
BR2_PACKAGE_BATOCERA_TARGET_ZEN3=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/patches $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/x86/patches"

# Keep userspace ABI in sync with the SM8550 host build.
BR2_KERNEL_HEADERS_7_0=y

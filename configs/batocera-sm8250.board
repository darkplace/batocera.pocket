include batocera-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a77=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
# Same as sm8550/sm8750: GCC 15 libsanitizer no longer references removed glibc struct termio
BR2_GCC_VERSION_15_X=y
BR2_PACKAGE_BATOCERA_TARGET_SM8250=y
# Use top-level ABL/mkbootimg image script (not per-device EFI/grub paths).
# Matches sm8550/sm8750. Default Kconfig still points at rpflip2 EFI scripts which
# need BR2_TARGET_GRUB2 + efi-part; we boot via ROCKNIX ABL instead.
BR2_TARGET_BATOCERA_IMAGES="qualcomm/sm8250"
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char -mcpu=cortex-a77"
BR2_STRIP_EXCLUDE_FILES="gk goalc extractor"
BR2_TARGET_GENERIC_GETTY_PORT="ttyMSM0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/patches $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8250/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/fsoverlay $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8250/fsoverlay"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.10"
BR2_KERNEL_HEADERS_6_18=y
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8250/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/qualcomm/sm8250/linux_sm8250-defconfig.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sm8250-retroidpocket-flip2 qcom/sm8250-retroidpocket-rp5 qcom/sm8250-retroidpocket-rpmini qcom/sm8250-retroidpocket-rpminiv2"

# System
BR2_PACKAGE_BATOCERA_USE_QCOM_FW=y
BR2_PACKAGE_BATOCERA_KODI21=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# GPU
BR2_PACKAGE_BATOCERA_FREEDRENO_MESA3D=y
BR2_PACKAGE_BATOCERA_WAYLAND_SWAY=y
BR2_PACKAGE_BATOCERA_XWAYLAND=y

# Filesystem tools
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# Bootloader
BR2_PACKAGE_ROCKNIX_ABL=y
BR2_PACKAGE_HOST_PYTHON_MKBOOTIMG=y

# Batocera Splash Support
BR2_PACKAGE_BATOCERA_SPLASH_MPV=y

# x86-64-v3 shadPS4 guest payload for FEX on SM8X50 hosts.

BR2_PACKAGE_SHADPS4=y
BR2_PACKAGE_SHADPS4_QTLAUNCHER=y

# Match the SM8X50 host display path: Wayland client + Qt Wayland + SDL3 Wayland.
BR2_PACKAGE_BATOCERA_WAYLAND=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_UTILS=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_CONCURRENT=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_VULKAN=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="wayland"
BR2_PACKAGE_QT6WAYLAND=y
BR2_PACKAGE_SDL3_WAYLAND=y

# Provide guest GL/EGL/GLES ABI libraries for Qt/Wayland. FEX thunks overlay
# the host-backed libraries at runtime.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_OPENGL_ES2=y
BR2_PACKAGE_SDL3_OPENGLES=y

# Prefer the same audio path as the host image when Qt multimedia is present.
BR2_PACKAGE_QT6MULTIMEDIA_PULSEAUDIO=y

#!/bin/sh

ROOT_PID="/var/run/hexagonrpcd-adsp-root.pid"
SENSORS_PID="/var/run/hexagonrpcd-adsp-sensors.pid"
ROOT_STARTUP_PID="/var/run/qcom-sensors-root-startup.pid"
LOG_DIR="/userdata/system/logs"
LOG_FILE="${LOG_DIR}/qcom-sensors.log"
FASTRPC_DEVICE=""

configure_device() {
	if grep -aq "ayn,odin3" /proc/device-tree/compatible 2>/dev/null; then
		STATIC_ROOT="/usr/share/qcom/sm8750/AYN/odin3"
		STATE_DIR="/userdata/system/qcom-sensors/odin3"
		REGISTRY_CONFIG="qmi8658_0_platform.config"
		REGISTRY_ORIENT="qmi8658_0_platform.orient"
		REGISTRY_LABEL="QMI8658"
		HW_PLATFORM="MTP"
		FALLBACK_SOC_ID="706"
	elif grep -aq "ayn,thor" /proc/device-tree/compatible 2>/dev/null; then
		STATIC_ROOT="/usr/share/qcom/sm8550/AYN/thor"
		STATE_DIR="/userdata/system/qcom-sensors/thor"
		REGISTRY_CONFIG="sh5001_0_platform.config"
		REGISTRY_ORIENT="sh5001_0_platform.orient"
		REGISTRY_LABEL="SH5001"
		HW_PLATFORM="HDK"
		FALLBACK_SOC_ID="603"
	else
		return 1
	fi

	RPC_ROOT="${STATE_DIR}/root"
	REGISTRY="${STATE_DIR}/registry"
	REGISTRY_MARKER="${STATE_DIR}/registry.version"
	REGISTRY_VERSION="1"
}

log_msg() {
	echo "[$(date '+%F %T')] $*" >> "${LOG_FILE}"
}

registry_ready() {
	registry_dir="${1:-${REGISTRY}}"
	[ -s "${registry_dir}/${REGISTRY_CONFIG}" ] &&
		[ -s "${registry_dir}/${REGISTRY_ORIENT}" ]
}

prepare_registry() {
	mkdir -p "${STATE_DIR}" "${REGISTRY}" "${RPC_ROOT}/sensors" \
		"${RPC_ROOT}/dsp/adsp" "${LOG_DIR}"

	if [ ! -d "${STATIC_ROOT}/sensors/config" ] ||
	    [ ! -r "${STATIC_ROOT}/sensors/sns_reg.conf" ]; then
		log_msg "Static sensor profile is missing from ${STATIC_ROOT}"
		return 1
	fi

	ln -snf "${STATIC_ROOT}/sensors/config" "${RPC_ROOT}/sensors/config"
	ln -snf "${STATIC_ROOT}/sensors/sns_reg.conf" "${RPC_ROOT}/sensors/sns_reg.conf"
	ln -snf "${REGISTRY}" "${RPC_ROOT}/sensors/registry"
	ln -snf /sys/devices/soc0 "${RPC_ROOT}/socinfo"

	if [ "$(cat "${REGISTRY_MARKER}" 2>/dev/null)" = "${REGISTRY_VERSION}" ]; then
		if registry_ready; then
			return 0
		fi
		log_msg "Persistent sensor registry is incomplete; refusing to overwrite calibration"
		return 1
	fi

	# Never replace an existing registry automatically: it contains calibration
	# learned by this individual unit. Generate only when the state is new.
	if find "${REGISTRY}" -mindepth 1 -maxdepth 1 -type f -print -quit 2>/dev/null | grep -q .; then
		if registry_ready; then
			log_msg "Existing unversioned sensor registry retained"
			echo "${REGISTRY_VERSION}" > "${REGISTRY_MARKER}"
			return 0
		fi
		log_msg "Existing unversioned sensor registry is incomplete; refusing to overwrite it"
		return 1
	fi

	if [ -r /sys/devices/soc0/soc_id ]; then
		soc_id=$(tr -d '\000\r\n ' < /sys/devices/soc0/soc_id)
	else
		soc_id=""
	fi
	[ -n "${soc_id}" ] || soc_id="${FALLBACK_SOC_ID}"

	registry_tmp="${STATE_DIR}/registry.new.$$"
	rm -rf "${registry_tmp}"
	mkdir -p "${registry_tmp}"

	if ! sscregistrygen -p "${HW_PLATFORM}" -s "${soc_id}" \
		"${STATIC_ROOT}/sensors/config" "${registry_tmp}" >> "${LOG_FILE}" 2>&1; then
		rm -rf "${registry_tmp}"
		log_msg "sscregistrygen failed"
		return 1
	fi

	if ! registry_ready "${registry_tmp}"; then
		rm -rf "${registry_tmp}"
		log_msg "${REGISTRY_LABEL} registry profile was not generated (platform ${HW_PLATFORM}, SoC ${soc_id})"
		return 1
	fi

	mv "${registry_tmp}"/* "${REGISTRY}"/
	rmdir "${registry_tmp}"
	echo "${REGISTRY_VERSION}" > "${REGISTRY_MARKER}"
	log_msg "Generated persistent ${REGISTRY_LABEL} registry for platform ${HW_PLATFORM}, SoC ${soc_id}"
}

select_fastrpc_device() {
	# Upstream DTs normally mark ADSP FastRPC non-secure, but some signed
	# firmware exposes only the secure node. SensorsPD works on either node.
	for device in /dev/fastrpc-adsp /dev/fastrpc-adsp-secure; do
		if [ -e "${device}" ]; then
			FASTRPC_DEVICE="${device}"
			return 0
		fi
	done

	return 1
}

wait_for_fastrpc() {
	i=0
	while ! select_fastrpc_device && [ "${i}" -lt 100 ]; do
		sleep 0.1
		i=$((i + 1))
	done

	select_fastrpc_device
}

wait_for_pidfile() {
	pid_file="$1"
	i=0
	while [ "${i}" -lt 50 ]; do
		pid=$(cat "${pid_file}" 2>/dev/null)
		if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
			return 0
		fi
		sleep 0.1
		i=$((i + 1))
	done

	return 1
}

start_root_listener() {
	attempt=1
	while [ "${attempt}" -le 10 ]; do
		rm -f "${ROOT_PID}"
		start-stop-daemon --start --quiet --background --make-pidfile \
			--pidfile "${ROOT_PID}" --exec /usr/bin/hexagonrpcd \
			--output "${LOG_FILE}" -- \
			-f "${FASTRPC_DEVICE}" -d adsp -R "${RPC_ROOT}"

		if wait_for_pidfile "${ROOT_PID}"; then
			sleep 2
			root_pid=$(cat "${ROOT_PID}" 2>/dev/null)
			if [ -n "${root_pid}" ] && kill -0 "${root_pid}" 2>/dev/null; then
				return 0
			fi
		fi

		rm -f "${ROOT_PID}"
		if [ "${attempt}" -lt 10 ]; then
			log_msg "ADSP RootPD listener exited during startup; retrying (${attempt}/10)"
			sleep 2
		fi
		attempt=$((attempt + 1))
	done

	return 1
}

start_root_listener_async() {
	startup_pid=$(cat "${ROOT_STARTUP_PID}" 2>/dev/null)
	if [ -n "${startup_pid}" ] && kill -0 "${startup_pid}" 2>/dev/null; then
		return 0
	fi

	rm -f "${ROOT_STARTUP_PID}"
	start-stop-daemon --start --quiet --background --make-pidfile \
		--pidfile "${ROOT_STARTUP_PID}" --startas "$0" -- root-listener
}

start_daemons() {
	configure_device || return 0
	[ -x /usr/bin/hexagonrpcd ] || return 0
	prepare_registry || return 1

	if ! wait_for_fastrpc; then
		log_msg "No ADSP FastRPC device appeared"
		return 1
	fi
	log_msg "Using ${FASTRPC_DEVICE}"

	start-stop-daemon --start --quiet --background --make-pidfile \
		--pidfile "${SENSORS_PID}" --exec /usr/bin/hexagonrpcd \
		--output "${LOG_FILE}" -- \
		-f "${FASTRPC_DEVICE}" -d adsp -s -R "${RPC_ROOT}"
	if ! wait_for_pidfile "${SENSORS_PID}"; then
		log_msg "ADSP SensorsPD FastRPC listener failed to start"
		return 1
	fi

	# SensorsPD and RootPD share one FastRPC node. Give SensorsPD time to
	# finish creating its signed process before RootPD opens the channel.
	sleep 1

	if ! start_root_listener_async; then
		log_msg "Failed to queue ADSP RootPD FastRPC listener startup"
		return 1
	fi

	log_msg "Started ADSP SensorsPD and queued RootPD FastRPC listener startup"
}

stop_daemons() {
	start-stop-daemon --stop --quiet --remove-pidfile \
		--pidfile "${ROOT_STARTUP_PID}" --retry TERM/3/KILL/2 || true
	start-stop-daemon --stop --quiet --remove-pidfile \
		--pidfile "${SENSORS_PID}" --retry TERM/3/KILL/2 || true
	start-stop-daemon --stop --quiet --remove-pidfile \
		--pidfile "${ROOT_PID}" --retry TERM/3/KILL/2 || true
}

case "${1:-}" in
	start)
		start_daemons
		;;
	stop)
		stop_daemons
		;;
	root-listener)
		configure_device || exit 0
		if ! select_fastrpc_device; then
			log_msg "No ADSP FastRPC device available for RootPD listener"
			rm -f "${ROOT_STARTUP_PID}"
			exit 1
		fi
		if start_root_listener; then
			log_msg "Started ADSP RootPD FastRPC listener"
		else
			log_msg "ADSP RootPD FastRPC listener exited during startup"
		fi
		rm -f "${ROOT_STARTUP_PID}"
		;;
	restart)
		stop_daemons
		start_daemons
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit $?

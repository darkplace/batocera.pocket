From: suckbluefrog <suckbluefrog@proton.me>
Date: Fri, 10 Jul 2026 00:00:00 +000
Subject: [PATCH] input: rsinput: suspend and resume the gamepad MCU across system sleep

The gamepad MCU streams input reports continuously over the UART. Across a
system-suspend teardown the MCU can keep sending, so the GENI serial RX
interrupt may storm while the port is stopping. Quiesce the MCU on suspend and
re-initialise it on resume.

diff --git a/drivers/input/joystick/rsinput.c b/drivers/input/joystick/rsinput.c
index 457cd4c43..ca43a19bd 100644
--- a/drivers/input/joystick/rsinput.c
+++ b/drivers/input/joystick/rsinput.c
@@ -557,6 +557,35 @@ static void rsinput_remove(struct serdev_device *serdev) {
     regulator_disable(drv->vdd);
 }
 
+static int rsinput_suspend(struct device *dev)
+{
+    struct rsinput_driver *drv = dev_get_drvdata(dev);
+
+    /*
+     * The MCU streams reports continuously over the UART. If it remains
+     * enabled while the serial parent is suspending, RX can keep asserting
+     * and prevent a clean transition or leave the IRQ disabled as spurious.
+     * Odin 3 has enable-gpios but no reset-gpios, while other rsinput users
+     * may provide both, so quiesce either line when present.
+     */
+    if (drv->enable_gpio)
+        gpiod_set_value_cansleep(drv->enable_gpio, 0);
+
+    if (drv->reset_gpio)
+        gpiod_set_value_cansleep(drv->reset_gpio, 0);
+
+    return 0;
+}
+
+static int rsinput_resume(struct device *dev)
+{
+    struct rsinput_driver *drv = dev_get_drvdata(dev);
+
+    return rsinput_init_commands(drv);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(rsinput_pm_ops, rsinput_suspend, rsinput_resume);
+
 static const struct of_device_id rsinput_of_match[] = {
     { .compatible = "gamepad,rsinput" },
     { /* sentinel */ }
@@ -569,6 +598,7 @@ static struct serdev_device_driver rsinput_driver = {
     .driver = {
         .name = "rsinput",
         .of_match_table = rsinput_of_match,
+        .pm = pm_sleep_ptr(&rsinput_pm_ops),
     },
 };
 

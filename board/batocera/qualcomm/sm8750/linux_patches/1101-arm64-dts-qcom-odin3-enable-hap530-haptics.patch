From: suckbluefrog <suckbluefrog@proton.me>
Subject: [PATCH] arm64: dts: qcom: odin3: enable PMIH0108 HAP530 haptics

Enable the PMIH0108 HAP530 block with the actuator parameters recovered
from the Odin 3 stock Android device tree.

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
@@ -288,6 +288,20 @@
 	rotation = <90>;
 };
 
+&pmih0108 {
+	pmih0108_haptics: haptics@f000 {
+		compatible = "qcom,spmi-haptics";
+		reg = <0xf000>, <0xf100>;
+		interrupts = <0x7 0xf0 0x1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "fifo-empty";
+
+		qcom,lra-period-us = <5880>;
+		qcom,vmax-microvolt = <1700000>;
+
+		status = "okay";
+	};
+};
+
 &remoteproc_adsp {
 	firmware-name = "qcom/sm8750/ayn/odin3/adsp.mbn",
 			"qcom/sm8750/ayn/odin3/adsp_dtb.mbn";

From: suckbluefrog <suckbluefrog@proton.me>
Subject: [PATCH] input: bridge Odin rsinput rumble to PMIC haptics

The Odin controller MCU provides buttons and axes while its single LRA is
driven by the PMIH0108 HAP530 block. Add FF_RUMBLE support to the native
HAP530 driver and forward rsinput force-feedback callbacks to it so SDL
and emulators see rumble on the gamepad device.

--- /dev/null
+++ b/include/linux/input/qcom-spmi-haptics.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_INPUT_QCOM_SPMI_HAPTICS_H
+#define _LINUX_INPUT_QCOM_SPMI_HAPTICS_H
+
+#include <linux/errno.h>
+#include <linux/input.h>
+#include <linux/kconfig.h>
+
+#if IS_REACHABLE(CONFIG_INPUT_QCOM_SPMI_HAPTICS)
+int qcom_spmi_haptics_upload(struct ff_effect *effect,
+			     struct ff_effect *old);
+int qcom_spmi_haptics_playback(int effect_id, int val);
+int qcom_spmi_haptics_erase(int effect_id);
+void qcom_spmi_haptics_set_gain(u16 gain);
+#else
+static inline int qcom_spmi_haptics_upload(struct ff_effect *effect,
+					   struct ff_effect *old)
+{
+	return -ENODEV;
+}
+
+static inline int qcom_spmi_haptics_playback(int effect_id, int val)
+{
+	return -ENODEV;
+}
+
+static inline int qcom_spmi_haptics_erase(int effect_id)
+{
+	return -ENODEV;
+}
+
+static inline void qcom_spmi_haptics_set_gain(u16 gain)
+{
+}
+#endif
+
+#endif


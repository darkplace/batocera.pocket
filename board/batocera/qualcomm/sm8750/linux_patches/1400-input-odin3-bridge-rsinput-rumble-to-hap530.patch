 #include <linux/math64.h>
@@ -219,6 +221,9 @@
 	struct qcom_haptics_effect effects[HAPTICS_MAX_EFFECTS];
 };
 
+/* Odin-family systems contain one PMIC haptics engine. */
+static struct qcom_haptics *primary_haptics;
+
 static int cfg_write(struct qcom_haptics *h, u32 off, u32 val)
 {
 	return regmap_write(h->regmap, h->cfg_base + off, val);
@@ -709,9 +714,12 @@
 
 	guard(mutex)(&h->play_lock);
 
-	/* No valid request available */
-	if (req == NULL)
+	/* A duration re-arm with no queued request means the effect expired. */
+	if (req == NULL) {
+		if (h->active_effect_id != -1)
+			haptics_stop_locked(h, false);
 		return;
+	}
 
 	if (req->play) {
 		ret = haptics_start_locked(h, req->effect_id);
@@ -852,14 +860,28 @@
 	if (id < 0 || id >= HAPTICS_MAX_EFFECTS)
 		return -EINVAL;
 
-	if (id == h->active_effect_id) {
-		dev_err(h->dev, "effect %d is under playing\n", id);
-		return -EBUSY;
-	}
-
 	priv = &h->effects[id];
 
+	if (id == h->active_effect_id && effect->type != FF_RUMBLE) {
+		dev_err(h->dev, "effect %d is under playing\n", id);
+		return -EBUSY;
+	}
+
 	switch (effect->type) {
+	case FF_RUMBLE:
+		/*
+		 * SDL updates a live rumble effect in place before issuing the
+		 * next EV_FF play event. The existing direct-play buffer is safe
+		 * to replace; playback will immediately restart and re-arm it.
+		 */
+		haptics_clear_effect(h, priv);
+		level = max(effect->u.rumble.strong_magnitude,
+			    effect->u.rumble.weak_magnitude);
+		priv->amplitude = (u8)mult_frac(level, 255, 0xFFFF);
+		priv->length_us = effect->replay.length * USEC_PER_MSEC;
+		priv->mode = HAPTICS_DIRECT_PLAY;
+		return 0;
+
 	case FF_CONSTANT:
 		haptics_clear_effect(h, priv);
 		level = effect->u.constant.level <= 0 ? 0 : effect->u.constant.level;
@@ -932,16 +954,5 @@
-	if (val > 0)
-		/*
-		 * Queue the play.  If a duration re-arm is already pending this
-		 * is a no-op, so the new play waits for the current effect to
-		 * finish before the worker dequeues it.
-		 */
-		schedule_delayed_work(&h->play_work, 0);
-	else
-		/*
-		 * Run the worker now, cancelling any pending duration re-arm,
-		 * so an explicit stop takes effect immediately.
-		 */
-		mod_delayed_work(system_percpu_wq, &h->play_work, 0);
+	/* A single-channel motor must process every replacement or stop now. */
+	mod_delayed_work(system_wq, &h->play_work, 0);
 
 	return 0;
 }
@@ -971,6 +982,49 @@
 	atomic_set(&h->gain, gain);
 }
 
+int qcom_spmi_haptics_upload(struct ff_effect *effect,
+			     struct ff_effect *old)
+{
+	struct qcom_haptics *h = READ_ONCE(primary_haptics);
+
+	if (!h)
+		return -ENODEV;
+
+	return haptics_upload_effect(h->input, effect, old);
+}
+EXPORT_SYMBOL_GPL(qcom_spmi_haptics_upload);
+
+int qcom_spmi_haptics_playback(int effect_id, int val)
+{
+	struct qcom_haptics *h = READ_ONCE(primary_haptics);
+
+	if (!h)
+		return -ENODEV;
+
+	return haptics_playback(h->input, effect_id, val);
+}
+EXPORT_SYMBOL_GPL(qcom_spmi_haptics_playback);
+
+int qcom_spmi_haptics_erase(int effect_id)
+{
+	struct qcom_haptics *h = READ_ONCE(primary_haptics);
+
+	if (!h)
+		return -ENODEV;
+
+	return haptics_erase(h->input, effect_id);
+}
+EXPORT_SYMBOL_GPL(qcom_spmi_haptics_erase);
+
+void qcom_spmi_haptics_set_gain(u16 gain)
+{
+	struct qcom_haptics *h = READ_ONCE(primary_haptics);
+
+	if (h)
+		haptics_set_gain(h->input, gain);
+}
+EXPORT_SYMBOL_GPL(qcom_spmi_haptics_set_gain);
+
 static int qcom_haptics_probe(struct platform_device *pdev)
 {
 	struct qcom_haptics *h;
@@ -1061,6 +1121,7 @@
 	h->input = input;
 
 	input_set_capability(input, EV_FF, FF_CONSTANT);
+	input_set_capability(input, EV_FF, FF_RUMBLE);
 	input_set_capability(input, EV_FF, FF_PERIODIC);
 	input_set_capability(input, EV_FF, FF_CUSTOM);
 	input_set_capability(input, EV_FF, FF_GAIN);
@@ -1081,6 +1142,8 @@
 		return dev_err_probe(h->dev, ret, "failed to register input device\n");
 	}
 
+	WRITE_ONCE(primary_haptics, h);
+
 	return 0;
 }
 
@@ -1088,6 +1151,9 @@
 {
 	struct qcom_haptics *h = platform_get_drvdata(pdev);
 
+	if (READ_ONCE(primary_haptics) == h)
+		WRITE_ONCE(primary_haptics, NULL);
+
 	/*
 	 * Unregister the input device explicitly at the beginning
 	 * to avoid the input device being used after the resources

--- a/drivers/input/joystick/rsinput.c
+++ b/drivers/input/joystick/rsinput.c
@@ -12,6 +12,7 @@
 #include <linux/init.h>
 #include <linux/jiffies.h>

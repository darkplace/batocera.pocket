+#include <linux/input/qcom-spmi-haptics.h>
 #include <linux/interrupt.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
@@ -22,6 +23,12 @@
 #include <linux/slab.h>
 #include <uapi/linux/sched/types.h>
 
+#define RSINPUT_FF_EFFECTS 8
+
+static bool rumble_enable = true;
+module_param(rumble_enable, bool, 0660);
+MODULE_PARM_DESC(rumble_enable, "Enable the PMIC haptics rumble bridge");
+
 static int update_params=0;
 
 static int trigger_left_max=0x610;
@@ -538,6 +545,38 @@
     .receive_buf = rsinput_rx,
 };
 
+static int rsinput_rumble_upload(struct input_dev *dev,
+                                 struct ff_effect *effect,
+                                 struct ff_effect *old)
+{
+    if (!rumble_enable)
+        return 0;
+
+    return qcom_spmi_haptics_upload(effect, old);
+}
+
+static int rsinput_rumble_playback(struct input_dev *dev, int effect_id, int val)
+{
+    if (!rumble_enable)
+        return 0;
+
+    return qcom_spmi_haptics_playback(effect_id, val);
+}
+
+static int rsinput_rumble_erase(struct input_dev *dev, int effect_id)
+{
+    if (!rumble_enable)
+        return 0;
+
+    return qcom_spmi_haptics_erase(effect_id);
+}
+
+static void rsinput_rumble_set_gain(struct input_dev *dev, u16 gain)
+{
+    if (rumble_enable)
+        qcom_spmi_haptics_set_gain(gain);
+}

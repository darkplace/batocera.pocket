+}
 
 static int wcd939x_populate_dt_data(struct wcd939x_priv *wcd939x, struct device *dev)
 {
@@ -3211,6 +3256,16 @@ static int wcd939x_populate_dt_data(struct wcd939x_priv *wcd939x, struct device
 
 	wcd_dt_parse_mbhc_data(dev, cfg);
 
+	wcd939x->usbss_node = of_parse_phandle(dev->of_node, "qcom,usbss", 0);
+	if (wcd939x->usbss_node) {
+		ret = devm_add_action_or_reset(dev, wcd939x_of_node_put,
+					       wcd939x->usbss_node);
+		if (ret)
+			return ret;
+
+		cfg->swap_gnd_mic = wcd939x_swap_gnd_mic;
+	}
+
 #if IS_ENABLED(CONFIG_TYPEC)
 	/*
 	 * Is node has a port and a valid remote endpoint

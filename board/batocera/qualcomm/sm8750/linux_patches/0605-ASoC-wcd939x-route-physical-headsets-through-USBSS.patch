 };
 
 static int wcd939x_get_hph_type(struct snd_kcontrol *kcontrol,
@@ -3161,11 +3168,42 @@ static int wcd939x_typec_mux_set(struct typec_mux_dev *mux,
 }
 #endif /* CONFIG_TYPEC */
 
-#if IS_ENABLED(CONFIG_TYPEC)
+static int wcd939x_mbhc_hsj_set(struct snd_soc_component *component,
+				bool connected)
+{
+	struct wcd939x_priv *wcd939x = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	if (!wcd939x->usbss_node)
+		return 0;
+
+	if (connected)
+		wcd939x->hsj_swapped = false;
+
+	ret = wcd939x_usbss_hsj_set(wcd939x->usbss_node, connected,
+				    connected && wcd939x->hsj_swapped);
+	if (!ret && !connected)
+		wcd939x->hsj_swapped = false;
+
+	return ret;
+}
+
 static bool wcd939x_swap_gnd_mic(struct snd_soc_component *component)
 {
 	struct wcd939x_priv *wcd939x = snd_soc_component_get_drvdata(component);
+	int ret;
 
+	if (wcd939x->usbss_node) {
+		ret = wcd939x_usbss_hsj_set(wcd939x->usbss_node, true,
+					    !wcd939x->hsj_swapped);
+		if (ret)
+			return false;
+
+		wcd939x->hsj_swapped = !wcd939x->hsj_swapped;
+		return true;
+	}
+
+#if IS_ENABLED(CONFIG_TYPEC)
 	if (!wcd939x->typec_analog_mux || !wcd939x->typec_switch)
 		return false;
 
@@ -3175,8 +3213,15 @@ static bool wcd939x_swap_gnd_mic(struct snd_soc_component *component)
 				TYPEC_ORIENTATION_NORMAL : TYPEC_ORIENTATION_REVERSE);
 
 	return true;
-}
+#else
+	return false;
 #endif /* CONFIG_TYPEC */
+}

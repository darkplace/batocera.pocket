 	struct wcd_mbhc_config mbhc_cfg;
@@ -2411,6 +2414,9 @@ static void wcd939x_mbhc_moisture_polling_ctrl(struct snd_soc_component *compone
 				      enable);
 }
 
+static int wcd939x_mbhc_hsj_set(struct snd_soc_component *component,

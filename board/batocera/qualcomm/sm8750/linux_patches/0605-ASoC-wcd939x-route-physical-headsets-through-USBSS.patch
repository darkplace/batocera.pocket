diff --git a/sound/soc/codecs/wcd-mbhc-v2.c b/sound/soc/codecs/wcd-mbhc-v2.c
index bb0c847..9f6a6e6 100644
--- a/sound/soc/codecs/wcd-mbhc-v2.c
+++ b/sound/soc/codecs/wcd-mbhc-v2.c
@@ -516,6 +516,7 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 	struct snd_soc_component *component = mbhc->component;
 	enum snd_jack_types jack_type;
 	bool detection_type;
+	int ret;
 
 	mutex_lock(&mbhc->lock);
 
@@ -535,6 +536,13 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 	if (detection_type) {
 		if (mbhc->current_plug != MBHC_PLUG_TYPE_NONE)
 			goto exit;
+		if (mbhc->mbhc_cb->mbhc_hsj_set) {
+			ret = mbhc->mbhc_cb->mbhc_hsj_set(component, true);
+
+			if (ret)
+				dev_warn_ratelimited(mbhc->dev,
+						     "failed to connect HSJ switch: %d\n", ret);
+		}
 		/* Make sure MASTER_BIAS_CTL is enabled */
 		mbhc->mbhc_cb->mbhc_bias(component, true);
 		mbhc->is_btn_press = false;
@@ -544,6 +552,12 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 		wcd_mbhc_write_field(mbhc, WCD_MBHC_FSM_EN, 0);
 		wcd_mbhc_write_field(mbhc, WCD_MBHC_BTN_ISRC_CTL, 0);
 		mbhc->extn_cable_hph_rem = false;
+		if (mbhc->mbhc_cb->mbhc_hsj_set) {
+			ret = mbhc->mbhc_cb->mbhc_hsj_set(component, false);
+			if (ret)
+				dev_warn_ratelimited(mbhc->dev,
+						     "failed to disconnect HSJ switch: %d\n", ret);
+		}
 
 		if (mbhc->current_plug == MBHC_PLUG_TYPE_NONE)
 			goto exit;
@@ -1445,6 +1459,8 @@ EXPORT_SYMBOL(wcd_mbhc_start);
 
 void wcd_mbhc_stop(struct wcd_mbhc *mbhc)
 {
+	if (mbhc->mbhc_cb->mbhc_hsj_set)
+		mbhc->mbhc_cb->mbhc_hsj_set(mbhc->component, false);
 	mbhc->current_plug = MBHC_PLUG_TYPE_NONE;
 	mbhc->hph_status = 0;
 	disable_irq_nosync(mbhc->intr_ids->hph_left_ocp);
diff --git a/sound/soc/codecs/wcd-mbhc-v2.h b/sound/soc/codecs/wcd-mbhc-v2.h
index a5d52b9..2005a0f 100644
--- a/sound/soc/codecs/wcd-mbhc-v2.h
+++ b/sound/soc/codecs/wcd-mbhc-v2.h

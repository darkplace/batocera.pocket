diff --git a/drivers/usb/typec/mux/wcd939x-usbss.c b/drivers/usb/typec/mux/wcd939x-usbss.c
index d46c353..3f4def9 100644
--- a/drivers/usb/typec/mux/wcd939x-usbss.c
+++ b/drivers/usb/typec/mux/wcd939x-usbss.c
@@ -9,14 +9,27 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
+#include <linux/of.h>
 #include <linux/regmap.h>
 #include <linux/bitfield.h>
 #include <linux/gpio/consumer.h>
 #include <linux/usb/typec_dp.h>
 #include <linux/usb/typec_mux.h>
+#include <linux/usb/wcd939x-usbss.h>
 
+#define WCD_USBSS_PMP_OUT			0x1
 #define WCD_USBSS_PMP_OUT1			0x2
 
+#define WCD_USBSS_PMP_OUT1_HSJ_PWR_EN				BIT(6)
+
+#define WCD_USBSS_POWER_MODE			0x4
+
+#define WCD_USBSS_TEST_3D			0x3d
+#define WCD_USBSS_TEST_43			0x43
+#define WCD_USBSS_TEST_50			0x50
+#define WCD_USBSS_TEST_91			0x91
+#define WCD_USBSS_TEST_92			0x92
+
 #define WCD_USBSS_DP_DN_MISC1			0x20
 
 #define WCD_USBSS_DP_DN_MISC1_DP_PCOMP_2X_DYN_BST_ON_EN			BIT(3)
@@ -112,6 +125,7 @@
 #define WCD_USBSS_USB_SS_CNTL_RCO_EN					BIT(3)
 #define WCD_USBSS_USB_SS_CNTL_USB_SS_MODE				GENMASK(2, 0)
 
+#define WCD_USBSS_USB_SS_CNTL_USB_SS_MODE_HSJ		1
 #define WCD_USBSS_USB_SS_CNTL_USB_SS_MODE_AATC		2
 #define WCD_USBSS_USB_SS_CNTL_USB_SS_MODE_USB		5
 
@@ -197,6 +211,9 @@ struct wcd939x_usbss {
 	enum typec_orientation orientation;
 	unsigned long mode;
 	unsigned int svid;
+	bool hsj_connected;
+	bool hsj_active;
+	bool hsj_swapped;
 };
 
 static const struct regmap_range_cfg wcd939x_usbss_ranges[] = {
@@ -237,6 +254,134 @@ static const struct {
 	{ WCD_USBSS_RATIO_SPKR_REXT_R_MSB, GENMASK(6, 0), 0x04 },
 };
 
+static int wcd939x_usbss_set_hsj(struct wcd939x_usbss *usbss)
+{
+	unsigned int select0 = usbss->hsj_swapped ?
+		WCD_USBSS_SWITCH_SELECT0_SENSE_SWITCHES :
+		WCD_USBSS_SWITCH_SELECT0_MIC_SWITCHES;
+	unsigned int select1 = usbss->hsj_swapped ?
+		WCD_USBSS_SWITCH_SELECT1_AGND_SWITCHES : 0;
+	int ret;
+
+	/* Program the physical 3.5 mm headset path used by WCD939x. */
+	ret = regmap_update_bits(usbss->regmap, WCD_USBSS_USB_SS_CNTL,
+				 WCD_USBSS_USB_SS_CNTL_USB_SS_MODE,
+				 FIELD_PREP(WCD_USBSS_USB_SS_CNTL_USB_SS_MODE,
+					    WCD_USBSS_USB_SS_CNTL_USB_SS_MODE_HSJ));
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_PMP_OUT, 0x0f);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_TEST_43, 0x00);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_TEST_3D, 0xc4);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_TEST_50, 0x01);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_TEST_91, 0x3c);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_TEST_92, 0x0f);
+	if (ret)
+		return ret;
+
+	ret = regmap_set_bits(usbss->regmap, WCD_USBSS_PMP_OUT1,
+			      WCD_USBSS_PMP_OUT1_HSJ_PWR_EN);
+	if (ret)
+		return ret;
+
+	/* DNL/DPR carry the codec's left/right channels in HSJ mode. */
+	ret = regmap_update_bits(usbss->regmap, WCD_USBSS_SWITCH_SELECT0,
+				 WCD_USBSS_SWITCH_SELECT0_DNL_SWITCHES |
+				 WCD_USBSS_SWITCH_SELECT0_DPR_SWITCHES |
+				 WCD_USBSS_SWITCH_SELECT0_SENSE_SWITCHES |
+				 WCD_USBSS_SWITCH_SELECT0_MIC_SWITCHES,
+				 select0);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(usbss->regmap, WCD_USBSS_SWITCH_SELECT1,
+				 WCD_USBSS_SWITCH_SELECT1_AGND_SWITCHES,
+				 select1);
+	if (ret)
+		return ret;
+
+	ret = regmap_clear_bits(usbss->regmap, WCD_USBSS_MG1_BIAS,
+				WCD_USBSS_MG1_BIAS_PCOMP_DYN_BST_EN);
+	if (ret)
+		return ret;
+
+	return regmap_set_bits(usbss->regmap,
+			       WCD_USBSS_SWITCH_SETTINGS_ENABLE,
+			       WCD_USBSS_SWITCH_SETTINGS_ENABLE_DNL_SWITCHES |
+			       WCD_USBSS_SWITCH_SETTINGS_ENABLE_DPR_SWITCHES |
+			       WCD_USBSS_SWITCH_SETTINGS_ENABLE_SENSE_SWITCHES |
+			       WCD_USBSS_SWITCH_SETTINGS_ENABLE_MIC_SWITCHES |
+			       WCD_USBSS_SWITCH_SETTINGS_ENABLE_AGND_SWITCHES);
+}
+
+static int wcd939x_usbss_unset_hsj(struct wcd939x_usbss *usbss)
+{
+	int ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_PMP_OUT, 0x00);
+	if (ret)
+		return ret;
+
+	ret = regmap_clear_bits(usbss->regmap, WCD_USBSS_PMP_OUT1,
+				WCD_USBSS_PMP_OUT1_HSJ_PWR_EN);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_TEST_43, 0x00);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_TEST_3D, 0x00);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_POWER_MODE, 0x10);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_TEST_50, 0x00);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_TEST_91, 0x00);
+	if (ret)
+		return ret;
+
+	return regmap_write(usbss->regmap, WCD_USBSS_TEST_92, 0x00);
+}
+
+static bool wcd939x_usbss_dp_active(struct wcd939x_usbss *usbss)
+{
+	if (!usbss->svid)
+		return false;
+
+	switch (usbss->mode) {
+	case TYPEC_DP_STATE_C:
+	case TYPEC_DP_STATE_D:
+	case TYPEC_DP_STATE_E:
+	case TYPEC_DP_STATE_F:
+		return true;
+	default:
+		return false;
+	}
+}
+
 static int wcd939x_usbss_set(struct wcd939x_usbss *usbss)
 {
 	bool reverse = (usbss->orientation == TYPEC_ORIENTATION_REVERSE);
@@ -328,6 +473,21 @@ static int wcd939x_usbss_set(struct wcd939x_usbss *usbss)
 	/* 35us to allow the SBU switch to turn off */
 	usleep_range(35, 1000);
 
+	/* DisplayPort AUX owns MG1/MG2 while DP is active. */
+	if (usbss->hsj_connected && !enable_dp) {
+		ret = wcd939x_usbss_set_hsj(usbss);
+		if (!ret)
+			usbss->hsj_active = true;
+		return ret;
+	}
+
+	if (usbss->hsj_active) {
+		ret = wcd939x_usbss_unset_hsj(usbss);
+		if (ret)
+			return ret;
+		usbss->hsj_active = false;
+	}
+
 	/* Setup Audio Accessory mux/switch */
 	if (enable_audio) {
 		int i;
@@ -531,6 +691,39 @@ static int wcd939x_usbss_set(struct wcd939x_usbss *usbss)
 	return 0;
 }
 
+int wcd939x_usbss_hsj_set(struct device_node *node, bool connected,
+			  bool swapped)
+{
+	struct wcd939x_usbss *usbss;
+	struct i2c_client *client;
+	int ret;
+
+	client = of_find_i2c_device_by_node(node);
+	if (!client)
+		return -EPROBE_DEFER;
+
+	usbss = i2c_get_clientdata(client);
+	if (!usbss) {
+		ret = -EPROBE_DEFER;
+		goto out_put_device;
+	}
+
+	mutex_lock(&usbss->lock);
+	usbss->hsj_connected = connected;
+	usbss->hsj_swapped = connected && swapped;
+	/* Preserve active DP AUX; restore the pending HSJ after DP exits. */
+	if (wcd939x_usbss_dp_active(usbss))
+		ret = 0;
+	else
+		ret = wcd939x_usbss_set(usbss);
+	mutex_unlock(&usbss->lock);
+
+out_put_device:
+	put_device(&client->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wcd939x_usbss_hsj_set);
+
 static int wcd939x_usbss_switch_set(struct typec_switch_dev *sw,
 				    enum typec_orientation orientation)
 {
diff --git a/include/linux/usb/wcd939x-usbss.h b/include/linux/usb/wcd939x-usbss.h

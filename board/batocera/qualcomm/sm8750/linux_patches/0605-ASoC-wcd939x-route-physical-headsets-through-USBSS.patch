 include/linux/usb/wcd939x-usbss.h             |  22 ++
 sound/soc/codecs/wcd-mbhc-v2.c                |  16 ++
 sound/soc/codecs/wcd-mbhc-v2.h                |   1 +
 sound/soc/codecs/wcd939x.c                    |  59 +++++-

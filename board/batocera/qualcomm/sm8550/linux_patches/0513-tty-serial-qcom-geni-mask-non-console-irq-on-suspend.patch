From: jaewun <jaewun@users.noreply.github.com>
Subject: [PATCH] tty: serial: qcom-geni: mask non-console IRQ across suspend

A peer that keeps streaming into a non-console GENI UART during suspend can
storm the RX IRQ once uart_suspend_port() marks the port suspended. Mask
non-console IRQs around the system sleep transition so the spurious IRQ detector
does not permanently disable the gamepad UART IRQ.

--- a/drivers/tty/serial/qcom_geni_serial.c
+++ b/drivers/tty/serial/qcom_geni_serial.c
@@ -1860,8 +1860,11 @@
 	struct qcom_geni_serial_port *port = dev_get_drvdata(dev);
 	struct uart_port *uport = &port->uport;
 	struct qcom_geni_private_data *private_data = uport->private_data;
+	int ret;
 
 	/*
+	 * Console ports stay unmasked so no_console_suspend continues to work.
+	 *
 	 * This is done so we can hit the lowest possible state in suspend
 	 * even with no_console_suspend
 	 */
@@ -1869,7 +1872,15 @@
 		geni_icc_set_tag(&port->se, QCOM_ICC_TAG_ACTIVE_ONLY);
 		geni_icc_set_bw(&port->se);
 	}
-	return uart_suspend_port(private_data->drv, uport);
+
+	if (!uart_console(uport))
+		disable_irq(uport->irq);
+
+	ret = uart_suspend_port(private_data->drv, uport);
+	if (ret && !uart_console(uport))
+		enable_irq(uport->irq);
+
+	return ret;
 }
 
 static int qcom_geni_serial_resume(struct device *dev)
@@ -1880,6 +1891,10 @@
 	struct qcom_geni_private_data *private_data = uport->private_data;
 
 	ret = uart_resume_port(private_data->drv, uport);
+
+	if (!uart_console(uport))
+		enable_irq(uport->irq);
+
 	if (uart_console(uport)) {
 		geni_icc_set_tag(&port->se, QCOM_ICC_TAG_ALWAYS);
 		geni_icc_set_bw(&port->se);

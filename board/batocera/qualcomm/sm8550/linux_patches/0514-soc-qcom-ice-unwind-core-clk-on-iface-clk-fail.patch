From: jaewun <jaewun@users.noreply.github.com>
Subject: [PATCH] soc: qcom: ice: unwind core clock if iface clock enable fails

qcom_ice_resume() enables core_clk before iface_clk. If iface_clk enable fails,
drop the core clock reference before returning.

diff --git a/drivers/soc/qcom/ice.c b/drivers/soc/qcom/ice.c
--- a/drivers/soc/qcom/ice.c
+++ b/drivers/soc/qcom/ice.c
@@ -289,6 +289,7 @@ int qcom_ice_resume(struct qcom_ice *ice)
 	err = clk_prepare_enable(ice->iface_clk);
 	if (err) {
 		dev_err(dev, "Failed to enable iface clock: %d\n", err);
+		clk_disable_unprepare(ice->core_clk);
 		return err;
 	}
 	qcom_ice_hwkm_init(ice);

#!/bin/sh

SETTING="system.battery.charge_limit"
BYPASS_SETTING="system.battery.charge_bypass"
BATTERY="/sys/class/power_supply/battery"
START_NODE="${BATTERY}/charge_control_start_threshold"
END_NODE="${BATTERY}/charge_control_end_threshold"
BEHAVIOUR_NODE="${BATTERY}/charge_behaviour"
LOG="/userdata/system/logs/qcom-charge-limit.log"
OPTIONS="100 95 90 85 80 75 70"
DEFAULT_LIMIT="100"

mkdir -p "$(dirname "${LOG}")"

log_msg() {
    echo "[$(date '+%F %T')] $*" >> "${LOG}"
}

nodes_exist() {
    [ -e "${START_NODE}" ] && [ -e "${END_NODE}" ]
}

nodes_writable() {
    [ -w "${START_NODE}" ] && [ -w "${END_NODE}" ]
}

wait_for_nodes() {
    timeout="${1:-0}"
    elapsed=0

    while ! nodes_exist; do
        [ "${elapsed}" -ge "${timeout}" ] && return 1
        sleep 1
        elapsed=$((elapsed + 1))
    done

    return 0
}

normalize_limit() {
    value="${1:-${DEFAULT_LIMIT}}"

    case "${value}" in
        ''|*[!0-9]*)
            echo "${DEFAULT_LIMIT}"
            return
            ;;
    esac

    [ "${value}" -lt 70 ] && value=70
    [ "${value}" -gt 100 ] && value=100
    value=$((value / 5 * 5))

    echo "${value}"
}

get_saved_limit() {
    value=""

    if command -v batocera-settings-get-master >/dev/null 2>&1; then
        value="$(batocera-settings-get-master "${SETTING}" 2>/dev/null || true)"
    fi

    if [ -z "${value}" ] && command -v batocera-settings-get >/dev/null 2>&1; then
        value="$(batocera-settings-get "${SETTING}" 2>/dev/null || true)"
    fi

    if [ -z "${value}" ] && [ -r "${END_NODE}" ]; then
        value="$(cat "${END_NODE}" 2>/dev/null || true)"
    fi

    normalize_limit "${value}"
}

save_limit() {
    command -v batocera-settings-set >/dev/null 2>&1 || return 0
    batocera-settings-set "${SETTING}" "${1}" >/dev/null 2>&1 || true
}

write_thresholds() {
    end="$(normalize_limit "${1}")"
    start=$((end - 5))
    current_end="$(cat "${END_NODE}" 2>/dev/null || echo 0)"

    case "${current_end}" in
        ''|*[!0-9]*) current_end=0 ;;
    esac

    if [ "${end}" -gt "${current_end}" ]; then
        echo "${end}" > "${END_NODE}" || return 1
        echo "${start}" > "${START_NODE}" || return 1
    else
        echo "${start}" > "${START_NODE}" || return 1
        echo "${end}" > "${END_NODE}" || return 1
    fi

    return 0
}

apply_limit() {
    limit="$(normalize_limit "${1}")"
    timeout="${2:-0}"

    if ! wait_for_nodes "${timeout}"; then
        log_msg "threshold nodes not found; max charge ${limit}% not applied"
        return 1
    fi

    if ! nodes_writable; then
        log_msg "threshold nodes are not writable; max charge ${limit}% not applied"
        return 1
    fi

    if write_thresholds "${limit}"; then
        log_msg "applied max charge ${limit}% (start $((limit - 5))%, end ${limit}%)"
        return 0
    fi

    log_msg "failed to apply max charge ${limit}%"
    return 1
}

bypass_available() {
    [ -e "${BEHAVIOUR_NODE}" ] && [ -w "${BEHAVIOUR_NODE}" ]
}

get_bypass() {
    [ -r "${BEHAVIOUR_NODE}" ] || { echo "unavailable"; return 0; }
    # sysfs may list: [auto] inhibit-charge
    cat "${BEHAVIOUR_NODE}" 2>/dev/null | tr -d '[]' | awk '{print $1; exit}'
}

set_bypass() {
    mode="${1:-auto}"
    case "${mode}" in
        on|1|inhibit|inhibit-charge)
            value="inhibit-charge"
            ;;
        off|0|auto)
            value="auto"
            ;;
        *)
            echo "Usage: $0 bypass on|off" >&2
            return 1
            ;;
    esac

    if ! bypass_available; then
        log_msg "charge_behaviour unavailable; bypass not applied"
        return 1
    fi

    echo "${value}" > "${BEHAVIOUR_NODE}" || return 1
    if command -v batocera-settings-set >/dev/null 2>&1; then
        if [ "${value}" = "inhibit-charge" ]; then
            batocera-settings-set "${BYPASS_SETTING}" "1" >/dev/null 2>&1 || true
        else
            batocera-settings-set "${BYPASS_SETTING}" "0" >/dev/null 2>&1 || true
        fi
    fi
    log_msg "applied charge_behaviour=${value}"
    return 0
}

apply_saved_bypass() {
    bypass_available || return 0
    value=""
    if command -v batocera-settings-get-master >/dev/null 2>&1; then
        value="$(batocera-settings-get-master "${BYPASS_SETTING}" 2>/dev/null || true)"
    fi
    if [ -z "${value}" ] && command -v batocera-settings-get >/dev/null 2>&1; then
        value="$(batocera-settings-get "${BYPASS_SETTING}" 2>/dev/null || true)"
    fi
    case "${value}" in
        1|on|true|inhibit|inhibit-charge) set_bypass on ;;
        *) set_bypass off ;;
    esac
}

case "${1:-status}" in
    --available|available)
        nodes_exist && nodes_writable
        ;;
    --options|options)
        echo "${OPTIONS}"
        ;;
    --saved|saved)
        get_saved_limit
        ;;
    apply-saved|--apply-saved)
        apply_limit "$(get_saved_limit)" "${2:-30}"
        apply_saved_bypass || true
        ;;
    bypass|--bypass)
        case "${2:-status}" in
            --available|available) bypass_available ;;
            on|off|1|0|auto|inhibit|inhibit-charge) set_bypass "${2}" ;;
            ''|status|--status) echo "behaviour=$(get_bypass)" ;;
            *) echo "Usage: $0 bypass on|off|status" >&2; exit 1 ;;
        esac
        ;;
    set|--set)
        limit="$(normalize_limit "${2}")"
        save_limit "${limit}"
        apply_limit "${limit}"
        ;;
    ''|status|--status)
        echo "saved=$(get_saved_limit)"
        echo "start=$(cat "${START_NODE}" 2>/dev/null || true)"
        echo "end=$(cat "${END_NODE}" 2>/dev/null || true)"
        echo "behaviour=$(get_bypass)"
        ;;
    *[!0-9]*)
        echo "Usage: $0 [--available|--options|--saved|--status|apply-saved [timeout]|set <70-100>|bypass on|off|<70-100>]" >&2
        exit 1
        ;;
    *)
        limit="$(normalize_limit "${1}")"
        save_limit "${limit}"
        apply_limit "${limit}"
        ;;
esac

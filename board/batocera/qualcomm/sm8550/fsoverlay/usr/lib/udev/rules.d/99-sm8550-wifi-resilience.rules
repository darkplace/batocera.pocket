# Keep WCN7850 out of Wi-Fi power save; it helps avoid idle disconnects.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan*", RUN+="/usr/bin/sm8550-wifi-resilience %k"
ACTION=="change", SUBSYSTEM=="net", KERNEL=="wlan*", RUN+="/usr/bin/sm8550-wifi-resilience %k"
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlp*", RUN+="/usr/bin/sm8550-wifi-resilience %k"
ACTION=="change", SUBSYSTEM=="net", KERNEL=="wlp*", RUN+="/usr/bin/sm8550-wifi-resilience %k"
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlx*", RUN+="/usr/bin/sm8550-wifi-resilience %k"
ACTION=="change", SUBSYSTEM=="net", KERNEL=="wlx*", RUN+="/usr/bin/sm8550-wifi-resilience %k"

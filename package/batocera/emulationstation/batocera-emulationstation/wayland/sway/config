include /var/run/sway-display.conf

# Modifier key
set $alt Mod1

# hide_cursor hides the cursor image after the specified timeout (in milliseconds) has elapsed with no activity on that cursor
seat * hide_cursor 500

# Default wallpaper
output * bg /usr/share/emulationstation/resources/logo.png fill

# Set keyboard layout based on environment variables set (default US)
input * {
    xkb_layout $XKB_LAYOUT
    xkb_variant $XKB_VARIANT
}

# kill focused window
bindsym Mod1+F4 kill

# Make the current focus fullscreen
bindsym Mod1+f fullscreen

# Set a default rule to remove decorations for all windows
default_border none

# Route primary and secondary-screen windows using the generated output names.
for_window [app_id="emulationstation"] move to output $primary_output
for_window [class="emulationstation"] move to output $primary_output
for_window [title="backglass"] move to output $secondary_output
for_window [app_id="azahar"] move to output $primary_output
for_window [class="azahar"] move to output $primary_output
for_window [class="Azahar"] move to output $primary_output
for_window [app_id="azahar" title=".*Secondary Window.*"] move to output $secondary_output
for_window [class="azahar" title=".*Secondary Window.*"] move to output $secondary_output
for_window [class="Azahar" title=".*Secondary Window.*"] move to output $secondary_output
for_window [app_id="net.kuribo64.melonDS" title=".*w1.*"] move to output $primary_output
for_window [class="net.kuribo64.melonDS" title=".*w1.*"] move to output $primary_output
for_window [app_id="melonDS" title=".*w1.*"] move to output $primary_output
for_window [class="melonDS" title=".*w1.*"] move to output $primary_output
for_window [app_id="net.kuribo64.melonDS" title=".*w2.*"] move to output $secondary_output
for_window [class="net.kuribo64.melonDS" title=".*w2.*"] move to output $secondary_output
for_window [app_id="melonDS" title=".*w2.*"] move to output $secondary_output
for_window [class="melonDS" title=".*w2.*"] move to output $secondary_output
for_window [app_id="info.cemu.Cemu"] move to output $primary_output
for_window [class="info.cemu.Cemu"] move to output $primary_output
for_window [class="Cemu"] move to output $primary_output
for_window [app_id="info.cemu.Cemu" title=".*GamePad.*"] move to output $secondary_output
for_window [class="info.cemu.Cemu" title=".*GamePad.*"] move to output $secondary_output
for_window [class="Cemu" title=".*GamePad.*"] move to output $secondary_output
for_window [title=".*GamePad.*"] move to output $secondary_output

# Make NORMAL windows fullscreen (should exclude dialogs)
for_window [window_type="normal"] fullscreen enable

# Optionally, ensure dialogs explicitly float if needed (often default anyway)
for_window [window_type="dialog"] floating enable
for_window [window_role="dialog"] floating enable

# F1 launched apps
for_window [app_id="azahar"] fullscreen enable
for_window [class="azahar"] fullscreen enable
for_window [class="Azahar"] fullscreen enable
for_window [app_id="flycast"] fullscreen enable
for_window [app_id="duckstation-qt"] fullscreen enable
for_window [app_id="dolphin-emu"] fullscreen enable
for_window [app_id="info.cemu.Cemu"] fullscreen enable
for_window [class="info.cemu.Cemu"] fullscreen enable
for_window [class="Cemu"] fullscreen enable
for_window [app_id="rpcs3"] fullscreen enable
for_window [app_id="scummvm"] fullscreen enable
for_window [app_id="net.shadps4.shadPS4"] fullscreen enable

# Specific XWayland apps
for_window [app_id="supermodel"] fullscreen enable
for_window [class="XTerm"] fullscreen enable
for_window [class="Play!"] fullscreen enable
# Model 2
for_window [instance="emulator_multicpu.exe"] fullscreen enable

# batocera-flash-screen OSD
for_window [title="Batocera OSD"] fullscreen disable
for_window [title="Batocera OSD"] floating enable
for_window [title="Batocera OSD"] move position 0px 2px
for_window [title="Batocera OSD"] border none
# batocera-controlcenter
for_window [title="Batocera Control Center"] move to output $primary_output
for_window [title="Batocera Control Center"] fullscreen disable
for_window [title="Batocera Control Center"] floating enable
for_window [title="Batocera Control Center"] sticky enable
for_window [title="Batocera Control Center"] move position center
for_window [title="Batocera Control Center"] border none
for_window [title="Batocera Control Center"] focus

include /var/run/sway-app-routing.conf

# Starts EmulationStation when loading sway
exec /usr/bin/sway-touch-map
exec /usr/bin/batocera-mouse hide
exec /usr/bin/emulationstation-standalone

#!/bin/sh

# Allow startup from a user session where WAYLAND_DISPLAY is set,
# e.g. to restart via /etc/init.d/S31emulationstation start
unset WAYLAND_DISPLAY

# Log and configuration file paths
LOG_FILE="/userdata/system/logs/display.log"
SWAY_CONF_FILE="/var/run/sway-display.conf"
SWAY_APP_ROUTING_FILE="/var/run/sway-app-routing.conf"
SWAY_LOG_FILE="/var/log/sway.log"

mkdir -p /userdata/system/logs
mkdir -p /var/run
mkdir -p /var/log

# Log function for cleaner output
log_message() {
    echo "$1" >> "$LOG_FILE"
}

settings_get() {
    value=$(batocera-settings-get-master "$1" 2>/dev/null)
    if [ -z "$value" ]; then
        value=$(batocera-settings-get "$1" 2>/dev/null)
    fi
    echo "$value"
}

is_number() {
    case "$1" in
        ""|*[!0-9]*)
            return 1
            ;;
    esac
    return 0
}

resolution_width() {
    resolution=$(echo "$1" | cut -d'.' -f1)
    case "$resolution" in
        *x*) ;;
        *) return 0 ;;
    esac
    width=$(echo "$resolution" | cut -d'x' -f1)
    if is_number "$width"; then
        echo "$width"
    fi
}

resolution_height() {
    resolution=$(echo "$1" | cut -d'.' -f1)
    case "$resolution" in
        *x*) ;;
        *) return 0 ;;
    esac
    height=$(echo "$resolution" | cut -d'x' -f2)
    if is_number "$height"; then
        echo "$height"
    fi
}

resolution_effective_width() {
    resolution="$1"
    transform="$2"
    width=$(resolution_width "$resolution")
    height=$(resolution_height "$resolution")

    case "$transform" in
        90|270)
            if is_number "$height"; then
                echo "$height"
            fi
            ;;
        *)
            if is_number "$width"; then
                echo "$width"
            fi
            ;;
    esac
}

resolution_effective_height() {
    resolution="$1"
    transform="$2"
    width=$(resolution_width "$resolution")
    height=$(resolution_height "$resolution")

    case "$transform" in
        90|270)
            if is_number "$width"; then
                echo "$width"
            fi
            ;;
        *)
            if is_number "$height"; then
                echo "$height"
            fi
            ;;
    esac
}

rotation_to_transform() {
    case "$1" in
        1)
            echo 90
            ;;
        2)
            echo 180
            ;;
        3)
            echo 270
            ;;
        *)
            echo normal
            ;;
    esac
}

display_rotation() {
    output="$1"
    role="$2"

    rotation=
    if [ "$role" = "secondary" ]; then
        rotation=$(settings_get "display.rotate2.${output}")
    fi
    if [ -z "$rotation" ]; then
        rotation=$(settings_get "display.rotate.${output}")
    fi
    if [ -z "$rotation" ]; then
        rotation=$(settings_get display.rotate)
    fi

    rotation_to_transform "$rotation"
}

trim() {
    printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

is_safe_sway_match_value() {
    case "$1" in
        ""|*['"[]'*|*']'*|*'\\'*|*'$'*|*'`'*)
            return 1
            ;;
    esac
    return 0
}

is_dual_screen_app_match() {
    value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$value" in
        azahar|melon|melonds|net.kuribo64.melonds|cemu|info.cemu.cemu|gamepad|*secondary\ window*)
            return 0
            ;;
    esac
    return 1
}

write_single_app_route() {
    field="$1"
    value="$2"

    is_safe_sway_match_value "$value" || return 0
    is_dual_screen_app_match "$value" && return 0

    echo "for_window [${field}=\"${value}\"] move to output \$secondary_output"
}

write_app_route() {
    route=$(trim "$1")
    [ -n "$route" ] || return 0

    case "$route" in
        bcc|controlcenter|batocera-controlcenter)
            write_single_app_route title "Batocera Control Center"
            ;;
        app_id:*)
            write_single_app_route app_id "$(trim "${route#app_id:}")"
            ;;
        class:*)
            write_single_app_route class "$(trim "${route#class:}")"
            ;;
        title:*)
            write_single_app_route title "$(trim "${route#title:}")"
            ;;
        instance:*)
            write_single_app_route instance "$(trim "${route#instance:}")"
            ;;
        *)
            write_single_app_route app_id "$route"
            write_single_app_route class "$route"
            write_single_app_route title "$route"
            ;;
    esac
}

write_app_routing_file() {
    apps=$(settings_get global.secondary_screen_apps)

    {
        echo "# Generated by sway-launch."
        echo "# Comma-separated source setting: global.secondary_screen_apps"
        old_ifs=$IFS
        IFS=,
        for app in $apps; do
            write_app_route "$app"
        done
        IFS=$old_ifs

        write_emulator_dual_screen_route
    } > "$SWAY_APP_ROUTING_FILE"
}

write_dual_screen_route_for_match() {
    match="$1"

    echo "for_window [${match}] fullscreen disable"
    echo "for_window [${match}] floating enable"
    echo "for_window [${match}] border none"
    echo "for_window [${match}] resize set width ${dual_screen_canvas_width} px height ${dual_screen_canvas_height} px"
    echo "for_window [${match}] move absolute position 0px 0px"
    echo "for_window [${match}] focus"
}

write_emulator_dual_screen_route() {
    [ "$model" = "AYN_Thor" ] || return 0
    [ "$display_position" = "top-bottom" ] || return 0
    [ -n "$secondary_display" ] || return 0
    is_number "$primary_width" || return 0
    is_number "$primary_height" || return 0
    is_number "$secondary_height" || return 0

    dual_screen_canvas_width="$primary_width"
    dual_screen_canvas_height=$((primary_height + secondary_height))

    echo
    echo "# AYN Thor: DraStic must span the stacked outputs; the generic fullscreen rule is single-output."
    write_dual_screen_route_for_match 'app_id="drastic"'
    write_dual_screen_route_for_match 'class="drastic"'
    write_dual_screen_route_for_match 'title="DraStic"'
    write_dual_screen_route_for_match 'title=".*DraStic.*"'

    echo
    echo "# AYN Thor: dual-screen RetroArch cores must span the stacked outputs; RetroArch keeps its generic app id."
    write_dual_screen_route_for_match 'app_id="retroarch-dualscreen"'
    write_dual_screen_route_for_match 'class="retroarch-dualscreen"'
    write_dual_screen_route_for_match 'title="RetroArch melonDS.*"'
    write_dual_screen_route_for_match 'title="RetroArch Azahar.*"'
    write_dual_screen_route_for_match 'title="RetroArch azahar.*"'
}

thor_panel_toggle() {
    model=$(batocera-model 2>/dev/null)
    display_position=$(settings_get display.position)
    primary=$(settings_get global.videooutput)
    secondary=$(settings_get global.videooutput2)

    if [ "$model" != "AYN_Thor" ] || [ "$display_position" != "top-bottom" ] || [ "$primary" != "DSI-2" ] || [ "$secondary" != "DSI-1" ]; then
        return 0
    fi

    log_message "Applying AYN Thor panel toggle before Sway starts."
    touch /tmp/no-hotplug

    for status_path in /sys/class/drm/card*-DSI-2/status; do
        [ -e "$status_path" ] || continue
        echo off > "$status_path" 2>/dev/null
        sleep 0.1
        echo on > "$status_path" 2>/dev/null
    done

    sleep 0.1
    for status_path in /sys/class/drm/card*-DSI-1/status; do
        [ -e "$status_path" ] || continue
        echo on > "$status_path" 2>/dev/null
    done
}

# Function to gather all connected displays
get_connected_displays() {
    connected_displays=""
    for drm_path in /sys/class/drm/card*/card*-*/status; do
        [ -e "$drm_path" ] || continue
        if [ "$(cat "$drm_path")" = "connected" ]; then
            # Extract the display name by removing the card prefix (e.g., "card2-")
            drm_display=$(basename "$(dirname "$drm_path")" | cut -d'-' -f2-)
            connected_displays="$connected_displays $drm_display"
        fi
    done
    echo "$connected_displays"
}

display_is_connected() {
    wanted="$1"
    for display in $connected_displays; do
        if [ "$display" = "$wanted" ]; then
            return 0
        fi
    done
    return 1
}

write_output_block() {
    output="$1"
    role="$2"
    pos_x="$3"
    pos_y="$4"
    transform=$(display_rotation "$output" "$role")

    echo "output ${output} {"
    echo "    enable"
    if [ "$transform" != "normal" ]; then
        echo "    transform ${transform}"
    fi
    if [ -n "$pos_x" ] && [ -n "$pos_y" ]; then
        echo "    pos ${pos_x} ${pos_y}"
    fi
    echo "}"
    echo
}

thor_panel_toggle

preferred_display=$(settings_get global.videooutput)
secondary_display=$(settings_get global.videooutput2)
display_position=$(settings_get display.position)
model=$(batocera-model 2>/dev/null)

connected_displays=$(get_connected_displays)
log_message "Connected displays = ${connected_displays}"

if [ -z "$preferred_display" ] || ! display_is_connected "$preferred_display"; then
    set -- $connected_displays
    preferred_display="$1"
fi

if [ -z "$preferred_display" ]; then
    log_message "Error: Failed to retrieve preferred display setting."
    {
        echo "set \$primary_output \"\""
        echo "set \$secondary_output \"\""
    } > "$SWAY_CONF_FILE"
    write_app_routing_file
else
    if [ -n "$secondary_display" ] && [ "$secondary_display" != "$preferred_display" ] && ! display_is_connected "$secondary_display"; then
        log_message "Secondary display ${secondary_display} is not connected; disabling dual-output layout."
        secondary_display=
    fi

    primary_x=0
    primary_y=0
    secondary_x=
    secondary_y=

    if [ -n "$secondary_display" ]; then
        case "$display_position" in
            top-bottom)
                primary_resolution=$(settings_get es.resolution)
                primary_transform=$(display_rotation "$preferred_display" primary)
                primary_width=$(resolution_effective_width "$primary_resolution" "$primary_transform")
                primary_height=$(resolution_effective_height "$primary_resolution" "$primary_transform")
                secondary_resolution=$(settings_get es.resolution2)
                secondary_transform=$(display_rotation "$secondary_display" secondary)
                secondary_width=$(resolution_effective_width "$secondary_resolution" "$secondary_transform")
                secondary_height=$(resolution_effective_height "$secondary_resolution" "$secondary_transform")
                if ! is_number "$primary_width" && [ "$model" = "AYN_Thor" ] && [ "$preferred_display" = "DSI-2" ] && [ "$secondary_display" = "DSI-1" ]; then
                    primary_width=1920
                fi
                if ! is_number "$primary_height" && [ "$model" = "AYN_Thor" ] && [ "$preferred_display" = "DSI-2" ] && [ "$secondary_display" = "DSI-1" ]; then
                    primary_height=1080
                fi
                if ! is_number "$secondary_width" && [ "$model" = "AYN_Thor" ] && [ "$preferred_display" = "DSI-2" ] && [ "$secondary_display" = "DSI-1" ]; then
                    secondary_width=1240
                fi
                if ! is_number "$secondary_height" && [ "$model" = "AYN_Thor" ] && [ "$preferred_display" = "DSI-2" ] && [ "$secondary_display" = "DSI-1" ]; then
                    secondary_height=1080
                fi
                if ! is_number "$primary_width"; then
                    primary_width=0
                fi
                if ! is_number "$primary_height"; then
                    primary_height=0
                fi
                if ! is_number "$secondary_height"; then
                    secondary_height=0
                fi
                if is_number "$secondary_width" && [ "$primary_width" -gt "$secondary_width" ]; then
                    secondary_x=$(( (primary_width - secondary_width) / 2 ))
                else
                    secondary_x=0
                fi
                secondary_y="$primary_height"
                ;;
            *)
                primary_resolution=$(settings_get es.resolution)
                primary_transform=$(display_rotation "$preferred_display" primary)
                primary_width=$(resolution_effective_width "$primary_resolution" "$primary_transform")
                if ! is_number "$primary_width"; then
                    primary_width=0
                fi
                secondary_x="$primary_width"
                secondary_y=0
                ;;
        esac
    fi

    log_message "Preferred display = ${preferred_display}"
    log_message "Secondary display = ${secondary_display:-none}"
    log_message "Display position = ${display_position:-default}"
    log_message "Writing display configuration to ${SWAY_CONF_FILE}"

    {
        echo "set \$primary_output ${preferred_display}"
        if [ -n "$secondary_display" ]; then
            echo "set \$secondary_output ${secondary_display}"
        else
            echo "set \$secondary_output ${preferred_display}"
        fi
        echo

        write_output_block "$preferred_display" primary "$primary_x" "$primary_y"

        if [ -n "$secondary_display" ]; then
            write_output_block "$secondary_display" secondary "$secondary_x" "$secondary_y"
        fi

        for display in $connected_displays; do
            if [ "$display" != "$preferred_display" ] && [ "$display" != "$secondary_display" ]; then
                log_message "Disabling display ${display}"
                echo "output ${display} {"
                echo "    disable"
                echo "}"
                echo
            fi
        done
    } > "$SWAY_CONF_FILE"
    write_app_routing_file
fi

# Start Sway with specified environment variable, logging output
log_message "Starting Sway..."
case "${XKB_LAYOUT:-}" in
    ""|en)
        export XKB_LAYOUT=us
        ;;
esac
case "${XKB_DEFAULT_LAYOUT:-}" in
    ""|en)
        export XKB_DEFAULT_LAYOUT="$XKB_LAYOUT"
        ;;
esac
export XKB_VARIANT="${XKB_VARIANT:-}"
# Use -d for debugging
#WLR_LIBINPUT_NO_DEVICES=1 /usr/bin/sway -d > "$SWAY_LOG_FILE" 2>&1
WLR_LIBINPUT_NO_DEVICES=1 /usr/bin/sway > "$SWAY_LOG_FILE" 2>&1

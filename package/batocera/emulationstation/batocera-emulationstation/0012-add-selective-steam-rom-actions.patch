+++ b/es-app/src/services/HttpApi.h
@@ -12,7 +12,7 @@ class HttpApi
 public:
 	static std::string getCaps();
 	static std::string getSystemList();
-	static std::string getSystemGames(SystemData* system);
+	static std::string getSystemGames(SystemData* system, bool localpaths = false);
 
 	static std::string getRunnningGameInfo();
 
diff --git a/es-app/src/services/HttpApi.cpp b/es-app/src/services/HttpApi.cpp
--- a/es-app/src/services/HttpApi.cpp
+++ b/es-app/src/services/HttpApi.cpp
@@ -280,7 +280,7 @@ std::string HttpApi::ToJson(SystemData* system, bool localpaths)
 	return s.GetString();
 }
 
-std::string HttpApi::getSystemGames(SystemData* system)
+std::string HttpApi::getSystemGames(SystemData* system, bool localpaths)
 {
 	rapidjson::StringBuffer s;
 	rapidjson::PrettyWriter<rapidjson::StringBuffer> writer(s);
@@ -305,7 +305,7 @@ std::string HttpApi::getSystemGames(SystemData* system)
 	}
 
 	for (auto game : files)
-		getFileDataJson(writer, game);
+		getFileDataJson(writer, game, localpaths);
 
 	writer.EndArray();
 
diff --git a/es-app/src/services/HttpServerThread.cpp b/es-app/src/services/HttpServerThread.cpp
--- a/es-app/src/services/HttpServerThread.cpp
+++ b/es-app/src/services/HttpServerThread.cpp
@@ -345,9 +345,10 @@ void HttpServerThread::start()
 		SystemData* system = SystemData::getSystem(systemName);
 		if (system != nullptr)
 		{
-			res.set_content(HttpApi::getSystemGames(system), "application/json");
+			bool localpaths = req.has_param("localpaths") && req.get_param_value("localpaths") == "true";
+			res.set_content(HttpApi::getSystemGames(system, localpaths), "application/json");
 			return;
 		}
 		
 		res.set_content("404 system not found", "text/html");
 		res.status = 404;		
 	});

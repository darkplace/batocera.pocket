#!/bin/sh

LOG="/userdata/system/logs/qcom-motion-calibrator.log"
SERVICE="${QCOM_MOTION_SERVICE:-/etc/init.d/S29qcom-motion}"
APP="${QCOM_MOTION_APP:-/usr/share/batocera/qcom-motion/motion-calibrator.py}"

mkdir -p "$(dirname "${LOG}")"

if grep -aq "ayn,odin3" /proc/device-tree/compatible 2>/dev/null; then
	export QCOM_MOTION_DEVICE="odin3"
	export QCOM_MOTION_DEVICE_NAME="AYN Odin 3"
	default_calibration="/userdata/system/qcom-sensors/odin3/motion-calibration.ini"
elif grep -aq "ayn,thor" /proc/device-tree/compatible 2>/dev/null; then
	export QCOM_MOTION_DEVICE="thor"
	export QCOM_MOTION_DEVICE_NAME="AYN Thor"
	default_calibration="/userdata/system/qcom-sensors/thor/motion-calibration.ini"
else
	echo "No supported Qualcomm motion sensor profile was found" >> "${LOG}"
	batocera-flash-screen 5 "#ffffff" "Supported motion sensor not found." 20 >/dev/null 2>&1 || true
	exit 1
fi

export QCOM_MOTION_CALIBRATION_FILE="${QCOM_MOTION_CALIBRATION_FILE:-${default_calibration}}"
export HOME="/userdata/system"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${HOME}/.cache"
export PYTHONDONTWRITEBYTECODE=1

if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ] && command -v getLocalXDisplay >/dev/null 2>&1; then
	export DISPLAY="$(getLocalXDisplay)"
fi

status=0
python3 "${APP}" >> "${LOG}" 2>&1 || status=$?
"${SERVICE}" start >/dev/null 2>&1 || true
exit "${status}"

+    std::vector<std::uint8_t> avpacket_extract_h264_annexb_parameter_sets(const AVPacket *packet) {
+      std::vector<std::uint8_t> parameter_sets;
+      if (!packet || !packet->data || packet->size <= 0) {
+        return parameter_sets;
+      }
+
+      const auto *data = packet->data;
+      const auto size = (std::size_t) packet->size;
+      std::size_t start_code_len = 0;
+
+      for (auto offset = find_h264_start_code(data, size, 0, start_code_len); offset != npos;) {
+        auto nal_start = offset + start_code_len;
+        auto next_start_code_len = std::size_t {};
+        auto next = find_h264_start_code(data, size, nal_start, next_start_code_len);
+        auto nal_end = next == npos ? size : next;
+
+        if (nal_start < nal_end) {
+          auto nal_type = data[nal_start] & 0x1f;
+          if (nal_type == 7 || nal_type == 8) {
+            parameter_sets.insert(std::end(parameter_sets), data + offset, data + nal_end);
+          }
+        }
+
+        if (next == npos) {
+          break;
+        }
+
+        offset = next;
+        start_code_len = next_start_code_len;
+      }
+
+      return parameter_sets;
+    }
+
+    bool avpacket_contains_h264_parameter_sets(const AVPacket *packet) {
+      return avpacket_contains_h264_annexb_nal(packet, 7) && avpacket_contains_h264_annexb_nal(packet, 8);
+    }

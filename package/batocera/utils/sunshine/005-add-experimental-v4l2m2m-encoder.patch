+    std::size_t find_h264_start_code(const std::uint8_t *data, std::size_t size, std::size_t offset, std::size_t &start_code_len) {
+      for (std::size_t i = offset; i + 3 <= size; i++) {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+          start_code_len = 3;

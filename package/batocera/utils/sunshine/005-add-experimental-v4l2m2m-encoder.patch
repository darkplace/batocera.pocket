+        if (i + 4 <= size && data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 0 && data[i + 3] == 1) {
+          start_code_len = 4;
+          return i;
+        }
+      }
+
+      start_code_len = 0;
+      return npos;
+    }
+
+    bool avpacket_contains_h264_annexb_nal(const AVPacket *packet, std::uint8_t nal_type) {
+      if (!packet || !packet->data || packet->size <= 0) {
+        return false;
+      }
+
+      const auto *data = packet->data;
+      const auto size = (std::size_t) packet->size;
+      std::size_t start_code_len = 0;
+
+      for (auto offset = find_h264_start_code(data, size, 0, start_code_len); offset != npos; offset = find_h264_start_code(data, size, offset + start_code_len, start_code_len)) {
+        auto nal_start = offset + start_code_len;
+        if (nal_start < size && ((data[nal_start] & 0x1f) == nal_type)) {
+          return true;
+        }
+      }
+
+      return false;
+    }

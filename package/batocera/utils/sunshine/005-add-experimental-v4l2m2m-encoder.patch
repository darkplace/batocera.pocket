+    bool avpacket_contains_h264_idr(const AVPacket *packet) {
+      if (!packet || !packet->data || packet->size <= 0) {
+        return false;
+      }
+
+      if (avpacket_contains_h264_annexb_nal(packet, 5)) {
+        return true;
+      }
+
+      const auto *data = packet->data;
+      const auto size = (std::size_t) packet->size;
+
+      for (auto length_size : {4u, 2u, 1u}) {
+        std::size_t offset = 0;
+        while (offset + length_size < size) {
+          std::uint32_t nal_size = 0;
+          for (auto i = 0u; i < length_size; i++) {
+            nal_size = (nal_size << 8) | data[offset + i];
+          }
+
+          if (nal_size == 0 || offset + length_size + nal_size > size) {
+            break;
+          }
+
+          if ((data[offset + length_size] & 0x1f) == 5) {
+            return true;
+          }
+
+          offset += length_size + nal_size;
+        }
+      }
+
+      return false;
+    }

    filtered="$(ge_proton_json_from_url "$url")" || {
        msg_box "Unsupported GE-Proton URL:\n${url}\n\nExpected a GitHub release asset like:\n${sample_url}"
        return 1
    }

    download_release_selection "GE-Proton URL" "Install this GE-Proton archive as a Wine runner:" "$filtered"
}


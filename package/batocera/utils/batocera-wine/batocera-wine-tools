canonical_path() {
    local path="$1"
    local resolved

    path="${path%/}"
    [ -n "$path" ] || return 1

    resolved="$(readlink -f "$path" 2>/dev/null || true)"
    if [ -n "$resolved" ]; then
        printf '%s\n' "$resolved"
    else
        printf '%s\n' "$path"
    fi
}


download_steam_proton_cachyos_url() {
    local url="$1"
    local archive dirname version steam_root compat_dir tmpfile outdir

    case "$(uname -m)" in
        aarch64|arm64) ;;
        *)
            msg_box "Steam Proton-CachyOS ARM64 downloads are only enabled on ARM64 builds."
            return 1
            ;;
    esac

    [[ "$url" =~ ^https://github\.com/CachyOS/proton-cachyos/releases/download/[A-Za-z0-9._-]+/proton-cachyos-[A-Za-z0-9._-]+-arm64\.tar\.xz$ ]] || {
        msg_box "Unsupported Proton-CachyOS URL:\n${url}\n\nExpected a GitHub release asset like:\n${CACHYOS_PROTON_SAMPLE_URL}"
        return 1
    }

    require_commands wget tar xz || return 1

    archive="$(basename_from_url "$url")"
    dirname="$(archive_dir_name "$archive")" || {
        msg_box "Unsupported archive format: ${archive}"
        return 1
    }
    version="${dirname#proton-cachyos-}"
    version="${version%-arm64}"
    steam_root="$(steam_root_dir)"
    compat_dir="${steam_root}/compatibilitytools.d"
    tmpfile="${compat_dir}/${archive}"
    outdir="${compat_dir}/${dirname}"

    mkdir -p "$compat_dir" || return 1

    if [ -x "$outdir/proton" ]; then
        prepare_steam_proton_cachyos_dir "$outdir" "$version"
        write_steam_proton_cachyos_config "$version" "$url" || true
        return 0
    fi

    if ! download_with_gauge "$url" "$tmpfile" "Downloading Proton-CachyOS ${version} for Steam..."; then
        msg_box "Download failed: ${archive}"
        rm -f "$tmpfile"
        return 1
    fi

    rm -rf "$outdir"
    mkdir -p "$outdir" || return 1
    if ! extract_archive_with_gauge "$tmpfile" "$outdir" "Extracting Proton-CachyOS ${version} for Steam..."; then
        msg_box "Extraction failed: ${archive}"
        rm -f "$tmpfile"
        rm -rf "$outdir"
        return 1
    fi
    rm -f "$tmpfile"

    prepare_steam_proton_cachyos_dir "$outdir" "$version"
    if [ ! -x "$outdir/proton" ]; then
        msg_box "Proton-CachyOS ${version} did not install a runnable proton script at:\n${outdir}/proton"
        return 1
    fi

    write_steam_proton_cachyos_config "$version" "$url" || {
        msg_box "Installed ${version}, but failed to write ${STEAM_PROTON_CACHYOS_CONFIG}."
        return 1
    }
    return 0
}


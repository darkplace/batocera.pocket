clear_screen() {
    clear >/dev/null 2>&1 || true
}

msg_box() {
    dialog --msgbox "$1" 14 78 2>&1 >/dev/tty
    clear_screen
}

yes_no() {
    dialog --yesno "$1" 14 78 2>&1 >/dev/tty
    local rc=$?
    clear_screen
    return "$rc"
}

info_box() {
    dialog --infobox "$1" 6 72 2>&1 >/dev/tty
}

dialog_capture_stdout() {
    dialog --stdout "$@" </dev/tty 2>/dev/tty
}

require_dialog() {
    if ! command -v dialog >/dev/null 2>&1; then
        echo "batocera-wine-tools requires dialog." >&2
        exit 1
    fi
    if ! [ -t 0 ] && ! [ -t 1 ] && ! [ -t 2 ]; then
        echo "batocera-wine-tools requires an interactive terminal." >&2
        exit 1
    fi
}

require_commands() {
    local missing=() cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        msg_box "Missing required commands: ${missing[*]}"
        return 1
    fi
    return 0
}

select_single() {
    local title="$1"
    local prompt="$2"
    shift 2
    local entries=("$@")
    local options=()
    local idx choice

    [ "${#entries[@]}" -gt 0 ] || return 1

    for idx in "${!entries[@]}"; do
        options+=("$((idx + 1))" "${entries[$idx]}")
    done

    choice=$(dialog --clear --title "$title" --menu "$prompt" 22 100 12 "${options[@]}" 2>&1 >/dev/tty) || {
        clear_screen
        return 1
    }
    clear_screen
    printf '%s\n' "${entries[$((choice - 1))]}"
}

menu_label_for_path() {
    local path="$1"
    local root="${2:-}"
    local label="$path"

    if [ -n "$root" ] && [[ "$path" == "$root/"* ]]; then
        label="${path#"$root"/}"
    elif [[ "$path" == "$ROOT_ROMS_WINDOWS/"* ]]; then
        label="${path#"$ROOT_ROMS_WINDOWS"/}"
    fi

    printf '%s\n' "$label"
}

select_path_single() {
    local title="$1"
    local prompt="$2"
    local root="$3"
    shift 3
    local entries=("$@")
    local options=()
    local idx choice label

    [ "${#entries[@]}" -gt 0 ] || return 1

    for idx in "${!entries[@]}"; do
        label="$(menu_label_for_path "${entries[$idx]}" "$root")"
        options+=("$((idx + 1))" "$label")
    done

    choice=$(dialog --clear --title "$title" --menu "$prompt" 20 86 12 "${options[@]}" 2>&1 >/dev/tty) || {
        clear_screen
        return 1
    }
    clear_screen
    printf '%s\n' "${entries[$((choice - 1))]}"
}

select_multiple_from_json() {
    local title="$1"
    local prompt="$2"
    local json="$3"
    local options=()
    local count idx label

    count=$(printf '%s' "$json" | jq 'length') || return 1
    [ "$count" -gt 0 ] || return 1

    for ((idx=0; idx<count; idx++)); do
        label=$(printf '%s' "$json" | jq -r ".[$idx].label")
        options+=("$((idx + 1))" "$label" off)
    done

    dialog --separate-output --title "$title" --checklist "$prompt" 24 100 14 "${options[@]}" 2>&1 >/dev/tty
    local rc=$?
    clear_screen
    return "$rc"
}

select_single_from_json() {

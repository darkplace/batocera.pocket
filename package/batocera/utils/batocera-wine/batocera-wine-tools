            return 1
            ;;
    esac

    while IFS= read -r line; do
        [ -n "$line" ] && exes+=("$line")
    done < <(collect_steam_exes_for_windows_game "${selected}")

    if [ "${#exes[@]}" -eq 0 ]; then
        msg_box "No non-empty .exe target found for $(basename "${selected}").\n\nIf this is a .pc/.wine folder, create/fix autorun.cmd or choose a real .exe inside the folder."
        return 1
    fi

    if [ "${#exes[@]}" -eq 1 ]; then
        selected_exe="${exes[0]}"
    else
        exe_root="${selected}"
        [ -d "${exe_root}" ] || exe_root="$(dirname "${selected}")"
        selected_exe=$(select_path_single "Choose Steam executable" "Choose the .exe for Steam/Proton. autorun.cmd is first when found." "${exe_root}" "${exes[@]}") || return 1
    fi

    info_box "Adding $(basename "$selected_exe") to Steam..."

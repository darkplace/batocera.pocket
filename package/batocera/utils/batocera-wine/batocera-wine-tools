trim_autorun_value() {
    local value="$1"
    value="${value%$'\r'}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    if [[ "${value}" == \"*\" && "${value}" == *\" ]]; then
        value="${value:1:${#value}-2}"
    fi
    printf '%s\n' "${value}"
}

autorun_exe_for_steam() {
    local game_dir="$1"
    local autorun="${game_dir}/autorun.cmd"
    local line key value cmd="" dir="." candidate exe base

    [ -f "${autorun}" ] || return 1
    while IFS= read -r line; do
        [[ "${line}" == *=* ]] || continue
        key="${line%%=*}"
        value="${line#*=}"
        key="${key^^}"
        key="${key//[[:space:]]/}"
        case "${key}" in
            CMD) cmd="$(trim_autorun_value "${value}")" ;;
            DIR) dir="$(trim_autorun_value "${value}")" ;;
        esac
    done < "${autorun}"

    [ -n "${cmd}" ] || return 1
    cmd="${cmd//\\//}"
    dir="${dir//\\//}"
    if [[ "${cmd}" == /* ]]; then
        candidate="${cmd}"
    else
        candidate="${game_dir}/${dir:-.}/${cmd}"
    fi
    if [[ -s "${candidate}" && "${candidate,,}" == *.exe ]]; then
        printf '%s\n' "${candidate}"
        return 0
    fi

    base="$(basename "${cmd}")"
    while IFS= read -r -d '' exe; do
        [ -s "${exe}" ] || continue
        if [[ "$(basename "${exe}")" == "${base}" ]]; then
            printf '%s\n' "${exe}"
            return 0
        fi
    done < <(find "${game_dir}" -type f -iname '*.exe' -print0 2>/dev/null)
    return 1
}

collect_steam_exes_for_windows_game() {
    local selected="$1"
    local ext="${selected##*.}"
    local exe suggested seen=""

    case "${ext,,}" in
        exe)
            [ -s "${selected}" ] && printf '%s\n' "${selected}"
            ;;
        pc|wine)
            [ -d "${selected}" ] || return 0
            suggested="$(autorun_exe_for_steam "${selected}" || true)"
            if [ -n "${suggested}" ]; then
                printf '%s\n' "${suggested}"
                seen=$'\n'"${suggested}"$'\n'
            fi
            while IFS= read -r -d '' exe; do
                [ -s "${exe}" ] || continue
                [[ "${seen}" == *$'\n'"${exe}"$'\n'* ]] && continue
                printf '%s\n' "${exe}"
                seen+="${exe}"$'\n'
            done < <(find "${selected}" -type f -iname '*.exe' -print0 2>/dev/null | sort -z)
            ;;
    esac
}


steam_root_dir() {
    case "$(uname -m)" in
        aarch64|arm64)
            printf '%s\n' "${BATOCERA_STEAM_ROOT:-/userdata/system/.local/share/Steam}"
            ;;
        *)
            printf '%s\n' "${BATOCERA_STEAM_ROOT:-/userdata/system/steam}"
            ;;
    esac
}

write_steam_proton_cachyos_config() {
    local version="$1"
    local url="$2"

    mkdir -p "$(dirname "$STEAM_PROTON_CACHYOS_CONFIG")" || return 1
    {
        printf '%s\n' "# Batocera Steam Proton-CachyOS ARM64 selection"
        printf '%s\n' "BATOCERA_STEAM_PROTON_CACHYOS=1"
        printf '%s\n' "BATOCERA_STEAM_PROTON_CACHYOS_VERSION=${version}"
        printf '%s\n' "BATOCERA_STEAM_PROTON_CACHYOS_URL=${url}"
    } > "$STEAM_PROTON_CACHYOS_CONFIG"
    chmod 0644 "$STEAM_PROTON_CACHYOS_CONFIG" 2>/dev/null || true
}

write_steam_proton_ge_config() {
    local version="$1"
    local url="$2"

    mkdir -p "$(dirname "$STEAM_PROTON_GE_CONFIG")" || return 1
    {
        printf '%s\n' "# Batocera Steam GE-Proton selection"
        printf '%s\n' "BATOCERA_STEAM_PROTON_GE=1"
        printf '%s\n' "BATOCERA_STEAM_PROTON_GE_VERSION=${version}"
        printf '%s\n' "BATOCERA_STEAM_PROTON_GE_URL=${url}"
    } > "$STEAM_PROTON_GE_CONFIG"
    chmod 0644 "$STEAM_PROTON_GE_CONFIG" 2>/dev/null || true
}

write_steam_proton_toolmanifest_vdf() {
    local target="$1"

    cat > "$target" <<'EOF'
"manifest"
{
  "version" "2"
  "commandline" "/proton %verb%"
  "use_sessions" "1"
  "compatmanager_layer_name" "proton"
}
EOF
}

write_steam_proton_cachyos_compatibilitytool_vdf() {
    local outdir="$1"
    local version="$2"
    local tool_id="proton-cachyos-${version}-arm64"

    cat > "${outdir}/compatibilitytool.vdf" <<EOF
"compatibilitytools"
{
  "compat_tools"
  {
    "${tool_id}"
    {
      "install_path" "."
      "display_name" "Proton-CachyOS ${version} (ARM64)"
      "from_oslist" "windows"
      "to_oslist" "linux"
    }
  }
}
EOF
}

write_steam_proton_ge_compatibilitytool_vdf() {
    local outdir="$1"
    local version="$2"
    local tool_id="ge-proton-${version#GE-Proton}"

    cat > "${outdir}/compatibilitytool.vdf" <<EOF
"compatibilitytools"
{
  "compat_tools"
  {
    "${tool_id}"
    {
      "install_path" "."
      "display_name" "${version}"
      "from_oslist" "windows"
      "to_oslist" "linux"
    }
  }
}
EOF
}

prepare_steam_proton_cachyos_dir() {
    local outdir="$1"
    local version="$2"
    local manifest="${outdir}/toolmanifest.vdf"

    if [ ! -e "$outdir/files" ] && [ -d "$outdir/share/default_pfx_arm64" ]; then
        ln -s . "$outdir/files" 2>/dev/null || true
    fi

    if [ -f "$manifest" ]; then
        sed -i '/require_tool_appid/d' "$manifest" 2>/dev/null || true
    fi
    if [ ! -f "$manifest" ] || ! grep -q '"commandline"[[:space:]]*"/proton %verb%"' "$manifest" 2>/dev/null; then
        write_steam_proton_toolmanifest_vdf "$manifest"
    fi

    write_steam_proton_cachyos_compatibilitytool_vdf "$outdir" "$version"
    chmod +x "$outdir/proton" 2>/dev/null || true
}

prepare_steam_proton_ge_dir() {
    local outdir="$1"
    local version="$2"
    local manifest="${outdir}/toolmanifest.vdf"

    if [ -f "$manifest" ]; then
        sed -i '/require_tool_appid/d' "$manifest" 2>/dev/null || true
    fi
    if [ ! -f "$manifest" ] || ! grep -q '"commandline"[[:space:]]*"/proton %verb%"' "$manifest" 2>/dev/null; then
        write_steam_proton_toolmanifest_vdf "$manifest"
    fi

    write_steam_proton_ge_compatibilitytool_vdf "$outdir" "$version"
    chmod +x "$outdir/proton" 2>/dev/null || true
}

download_steam_proton_cachyos_selection() {
    local json="$1"
    local selections idx archive url dirname version steam_root compat_dir tmpfile outdir
    local default_version="" default_url="" installed=0 failed=0

    selections=$(select_multiple_from_json \
        "Steam Proton-CachyOS ARM64" \
        "Select one or more Proton builds for Steam to download:" \
        "$json") || return 1
    [ -n "$selections" ] || return 1

    steam_root="$(steam_root_dir)"
    compat_dir="${steam_root}/compatibilitytools.d"
    mkdir -p "$compat_dir" || return 1

    for idx in $selections; do
        idx=$((idx - 1))
        archive=$(printf '%s' "$json" | jq -r ".[$idx].archive")
        url=$(printf '%s' "$json" | jq -r ".[$idx].url")
        dirname=$(archive_dir_name "$archive") || {
            msg_box "Unsupported archive format: ${archive}"
            failed=$((failed + 1))
            continue
        }
        version="${dirname#proton-cachyos-}"
        version="${version%-arm64}"
        tmpfile="${compat_dir}/${archive}"
        outdir="${compat_dir}/${dirname}"

        if ! download_with_gauge "$url" "$tmpfile" "Downloading Proton-CachyOS ${version} for Steam..."; then
            msg_box "Download failed: ${archive}"
            rm -f "$tmpfile"
            failed=$((failed + 1))
            continue
        fi

        rm -rf "$outdir"
        mkdir -p "$outdir" || return 1
        if ! extract_archive_with_gauge "$tmpfile" "$outdir" "Extracting Proton-CachyOS ${version} for Steam..."; then
            msg_box "Extraction failed: ${archive}"
            rm -f "$tmpfile"
            rm -rf "$outdir"
            failed=$((failed + 1))
            continue
        fi
        rm -f "$tmpfile"

        prepare_steam_proton_cachyos_dir "$outdir" "$version"
        if [ ! -x "$outdir/proton" ]; then
            msg_box "Proton-CachyOS ${version} did not install a runnable proton script at:\n${outdir}/proton"
            failed=$((failed + 1))
            continue
        fi

        default_version="$version"
        default_url="$url"
        installed=$((installed + 1))
    done

    if [ "$installed" -eq 0 ]; then
        msg_box "No Proton-CachyOS builds for Steam were installed."
        return 1
    fi

    write_steam_proton_cachyos_config "$default_version" "$default_url" || {
        msg_box "Installed ${installed} build(s), but failed to write ${STEAM_PROTON_CACHYOS_CONFIG}."
        return 1
    }

    msg_box "Installed ${installed} Proton-CachyOS build(s) for Steam.\n\nSteam will list each build as a separate compatibility tool after restart. The last installed build, ${default_version}, is now the default preflight install target.\n\nFailed installs: ${failed}"
}

download_steam_proton_ge_url() {
    local url="$1"
    local archive dirname version steam_root compat_dir tmpfile outdir

    is_ge_proton_url "$url" || {
        msg_box "Unsupported GE-Proton URL:\n${url}\n\nExpected a GitHub release asset like:\n${GE_PROTON_SAMPLE_URL}"
        return 1
    }

    require_commands wget tar || return 1

    archive="$(basename_from_url "$url")"
    dirname="$(archive_dir_name "$archive")" || {
        msg_box "Unsupported archive format: ${archive}"
        return 1
    }
    version="$dirname"
    steam_root="$(steam_root_dir)"
    compat_dir="${steam_root}/compatibilitytools.d"
    tmpfile="${compat_dir}/${archive}"
    outdir="${compat_dir}/${dirname}"

    mkdir -p "$compat_dir" || return 1

    if ! download_with_gauge "$url" "$tmpfile" "Downloading ${version} for Steam..."; then
        msg_box "Download failed: ${archive}"
        rm -f "$tmpfile"
        return 1
    fi

    rm -rf "$outdir"
    mkdir -p "$outdir" || return 1
    if ! extract_archive_with_gauge "$tmpfile" "$outdir" "Extracting ${version} for Steam..."; then
        msg_box "Extraction failed: ${archive}"
        rm -f "$tmpfile"
        rm -rf "$outdir"
        return 1
    fi
    rm -f "$tmpfile"

    prepare_steam_proton_ge_dir "$outdir" "$version"
    if [ ! -x "$outdir/proton" ]; then
        msg_box "${version} did not install a runnable proton script at:\n${outdir}/proton"
        return 1
    fi

    write_steam_proton_ge_config "$version" "$url" || {
        msg_box "Installed ${version}, but failed to write ${STEAM_PROTON_GE_CONFIG}."
        return 1
    }

    msg_box "Installed ${version} for Steam.\n\nSteam will list it as a compatibility tool after restart. It is also written as the GE-Proton preflight install target."
}


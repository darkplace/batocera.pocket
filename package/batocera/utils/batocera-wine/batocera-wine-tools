translate_free_game_installer() {
    local script="$1"

    sed -i \
        -e 's/Foclabroc Toolbox/Batocera Wine Tools/g' \
        -e 's/export LANG=fr_FR.UTF-8/export LANG=en_US.UTF-8/g' \
        -e 's/export LC_ALL=fr_FR.UTF-8/export LC_ALL=en_US.UTF-8/g' \
        -e 's|^XMLSTARLET_DIR=.*|XMLSTARLET_DIR="/usr/bin"|g' \
        -e 's|^XMLSTARLET_BIN=.*|XMLSTARLET_BIN="/usr/bin/xmlstarlet"|g' \
        -e 's|^XMLSTARLET_SYMLINK=.*|XMLSTARLET_SYMLINK="/usr/bin/xmlstarlet"|g' \
        -e 's|if \[ ! -f "$XMLSTARLET_BIN" \]; then|if false; then|g' \
        -e 's/Suppression ancien \$GAME_NAME si existant/Removing old \$GAME_NAME if present/g' \
        -e 's/echo -e "\\n\\n.*chargement de \$GAME_NAME\.\.\."/echo -e "\\n\\nDownloading $GAME_NAME..."/g' \
        -e 's/echo -e "\\nVitesse : ${SPEED_MO} Mo\/s .*"/echo -e "\\nSpeed: ${SPEED_MO} MB\/s | Downloaded: ${CURRENT_MB} \/ ${TOTAL_MB} MB"/g' \
        -e 's/echo -e "\\n\\n.*compression de \$GAME_NAME\.\.\."/echo -e "\\n\\nExtracting $GAME_NAME..."/g' \
        -e 's/echo -e "\\n\\n.*chargement du pad2key\.\.\."/echo -e "\\n\\nDownloading pad2key..."/g' \
        -e 's/--title "Installation de \$GAME_NAME"/--title "Installing $GAME_NAME"/g' \
        -e 's/--gauge "\\n.*chargement et installation de \$GAME_NAME en cours\.\.\."/--gauge "\\nDownloading and installing $GAME_NAME..."/g' \
        -e 's/--title "Edition du gamelist" --gauge "\\nAjout images et video au gamelist windows\.\.\."/--title "Editing gamelist" --gauge "\\nAdding images and videos to the Windows gamelist..."/g' \
        -e 's|dialog --backtitle "Batocera Wine Tools" --title "Installation .*|dialog --backtitle "Batocera Wine Tools" --title "Installation complete" --msgbox "\\n$GAME_NAME has been added to Windows.\\n\\nRefresh gamelists to make it appear in the menu.\\n$INFO_MESSAGE" 13 70 2>\&1 >/dev/tty|g' \
        "$script"
    patch_free_game_xmlstarlet "$script"
}

patch_free_game_xmlstarlet() {
    local script="$1"
    local marker="# __BATOCERA_NATIVE_GAMELIST_XML__"
    local stub tmp

    grep -qF "$marker" "$script" && return 0
    stub="$(mktemp)" || return 1
    tmp="$(mktemp)" || {
        rm -f "$stub"
        return 1
    }

    cat > "$stub" <<'EOF'
# __BATOCERA_NATIVE_GAMELIST_XML__
xmlstarlet() {
    if [ "${1:-}" != "ed" ]; then
        echo "Unsupported xmlstarlet command in Batocera Wine Tools: $*" >&2
        return 1
    fi

    python3 - "$GAMELIST_FILE" "$GAME_FILE_FINAL" "$GAME_NAME" "$DESC" "$GIT_NAME" "$DEV" "$PUBLISH" "$GENRE" "$LANG" "$REGION" <<'PY'
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

gamelist, game_file, game_name, desc, git_name, dev, publish, genre, lang, region = sys.argv[1:11]
path = Path(gamelist)
path.parent.mkdir(parents=True, exist_ok=True)

if path.exists() and path.stat().st_size > 0:
    try:
        tree = ET.parse(path)
        root = tree.getroot()
    except ET.ParseError:
        root = ET.Element("gameList")
        tree = ET.ElementTree(root)
else:
    root = ET.Element("gameList")
    tree = ET.ElementTree(root)

target_path = f"./{game_file}"
for old in list(root.findall("game")):
    node = old.find("path")
    if node is not None and (node.text or "") == target_path:
        root.remove(old)

game = ET.SubElement(root, "game")
fields = [
    ("path", target_path),
    ("name", game_name),
    ("desc", desc),
    ("image", f"./images/{git_name}-s.png"),
    ("video", f"./videos/{git_name}-v.mp4"),
    ("marquee", f"./images/{git_name}-w.png"),
    ("thumbnail", f"./images/{git_name}-b.png"),
    ("rating", "1.00"),
    ("developer", dev),
    ("publisher", publish),
    ("genre", genre),
    ("lang", lang),
    ("region", region),
]
for key, value in fields:
    ET.SubElement(game, key).text = value

ET.indent(tree, space="  ")
tree.write(path, encoding="UTF-8", xml_declaration=True)
PY
}
EOF

    awk -v stub="$stub" '
        index($0, "# Fonction edit gamelist") && !inserted {
            while ((getline line < stub) > 0) print line
            close(stub)
            inserted = 1
        }
        { print }
        END {
            if (!inserted) {
                while ((getline line < stub) > 0) print line
                close(stub)
            }
        }
    ' "$script" > "$tmp" && mv "$tmp" "$script"
    rm -f "$stub" "$tmp"
}


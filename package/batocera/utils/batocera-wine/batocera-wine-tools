ge_proton_menu() {
    require_commands jq curl wget tar || return 1
    local data filtered suffix arch_label
    case "$(uname -m)" in
        aarch64|arm64)
            suffix="-aarch64.tar.gz"
            arch_label="ARM64"
            ;;
        *)
            suffix="-x86_64.tar.gz"
            arch_label="x86_64"
            ;;
    esac

    data=$(fetch_json "$PROTON_GE_RELEASES_URL") || {
        msg_box "Failed to fetch GE-Proton releases."
        return 1
    }
    filtered=$(printf '%s' "$data" | jq -c --arg suffix "$suffix" --arg arch_label "$arch_label" '
        [.[] as $r
         | $r.assets[]?
         | select(
             (.name | startswith("GE-Proton")) and (
               (.name | endswith($suffix))
               or (
                 $suffix == "-x86_64.tar.gz"
                 and (.name | test("^GE-Proton[0-9]+-[0-9]+\\.tar\\.gz$"))
               )
             )
           )
         | {
             label: ("GE-Proton " + $arch_label + ": " + (.name | rtrimstr(".tar.gz") | rtrimstr("-aarch64") | rtrimstr("-x86_64")) + " [" + $r.tag_name + "]"),
             archive: .name,
             url: .browser_download_url,
             tip: (.name | rtrimstr(".tar.gz") | rtrimstr("-aarch64") | rtrimstr("-x86_64"))
           }
        ]') || {
        msg_box "Failed to parse GE-Proton releases."
        return 1
    }
    if [ "$(printf '%s' "$filtered" | jq 'length')" -eq 0 ]; then
        msg_box "No GE-Proton ${arch_label} builds were found."
        return 1
    fi
    download_release_selection "GE-Proton" "Select GE-Proton builds to download:" "$filtered"
}

ge_proton_url_menu() {
    require_commands jq wget tar || return 1

    fi

    selected=$(select_path_single "Add to Steam" "Choose a Windows game. .pc/.wine use autorun.cmd first; archives must be extracted for Proton." "${ROOT_ROMS_WINDOWS}" "${games[@]}") || return 1
    ext="${selected##*.}"
    case "${ext,,}" in

steam_roots_all() {
    local root canonical
    local seen=$'\n'

    for root in "$(steam_root_dir)" "${BATOCERA_STEAM_ROOT:-}" "${BATOCERA_STEAM_HOME:-}" \
        /userdata/system/.local/share/Steam /userdata/system/steam /userdata/system/.steam/steam; do
        [ -n "$root" ] || continue
        canonical="$(canonical_path "$root")" || continue
        [[ "$seen" == *$'\n'"$canonical"$'\n'* ]] && continue
        seen+="${canonical}"$'\n'
        printf '%s\n' "$canonical"
    done
}

collect_steam_compat_prefixes() {
    local root compat appid prefix prefix_real key
    local seen=$'\n'

    while IFS= read -r root; do
        [ -d "$root" ] || continue
        for compat in "$root"/steamapps/compatdata/* "$root"/compatdata/*; do
            [ -d "$compat" ] || continue
            appid="$(basename "$compat")"
            prefix="${compat}/pfx"
            [ -d "$prefix" ] || continue
            prefix_real="$(canonical_path "$prefix")" || prefix_real="$prefix"
            key="${appid}|${prefix_real}"
            [[ "$seen" == *$'\n'"$key"$'\n'* ]] && continue
            seen+="${key}"$'\n'
            printf '%s\n' "$key"
        done
    done < <(steam_roots_all)
}


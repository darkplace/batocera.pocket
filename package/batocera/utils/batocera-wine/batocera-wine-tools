install_decky_batocera_control_menu() {
    local tmp archive extract installer output rc summary

    require_commands wget tar sha256sum bash || return 1
    ensure_decky_loader_installed || return 1

    tmp=$(mktemp -d)
    if ! resolve_batocera_control_release "$tmp"; then
        rm -rf "$tmp"
        return 1
    fi

    yes_no "Install or update Batocera Control ${BATOCERA_CONTROL_VERSION}?\n\nThis unified Decky plugin includes global and per-game LSFG-VK controls, using Batocera's system layers plus /userdata/system/wine/lossless-scaling/Lossless.dll. Per-game activation applies on the next game launch; only all-games mode needs a Steam restart. No plugin runtime or proprietary DLL is downloaded." || {
        rm -rf "$tmp"
        return 1
    }

    archive="${tmp}/decky-bcc-${BATOCERA_CONTROL_VERSION}.tar.gz"
    extract="${tmp}/extract"
    mkdir -p "$extract"

    if ! download_verified_archive "$BATOCERA_CONTROL_URL" "$BATOCERA_CONTROL_SHA256" "$archive" "Batocera Control ${BATOCERA_CONTROL_VERSION}"; then
        rm -rf "$tmp"
        return 1
    fi

    if ! tar -xzf "$archive" -C "$extract"; then
        rm -rf "$tmp"
        msg_box "Unable to extract the Batocera Control release."
        return 1
    fi

    installer="${extract}/decky-bcc-${BATOCERA_CONTROL_VERSION}/install.sh"

    if [ ! -f "$installer" ]; then
        rm -rf "$tmp"
        msg_box "Batocera Control installer was not found in the verified release."
        return 1
    fi

    info_box "Installing Decky Batocera Control..."
    output=$(bash "$installer" 2>&1)
    rc=$?
    clear_screen
    summary="$(printf '%s\n' "${output}" | tail -n 30)"
    rm -rf "$tmp"

    if [ "${rc}" -eq 0 ]; then
        msg_box "Batocera Control ${BATOCERA_CONTROL_VERSION} installed.\n\nOpen Steam -> Quick Access -> Batocera Control. LSFG-VK supports selected games without restarting Steam, or optional all-games mode after a Steam restart. An old standalone LSFG plugin is retained under disabled-plugins for rollback.\n\n${summary}"
    else
        msg_box "Decky Batocera Control install failed:\n\n${summary}"
    fi

    return "${rc}"
}


verify_sha256_file() {
    local file="$1"
    local expected="$2"
    local actual unused

    read -r actual unused < <(sha256sum "$file")
    if [ "${actual}" != "${expected}" ]; then
        msg_box "Hash verification failed for $(basename "$file").\n\nExpected:\n${expected}\n\nGot:\n${actual}"
        return 1
    fi

    return 0
}

download_verified_archive() {

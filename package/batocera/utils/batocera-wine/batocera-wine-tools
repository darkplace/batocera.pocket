    data=$(fetch_json "$KRON4EK_RELEASES_URL") || {
        msg_box "Failed to fetch Kron4ek Wine releases."
        return 1
    }
    filtered=$(printf '%s' "$data" | jq -c '
        [.[] as $r
         | $r.assets[]?
         | select((.name | endswith("amd64.tar.xz")) or (.name | endswith("x86_64.tar.xz")))
         | select((.name | contains("staging-tkg")) | not)
         | {
             label: (.name + " [" + $r.tag_name + "]"),
             archive: .name,
             url: .browser_download_url
           }
        ]') || {
        msg_box "Failed to parse Kron4ek Wine releases."

#!/bin/sh

NAME=hotkeygen
DAEMON=/usr/bin/$NAME
PIDFILE=/var/run/$NAME.pid
DAEMON_ARGS=--permanent

# Sanity checks
test -x $DAEMON || exit 0

running() {
        [ -f "$PIDFILE" ] || return 1
        pid="$(cat "$PIDFILE" 2>/dev/null)" || return 1
        [ -n "$pid" ] || return 1
        kill -0 "$pid" 2>/dev/null
}

start() {
        printf "Starting $NAME: "
        # Avoid duplicate daemons (stale pidfile + manual starts break mappings).
        pkill -f '(^|[[:space:]])(/usr/bin/)?hotkeygen([[:space:]].*)?--permanent([[:space:]]|$)' >/dev/null 2>&1 || true
        sleep 0.2
        rm -f "$PIDFILE"
        start-stop-daemon --start --quiet -m --pidfile $PIDFILE --exec $DAEMON --background -- $DAEMON_ARGS > /var/log/hotkeygen.log 2>&1 \
                && echo "OK" || echo "FAIL"
}

stop() {
        printf "Stopping $NAME: "
        if [ -f "$PIDFILE" ] && ! running; then
                rm -f "$PIDFILE"
        fi
        start-stop-daemon --stop --quiet --pidfile $PIDFILE >/dev/null 2>&1 || true
        pkill -f '(^|[[:space:]])(/usr/bin/)?hotkeygen([[:space:]].*)?--permanent([[:space:]]|$)' >/dev/null 2>&1 || true
        rm -f "$PIDFILE"
        echo "OK"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

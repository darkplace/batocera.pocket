#!/usr/bin/env python3
"""Shift Discord/Vesktop above the OSK. Never move EmulationStation or other apps."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

STATE_PATH = Path("/var/run/batocera-osk-sway-shift.json")
HOLD_PID_PATH = Path("/var/run/batocera-osk-sway-shift.hold.pid")
OSK_PID_PATH = Path("/var/run/onscreen-keyboard.pid")
DEFAULT_KB_HEIGHT = 250
SKIP_APP = ("wvkbd", "wvkbd-mobintl", "sm.puri.osk", "onboard", "squeekboard", "emulationstation")
SKIP_NAME = ("wvkbd", "on-screen keyboard", "onscreen keyboard", "emulationstation")
DISCORD_APP = ("vesktop", "vencord")
DISCORD_NAME = ("discord",)


def resolve_swaysock() -> str | None:
    val = os.environ.get("SWAYSOCK")
    if val and os.path.exists(val):
        return val
    for cand in ("/run/sway-ipc.0.sock", "/var/run/sway-ipc.0.sock", "/run/sway-ipc.sock"):
        if os.path.exists(cand):
            return cand
    return None


def swaymsg(*args: str) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    sock = resolve_swaysock()
    if sock:
        env["SWAYSOCK"] = sock
    return subprocess.run(
        ["swaymsg", *args],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )


def get_tree() -> dict | None:
    proc = swaymsg("-t", "get_tree")
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, dict) else None


def iter_nodes(node: dict):
    yield node
    for key in ("nodes", "floating_nodes"):
        for child in node.get(key, []):
            if isinstance(child, dict):
                yield from iter_nodes(child)


def app_id_of(node: dict) -> str:
    app = (node.get("app_id") or "").lower()
    if app:
        return app
    props = node.get("window_properties") or {}
    return (props.get("class") or props.get("instance") or "").lower()


def is_keyboard(node: dict) -> bool:
    app = app_id_of(node)
    name = (node.get("name") or "").lower()
    if any(tok in app for tok in SKIP_APP):
        return True
    return any(tok in name for tok in SKIP_NAME)


def is_leaf_window(node: dict) -> bool:
    return node.get("type") in {"con", "floating_con"} and bool(node.get("pid") or node.get("app_id") or node.get("window_properties") or node.get("name"))


def is_discord(node: dict) -> bool:
    if is_keyboard(node) or not is_leaf_window(node):
        return False
    app = app_id_of(node)
    name = (node.get("name") or "").lower()
    if "emulationstation" in app or "emulationstation" in name:
        return False
    return any(tok in app for tok in DISCORD_APP) or any(tok in name for tok in DISCORD_NAME)


def find_discord(tree: dict) -> dict | None:
    for node in iter_nodes(tree):
        if is_discord(node):
            return node
    return None


def find_by_id(tree: dict, cid: int) -> dict | None:
    for node in iter_nodes(tree):
        if node.get("id") == cid:
            return node
    return None


def find_output_for_rect(tree: dict, rect: dict) -> dict | None:
    cx = int(rect.get("x", 0)) + int(rect.get("width", 0)) // 2
    cy = int(rect.get("y", 0)) + max(0, int(rect.get("height", 0))) // 2
    for node in iter_nodes(tree):
        if node.get("type") != "output":
            continue
        out_rect = node.get("rect") or {}
        ox = int(out_rect.get("x", 0))
        oy = int(out_rect.get("y", 0))
        ow = int(out_rect.get("width", 0))
        oh = int(out_rect.get("height", 0))
        if ow <= 0 or oh <= 0:
            continue
        if ox <= cx < ox + ow and oy <= cy < oy + oh:
            return node
    for node in iter_nodes(tree):
        if node.get("type") == "output" and node.get("focused"):
            return node
    for node in iter_nodes(tree):
        if node.get("type") == "output" and node.get("active"):
            return node
    return None


def kb_height() -> int:
    for key in ("BATOCERA_OSK_HEIGHT", "OSK_HEIGHT"):
        raw = os.environ.get(key, "").strip()
        if raw.isdigit():
            return max(100, int(raw))
    return DEFAULT_KB_HEIGHT


def pid_alive(path: Path) -> bool:
    try:
        pid = int(path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False
    return Path(f"/proc/{pid}").exists()


def stop_hold() -> None:
    if not HOLD_PID_PATH.exists():
        return
    try:
        pid = int(HOLD_PID_PATH.read_text(encoding="utf-8").strip())
        os.kill(pid, 15)
    except (OSError, ValueError):
        pass
    HOLD_PID_PATH.unlink(missing_ok=True)


def workspace_rect(output: dict) -> dict | None:
    for child in output.get("nodes") or []:
        if child.get("type") != "workspace":
            continue
        if str(child.get("name") or "").startswith("__"):
            continue
        rect = child.get("rect") or {}
        w = int(rect.get("width") or 0)
        h = int(rect.get("height") or 0)
        if w > 0 and h > 0:
            return {
                "x": int(rect.get("x") or 0),
                "y": int(rect.get("y") or 0),
                "width": w,
                "height": h,
            }
    return None


def usable_geom(output: dict) -> tuple[int, int, int, int]:
    out_rect = output.get("rect") or {}
    out_x = int(out_rect.get("x", 0))
    out_y = int(out_rect.get("y", 0))
    out_w = int(out_rect.get("width", 0))
    out_h = int(out_rect.get("height", 0))
    kb = kb_height()
    return out_x, out_y, out_w, max(200, out_h - kb)


def wait_usable(rect: dict, timeout: float = 0.2) -> tuple[dict, tuple[int, int, int, int]] | None:
    deadline = time.time() + timeout
    last: tuple[dict, tuple[int, int, int, int]] | None = None
    while time.time() < deadline:
        tree = get_tree()
        if not tree:
            time.sleep(0.03)
            continue
        output = find_output_for_rect(tree, rect)
        if not output:
            time.sleep(0.03)
            continue
        last = (output, usable_geom(output))
        return last
    return last


def layout_window(cid: int, x: int, y: int, w: int, h: int, *, configure: bool = True) -> None:
    # Separate commands: a chained resize with "1920px" (no space) is invalid
    # sway syntax and aborts the rest of the command.
    if configure:
        swaymsg(f"[con_id={cid}] fullscreen disable")
        swaymsg(f"[con_id={cid}] floating enable")
        swaymsg(f"[con_id={cid}] border none")
    swaymsg(f"[con_id={cid}] resize set {w} px {h} px")
    swaymsg(f"[con_id={cid}] move absolute position {x} {y}")


def resolve_target(tree: dict, state: dict | None = None) -> dict | None:
    """Discord/Vesktop only. Never ES, Lutris, browsers, or the focused fallback."""
    if state:
        cid = state.get("id")
        if cid is not None:
            node = find_by_id(tree, int(cid))
            if node and is_discord(node):
                return node
        app = (state.get("app_id") or "").lower()
        if app and any(tok in app for tok in DISCORD_APP):
            for node in iter_nodes(tree):
                if is_discord(node) and app_id_of(node) == app:
                    return node
    return find_discord(tree)


def shift_up() -> int:
    if not resolve_swaysock():
        return 0

    tree = get_tree()
    if not tree:
        return 1

    focused = resolve_target(tree)
    if not focused:
        return 0

    cid = focused.get("id")
    rect = focused.get("rect") or {}
    if cid is None or not rect:
        return 0

    waited = wait_usable(rect)
    tree = get_tree() or tree
    focused = resolve_target(tree) or focused
    cid = focused.get("id")
    rect = focused.get("rect") or rect
    if cid is None:
        return 0

    if waited:
        output, geom = waited
        # Recompute from a fresh tree so exclusive-zone height is current.
        output = find_output_for_rect(tree, rect) or output
        geom = usable_geom(output)
    else:
        output = find_output_for_rect(tree, rect)
        if not output:
            return 0
        geom = usable_geom(output)

    out_x, out_y, out_w, out_h = (
        int((output.get("rect") or {}).get("x", 0)),
        int((output.get("rect") or {}).get("y", 0)),
        int((output.get("rect") or {}).get("width", 0)),
        int((output.get("rect") or {}).get("height", 0)),
    )
    x, y, w, h = geom
    if w <= 0 or h <= 0:
        return 0

    existing: dict | None = None
    if STATE_PATH.exists():
        try:
            existing = json.loads(STATE_PATH.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            existing = None

    state = existing or {
        "id": cid,
        "app_id": focused.get("app_id") or app_id_of(focused),
        "name": focused.get("name"),
        "fullscreen_mode": int(focused.get("fullscreen_mode") or 0),
        "floating": focused.get("floating"),
        "restore_output": True,
    }
    state["id"] = cid
    state["app_id"] = focused.get("app_id") or app_id_of(focused)
    state["output"] = {"x": out_x, "y": out_y, "width": out_w, "height": out_h}
    state["shifted"] = {"x": x, "y": y, "width": w, "height": h}
    STATE_PATH.write_text(json.dumps(state), encoding="utf-8")

    layout_window(int(cid), x, y, w, h, configure=True)
    return 0


def shift_down() -> int:
    stop_hold()
    if not STATE_PATH.exists():
        return 0

    try:
        state = json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        STATE_PATH.unlink(missing_ok=True)
        return 0

    STATE_PATH.unlink(missing_ok=True)
    if not resolve_swaysock():
        return 0

    tree = get_tree()
    target = resolve_target(tree, state) if tree else None
    cid = target.get("id") if target else state.get("id")
    if cid is None:
        return 0

    out = state.get("output") or {}
    if state.get("restore_output") and int(out.get("width") or 0) > 0:
        x = int(out.get("x", 0))
        y = int(out.get("y", 0))
        w = int(out.get("width", 0))
        h = int(out.get("height", 0))
        layout_window(int(cid), x, y, w, h)
        return 0

    rect = state.get("rect") or {}
    x = int(rect.get("x", 0))
    y = int(rect.get("y", 0))
    w = int(rect.get("width", 0))
    h = int(rect.get("height", 0))
    fullscreen_mode = int(state.get("fullscreen_mode") or 0)
    was_floating = state.get("floating")

    if w > 0 and h > 0:
        layout_window(int(cid), x, y, w, h)

    if fullscreen_mode == 1:
        swaymsg(f"[con_id={cid}] fullscreen enable")
    elif fullscreen_mode > 1:
        swaymsg(f"[con_id={cid}] fullscreen enable global")
    elif was_floating in (False, "auto_off"):
        swaymsg(f"[con_id={cid}] floating disable")

    return 0


def main(argv: list[str]) -> int:
    action = (argv[1] if len(argv) > 1 else "").strip().lower()
    if action in {"up", "shift", "show"}:
        return shift_up()
    if action in {"down", "restore", "hide"}:
        return shift_down()
    print("Usage: batocera-osk-sway-shift {up|down}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))

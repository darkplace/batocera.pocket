#!/usr/bin/env python3
"""Shift the focused Sway window above the on-screen keyboard."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

STATE_PATH = Path("/var/run/batocera-osk-sway-shift.json")
DEFAULT_KB_HEIGHT = 350


def resolve_swaysock() -> str | None:
    val = os.environ.get("SWAYSOCK")
    if val and os.path.exists(val):
        return val
    for cand in ("/run/sway-ipc.0.sock", "/var/run/sway-ipc.0.sock", "/run/sway-ipc.sock"):
        if os.path.exists(cand):
            return cand
    return None


def swaymsg(*args: str) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    sock = resolve_swaysock()
    if sock:
        env["SWAYSOCK"] = sock
    return subprocess.run(
        ["swaymsg", *args],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )


def get_tree() -> dict | None:
    proc = swaymsg("-t", "get_tree")
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, dict) else None


def iter_nodes(node: dict):
    yield node
    for key in ("nodes", "floating_nodes"):
        for child in node.get(key, []):
            if isinstance(child, dict):
                yield from iter_nodes(child)


def find_focused(tree: dict) -> dict | None:
    for node in iter_nodes(tree):
        if node.get("focused") and node.get("type") in {"con", "floating_con"}:
            return node
    return None


def find_output_for_rect(tree: dict, rect: dict) -> dict | None:
    cx = int(rect.get("x", 0)) + int(rect.get("width", 0)) // 2
    cy = int(rect.get("y", 0)) + int(rect.get("height", 0)) // 2
    for node in iter_nodes(tree):
        if node.get("type") != "output":
            continue
        out_rect = node.get("rect") or {}
        ox = int(out_rect.get("x", 0))
        oy = int(out_rect.get("y", 0))
        ow = int(out_rect.get("width", 0))
        oh = int(out_rect.get("height", 0))
        if ox <= cx < ox + ow and oy <= cy < oy + oh:
            return node
    for node in iter_nodes(tree):
        if node.get("type") == "output" and node.get("focused"):
            return node
    for node in iter_nodes(tree):
        if node.get("type") == "output" and node.get("active"):
            return node
    return None


def kb_height() -> int:
    for key in ("BATOCERA_OSK_HEIGHT", "OSK_HEIGHT"):
        raw = os.environ.get(key, "").strip()
        if raw.isdigit():
            return max(100, int(raw))
    return DEFAULT_KB_HEIGHT


def shift_up() -> int:
    if not resolve_swaysock():
        return 0

    tree = get_tree()
    if not tree:
        return 1

    focused = find_focused(tree)
    if not focused:
        return 0

    cid = focused.get("id")
    rect = focused.get("rect") or {}
    if cid is None or not rect:
        return 0

    output = find_output_for_rect(tree, rect)
    if not output:
        return 0

    out_rect = output.get("rect") or {}
    out_x = int(out_rect.get("x", 0))
    out_y = int(out_rect.get("y", 0))
    out_w = int(out_rect.get("width", 0))
    out_h = int(out_rect.get("height", 0))
    if out_w <= 0 or out_h <= 0:
        return 0

    avail_h = max(200, out_h - kb_height())
    state = {
        "id": cid,
        "rect": {
            "x": int(rect.get("x", 0)),
            "y": int(rect.get("y", 0)),
            "width": int(rect.get("width", 0)),
            "height": int(rect.get("height", 0)),
        },
        "fullscreen_mode": int(focused.get("fullscreen_mode") or 0),
        "floating": focused.get("floating"),
        "app_id": focused.get("app_id"),
        "name": focused.get("name"),
    }
    STATE_PATH.write_text(json.dumps(state), encoding="utf-8")

    swaymsg(
        f"[con_id={cid}] floating enable, "
        f"move absolute position {out_x} {out_y}, "
        f"resize set {out_w}px {avail_h}px, "
        f"border none"
    )
    return 0


def shift_down() -> int:
    if not STATE_PATH.exists():
        return 0

    try:
        state = json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        STATE_PATH.unlink(missing_ok=True)
        return 0

    STATE_PATH.unlink(missing_ok=True)
    if not resolve_swaysock():
        return 0

    cid = state.get("id")
    rect = state.get("rect") or {}
    if cid is None:
        return 0

    x = int(rect.get("x", 0))
    y = int(rect.get("y", 0))
    w = int(rect.get("width", 0))
    h = int(rect.get("height", 0))
    fullscreen_mode = int(state.get("fullscreen_mode") or 0)
    was_floating = state.get("floating")

    swaymsg(f"[con_id={cid}] move absolute position {x} {y}, resize set {w}px {h}px")

    if fullscreen_mode == 1:
        swaymsg(f"[con_id={cid}] fullscreen enable")
    elif fullscreen_mode > 1:
        swaymsg(f"[con_id={cid}] fullscreen enable global")
    elif was_floating in (False, "auto_off"):
        swaymsg(f"[con_id={cid}] floating disable")

    return 0


def main(argv: list[str]) -> int:
    action = (argv[1] if len(argv) > 1 else "").strip().lower()
    if action in {"up", "shift", "show"}:
        return shift_up()
    if action in {"down", "restore", "hide"}:
        return shift_down()
    print("Usage: batocera-osk-sway-shift {up|down}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))

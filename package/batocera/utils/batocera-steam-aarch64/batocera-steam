set -euo pipefail

log="/userdata/system/logs/steam.log"
mkdir -p "$(dirname "${log}")"

GAME_ID="${1:-}"
MODE="${BATOCERA_STEAM_MODE:-}"

export HOME="/userdata/system"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${HOME}/.cache"
export STEAM_ROOT="${BATOCERA_STEAM_ROOT:-${XDG_DATA_HOME}/Steam}"
export PROTON11_ARM64_APPID="${BATOCERA_STEAM_PROTON11_ARM64_APPID:-4628740}"
export PROTON11_ARM64_DIR_NAME="Proton 11.0 (ARM64)"
export PROTON11_ARM64_INSTALL_URI="steam://install/${PROTON11_ARM64_APPID}"
export BATOCERA_STEAM_PROTON_CACHYOS_CONFIG="${BATOCERA_STEAM_PROTON_CACHYOS_CONFIG:-/userdata/system/configs/steam/proton-cachyos.conf}"
export BATOCERA_STEAM_PROTON_GE_CONFIG="${BATOCERA_STEAM_PROTON_GE_CONFIG:-/userdata/system/configs/steam/proton-ge.conf}"

load_proton_cachyos_config() {
    local key
    local value

    [[ -r "${BATOCERA_STEAM_PROTON_CACHYOS_CONFIG}" ]] || return 0

    while IFS='=' read -r key value || [[ -n "${key:-}" ]]; do
        case "${key}" in
            ''|\#*)
                continue
                ;;
        esac

        value="${value%$'\r'}"
        value="${value%\"}"
        value="${value#\"}"

        case "${key}" in
            BATOCERA_STEAM_PROTON_CACHYOS)
                case "${value}" in
                    0|1|true|false|TRUE|FALSE|True|False|yes|no|YES|NO|Yes|No|on|off|ON|OFF|On|Off)
                        export BATOCERA_STEAM_PROTON_CACHYOS="${value}"
                        ;;
                esac
                ;;
            BATOCERA_STEAM_PROTON_CACHYOS_VERSION)
                if [[ "${value}" =~ ^[A-Za-z0-9._-]+$ ]]; then
                    export BATOCERA_STEAM_PROTON_CACHYOS_VERSION="${value}"
                fi
                ;;
            BATOCERA_STEAM_PROTON_CACHYOS_URL)
                if [[ "${value}" =~ ^https://github\.com/CachyOS/proton-cachyos/releases/download/[A-Za-z0-9._-]+/proton-cachyos-[A-Za-z0-9._-]+-arm64\.tar\.xz$ ]]; then
                    export BATOCERA_STEAM_PROTON_CACHYOS_URL="${value}"
                fi
                ;;
        esac
    done < "${BATOCERA_STEAM_PROTON_CACHYOS_CONFIG}"
}

load_proton_ge_config() {
    local key
    local value

    [[ -r "${BATOCERA_STEAM_PROTON_GE_CONFIG}" ]] || return 0

    while IFS='=' read -r key value || [[ -n "${key:-}" ]]; do
        case "${key}" in
            ''|\#*)
                continue
                ;;
        esac

        value="${value%$'\r'}"
        value="${value%\"}"
        value="${value#\"}"

        case "${key}" in
            BATOCERA_STEAM_PROTON_GE)
                case "${value}" in
                    0|1|true|false|TRUE|FALSE|True|False|yes|no|YES|NO|Yes|No|on|off|ON|OFF|On|Off)
                        export BATOCERA_STEAM_PROTON_GE="${value}"
                        ;;
                esac
                ;;
            BATOCERA_STEAM_PROTON_GE_VERSION)
                if [[ "${value}" =~ ^GE-Proton[A-Za-z0-9._-]+$ ]]; then
                    export BATOCERA_STEAM_PROTON_GE_VERSION="${value}"
                fi
                ;;
            BATOCERA_STEAM_PROTON_GE_URL)
                if [[ "${value}" =~ ^https://github\.com/GloriousEggroll/proton-ge-custom/releases/download/[A-Za-z0-9._-]+/GE-Proton[A-Za-z0-9._-]+\.tar\.gz$ ]]; then
                    export BATOCERA_STEAM_PROTON_GE_URL="${value}"
                fi
                ;;
        esac
    done < "${BATOCERA_STEAM_PROTON_GE_CONFIG}"
}

load_proton_cachyos_config
load_proton_ge_config

export PROTON_CACHYOS_VERSION_FULL="${BATOCERA_STEAM_PROTON_CACHYOS_VERSION:-11.0-20260602-slr}"
export PROTON_CACHYOS_TAR="proton-cachyos-${PROTON_CACHYOS_VERSION_FULL}-arm64.tar.xz"
export PROTON_CACHYOS_DIR="proton-cachyos-${PROTON_CACHYOS_VERSION_FULL}-arm64"
export PROTON_CACHYOS_URL="${BATOCERA_STEAM_PROTON_CACHYOS_URL:-https://github.com/CachyOS/proton-cachyos/releases/download/cachyos-${PROTON_CACHYOS_VERSION_FULL}/${PROTON_CACHYOS_TAR}}"
export PROTON_GE_VERSION_FULL="${BATOCERA_STEAM_PROTON_GE_VERSION:-}"
export PROTON_GE_TAR="${PROTON_GE_VERSION_FULL:+${PROTON_GE_VERSION_FULL}.tar.gz}"
export PROTON_GE_DIR="${PROTON_GE_VERSION_FULL}"
export PROTON_GE_URL="${BATOCERA_STEAM_PROTON_GE_URL:-}"
export BATOCERA_STEAM_FEX_ROOTFS_NAME="${BATOCERA_STEAM_FEX_ROOTFS_NAME:-Fedora_43.sqsh}"
export BATOCERA_STEAM_FEX_ROOTFS_URL="${BATOCERA_STEAM_FEX_ROOTFS_URL:-https://rootfs.fex-emu.gg/Fedora_43/2026-01-20/Fedora_43.sqsh}"
export PROTON_USE_ARM64="${PROTON_USE_ARM64:-1}"

declare -a DISABLED_BINFMT=()
declare -a REGISTERED_BINFMT=()
declare -a ENABLED_BINFMT=()
PROTON11_TOOLMANIFEST_WATCHER_PID=""
STEAM_GPU_PROFILE_STATE=""
STEAM_LAUNCH_OFFLINE=0

log_msg() {
    printf '%s\n' "$*" >> "${log}"
}

apply_steam_launch_environment() {
    case "${BATOCERA_STEAM_UNSET_MESA_LOADER_DRIVER_OVERRIDE:-0}" in
        1|true|TRUE|True|yes|YES|Yes|on|ON|On)
            unset MESA_LOADER_DRIVER_OVERRIDE
            log_msg "Unset MESA_LOADER_DRIVER_OVERRIDE for Steam launch."
            ;;
    esac

    if [[ "${PROTON_LOG:-0}" == "1" ]]; then
        export PROTON_LOG_DIR="${PROTON_LOG_DIR:-/userdata/system/logs}"
        mkdir -p "${PROTON_LOG_DIR}" 2>/dev/null || true
        log_msg "Proton logging enabled at ${PROTON_LOG_DIR}."
    fi
}

proton_cachyos_enabled() {
    case "${BATOCERA_STEAM_PROTON_CACHYOS:-}" in
        0|false|FALSE|False|no|NO|No|off|OFF|Off)
            return 1
            ;;
        1|true|TRUE|True|yes|YES|Yes|on|ON|On)
            return 0
            ;;
    esac

    proton_ge_enabled && return 1
    return 0
}

proton_ge_enabled() {
    local archive

    case "${BATOCERA_STEAM_PROTON_GE:-0}" in
        0|false|FALSE|False|no|NO|No|off|OFF|Off)
            return 1
            ;;
    esac

    [[ -n "${PROTON_GE_VERSION_FULL}" && -n "${PROTON_GE_URL}" ]] || return 1

    archive="${PROTON_GE_URL%%\?*}"
    archive="${archive%%\#*}"
    archive="${archive##*/}"
    [[ "${archive}" == "${PROTON_GE_TAR}" ]]
}

proton_cachyos_any_payload_exists() {
    local proton_dir

    for proton_dir in "${STEAM_ROOT}/compatibilitytools.d"/proton-cachyos-*-arm64; do
        [[ -x "${proton_dir}/proton" ]] && return 0
    done

    return 1
}

proton_ge_any_payload_exists() {
    local proton_dir

    for proton_dir in "${STEAM_ROOT}/compatibilitytools.d"/GE-Proton*; do
        [[ -x "${proton_dir}/proton" ]] && return 0
    done

    return 1
}

proton11_arm64_payload_exists() {
    if proton_cachyos_enabled && [[ -x "${STEAM_ROOT}/compatibilitytools.d/${PROTON_CACHYOS_DIR}/proton" ]]; then
        return 0
    fi

    if proton_cachyos_enabled && proton_cachyos_any_payload_exists; then
        return 0
    fi

    if proton_ge_enabled && [[ -x "${STEAM_ROOT}/compatibilitytools.d/${PROTON_GE_DIR}/proton" ]]; then
        return 0
    fi

    if proton_ge_enabled && proton_ge_any_payload_exists; then
        return 0
    fi

    [[ -x "${STEAM_ROOT}/steamapps/common/${PROTON11_ARM64_DIR_NAME}/proton" ]]
}

apply_sm8550_gpu_profile() {
    case "$(cat /usr/share/batocera/batocera.arch 2>/dev/null || true)" in
        sm8550|sm8750) ;;
        *) return 0 ;;
    esac
    command -v batocera-gpu-profile >/dev/null 2>&1 || return 0

    STEAM_GPU_PROFILE_STATE="/var/run/batocera-gpu-profile/steam.$$"
    batocera-gpu-profile highperformance "${STEAM_GPU_PROFILE_STATE}" >> "${log}" 2>&1 || true
    log_msg "sm8x50 GPU profile pinned for Steam launcher"
}

restore_sm8550_gpu_profile() {
    [[ -n "${STEAM_GPU_PROFILE_STATE}" ]] || return 0
    command -v batocera-gpu-profile >/dev/null 2>&1 || return 0

    batocera-gpu-profile restore "${STEAM_GPU_PROFILE_STATE}" >> "${log}" 2>&1 || true
    STEAM_GPU_PROFILE_STATE=""
    log_msg "sm8x50 GPU profile restored after Steam launcher"
}

steam_session_leftover_pids() {
    local proc
    local pid
    local ppid
    local cmd
    local comm

    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        [[ "${pid}" != "$$" && "${pid}" != "${BASHPID:-$$}" ]] || continue

        ppid="$(awk '/^PPid:/ { print $2 }' "${proc}/status" 2>/dev/null || true)"
        [[ "${ppid}" == "1" ]] || continue

        cmd="$(tr '\0' ' ' 2>/dev/null < "${proc}/cmdline" || true)"
        comm="$(cat "${proc}/comm" 2>/dev/null || true)"
        case "${cmd} ${comm}" in
            *"/userdata/system/homebrew/plugin"*|*"Decky Terminal"*|*"Animation Changer"*|*"Game Theme Music"*|*"ProtonDB Badges"*|*"FEXServer"*|*"squashfuse "*".FEXMount"*)
                printf '%s\n' "${pid}"
                ;;
        esac
    done
}

kill_steam_session_leftovers() {
    local signal="$1"
    local pid

    while IFS= read -r pid; do
        [[ -n "${pid}" ]] || continue
        kill "-${signal}" "${pid}" >/dev/null 2>&1 || true
    done < <(steam_session_leftover_pids | sort -u)
}

cleanup_steam_session_leftovers() {
    local mount

    [[ "${BATOCERA_STEAM_CLEAN_SESSION_LEFTOVERS:-1}" != "0" ]] || return 0

    kill_steam_session_leftovers TERM
    sleep 0.2
    kill_steam_session_leftovers KILL

    for mount in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/.FEXMount* /run/user/*/.FEXMount*; do
        [[ -e "${mount}" ]] || continue
        fusermount3 -uz "${mount}" >/dev/null 2>&1 || \
            fusermount -uz "${mount}" >/dev/null 2>&1 || \
            umount -l "${mount}" >/dev/null 2>&1 || true
    done
}

flash_msg() {
    local seconds="$1"
    local message="$2"
    local size="${3:-22}"

    [[ "${BATOCERA_STEAM_NO_FLASH:-0}" == "0" ]] || return 0
    if command -v batocera-flash-screen >/dev/null 2>&1; then
        /usr/bin/batocera-flash-screen "${seconds}" "#ffffff" "${message}" "${size}" >/dev/null 2>&1 || true
    fi
}

die() {
    log_msg "ERROR: $*"
    echo "$*" >&2
    flash_msg 8 "$*" 22
    exit 1
}

has_network() {
    if command -v ip >/dev/null 2>&1; then
        ip route get 1.1.1.1 >/dev/null 2>&1
        return $?
    fi

    if command -v ping >/dev/null 2>&1; then
        timeout 2 ping -c 1 -W 1 1.1.1.1 >/dev/null 2>&1
        return $?
    fi

    return 0
}

activate_wifi_for_steam() {
    local i

    if has_network; then
        return 0
    fi

    log_msg "Steam setup needs network; trying to enable Wi-Fi."
    flash_msg 5 "Steam setup needs Wi-Fi. Enabling Wi-Fi..." 21

    if command -v connmanctl >/dev/null 2>&1; then
        connmanctl enable wifi >> "${log}" 2>&1 || true
        connmanctl scan wifi >> "${log}" 2>&1 || true
    fi

    for i in $(seq 1 "${BATOCERA_STEAM_WIFI_WAIT_SECS:-30}"); do
        if has_network; then
            log_msg "Network became available for Steam setup."
            return 0
        fi
        sleep 1
    done

    log_msg "Network is still unavailable after Wi-Fi enable attempt."
    return 1
}

gamescope_install_flashes_enabled() {
    [[ "${BATOCERA_STEAM_NO_FLASH:-0}" == "0" ]] || return 1
    [[ "${MODE}" == "steamos" || "${BATOCERA_STEAM_USE_GAMESCOPE:-0}" == "1" ]] || return 1
    command -v batocera-flash-screen >/dev/null 2>&1
}

file_size_mb() {
    local file="$1"
    local bytes

    bytes="$(wc -c < "${file}" 2>/dev/null || echo 0)"
    [[ "${bytes}" =~ ^[0-9]+$ ]] || bytes=0
    printf '%s\n' $((bytes / 1048576))
}

flash_download_progress() {
    local tmp="$1"
    local label="$2"
    local last_mb=0
    local current_mb=0
    local step_mb=100
    local rounded_mb=0
    local flash_enabled=0

    if gamescope_install_flashes_enabled; then
        flash_enabled=1
    fi

    while true; do
        if [[ -e "${tmp}" ]]; then
            current_mb="$(file_size_mb "${tmp}")"
            if (( current_mb >= 1024 )); then
                step_mb=500
            else
                step_mb=100
            fi
            rounded_mb=$(((current_mb / step_mb) * step_mb))

            if (( rounded_mb > 0 && rounded_mb > last_mb )); then
                last_mb="${rounded_mb}"
                log_msg "${label}: ${last_mb} MB downloaded"
                if [[ "${flash_enabled}" == "1" ]]; then
                    flash_msg 3 "${label}: ${last_mb} MB downloaded" 20
                fi
            fi
        fi

        sleep 3
    done
}

fetch_url_stdout() {
    local url="$1"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "${url}"
        return
    fi

    if command -v wget >/dev/null 2>&1; then
        wget -qO- "${url}"
        return
    fi

    return 1
}

download_file() {
    local url="$1"
    local target="$2"
    local label="${3:-Steam setup}"
    local tmp="${target}.part"
    local progress_pid=""

    start_progress() {
        if gamescope_install_flashes_enabled; then
            flash_download_progress "${tmp}" "${label}" &
            progress_pid="$!"
        fi
    }

    stop_progress() {
        if [[ -n "${progress_pid}" ]]; then
            kill "${progress_pid}" 2>/dev/null || true
            wait "${progress_pid}" 2>/dev/null || true
            progress_pid=""
        fi
    }

    if command -v curl >/dev/null 2>&1; then
        start_progress
        if curl -fL -C - --retry 10 --retry-delay 3 --connect-timeout 20 \
            --speed-limit "${BATOCERA_STEAM_DOWNLOAD_MIN_BPS:-1024}" \
            --speed-time "${BATOCERA_STEAM_DOWNLOAD_STALL_SECS:-60}" \
            -o "${tmp}" "${url}" >> "${log}" 2>&1 || {
                log_msg "${label}: resume failed, retrying from scratch"
                rm -f "${tmp}"
                curl -fL --retry 10 --retry-delay 3 --connect-timeout 20 \
                    --speed-limit "${BATOCERA_STEAM_DOWNLOAD_MIN_BPS:-1024}" \
                    --speed-time "${BATOCERA_STEAM_DOWNLOAD_STALL_SECS:-60}" \
                    -o "${tmp}" "${url}" >> "${log}" 2>&1
            }; then
            stop_progress
            mv -f "${tmp}" "${target}"
            log_msg "${label}: download complete"
            if gamescope_install_flashes_enabled; then
                flash_msg 3 "${label}: download complete" 20
            fi
            return 0
        fi
        stop_progress
    fi

    if command -v wget >/dev/null 2>&1; then
        start_progress
        if wget -c -t 10 --timeout=20 --read-timeout="${BATOCERA_STEAM_DOWNLOAD_STALL_SECS:-60}" -O "${tmp}" "${url}" >> "${log}" 2>&1; then
            stop_progress
            mv -f "${tmp}" "${target}"
            log_msg "${label}: download complete"
            if gamescope_install_flashes_enabled; then
                flash_msg 3 "${label}: download complete" 20
            fi
            return 0
        fi
        stop_progress
    fi

    rm -f "${tmp}"
    return 1
}

if [[ -z "${MODE}" ]]; then
    MODE="$(batocera-settings-get steam.session.mode 2>/dev/null || true)"
fi
if [[ -z "${MODE}" ]]; then
    MODE="gamepadui"
fi

case "${MODE}" in
    steamos|gamescope|gamemode)
        MODE="steamos"
        ;;
esac

ensure_runtime_dir() {
    local uid candidate

    if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "${XDG_RUNTIME_DIR}" ]]; then
        return
    fi

    uid="$(id -u)"
    candidate="/run/user/${uid}"
    if mkdir -p "${candidate}" 2>/dev/null; then
        chmod 700 "${candidate}" 2>/dev/null || true
        export XDG_RUNTIME_DIR="${candidate}"
        return
    fi

    candidate="/tmp/runtime-${uid}"
    mkdir -p "${candidate}"
    chmod 700 "${candidate}" 2>/dev/null || true
    export XDG_RUNTIME_DIR="${candidate}"
}

ensure_system_bus_address() {
    if [[ -n "${DBUS_SYSTEM_BUS_ADDRESS:-}" ]]; then
        return
    fi

    if [[ -S /run/dbus/system_bus_socket ]]; then
        export DBUS_SYSTEM_BUS_ADDRESS="unix:path=/run/dbus/system_bus_socket"
        return
    fi

    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        export DBUS_SYSTEM_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS}"
    fi
}

frontend_env_value() {
    local pid="$1"
    local key="$2"

    [[ -r "/proc/${pid}/environ" ]] || return 1
    tr '\0' '\n' < "/proc/${pid}/environ" | sed -n "s/^${key}=//p" | head -n 1
}

capture_frontend_env() {
    local pid
    local -a candidates=()

    FRONTEND_DISPLAY=""
    FRONTEND_WAYLAND_DISPLAY=""
    FRONTEND_XDG_RUNTIME_DIR=""
    FRONTEND_SWAYSOCK=""
    FRONTEND_XDG_CURRENT_DESKTOP=""
    FRONTEND_XDG_SESSION_TYPE=""
    FRONTEND_XDG_SESSION_DESKTOP=""
    FRONTEND_DBUS_SESSION_BUS_ADDRESS=""
    FRONTEND_DBUS_SYSTEM_BUS_ADDRESS=""
    FRONTEND_WLR_XWAYLAND_NO_AUTH=""

    while IFS= read -r pid; do
        [[ -n "${pid}" ]] && candidates+=("${pid}")
    done < <(
        {
            pgrep -o -x sway
            pgrep -o -x labwc
            pgrep -o -f '(^|/)emulationstation([[:space:]]|$)'
            pgrep -o -f '(^|/)emulationstation-standalone([[:space:]]|$)'
        } 2>/dev/null | awk 'NF && !seen[$0]++'
    )

    for pid in "${candidates[@]}"; do
        [[ -r "/proc/${pid}/environ" ]] || continue
        FRONTEND_DISPLAY="$(frontend_env_value "${pid}" DISPLAY || true)"
        FRONTEND_WAYLAND_DISPLAY="$(frontend_env_value "${pid}" WAYLAND_DISPLAY || true)"
        FRONTEND_XDG_RUNTIME_DIR="$(frontend_env_value "${pid}" XDG_RUNTIME_DIR || true)"
        FRONTEND_SWAYSOCK="$(frontend_env_value "${pid}" SWAYSOCK || true)"
        FRONTEND_XDG_CURRENT_DESKTOP="$(frontend_env_value "${pid}" XDG_CURRENT_DESKTOP || true)"
        FRONTEND_XDG_SESSION_TYPE="$(frontend_env_value "${pid}" XDG_SESSION_TYPE || true)"
        FRONTEND_XDG_SESSION_DESKTOP="$(frontend_env_value "${pid}" XDG_SESSION_DESKTOP || true)"
        FRONTEND_DBUS_SESSION_BUS_ADDRESS="$(frontend_env_value "${pid}" DBUS_SESSION_BUS_ADDRESS || true)"
        FRONTEND_DBUS_SYSTEM_BUS_ADDRESS="$(frontend_env_value "${pid}" DBUS_SYSTEM_BUS_ADDRESS || true)"
        FRONTEND_WLR_XWAYLAND_NO_AUTH="$(frontend_env_value "${pid}" WLR_XWAYLAND_NO_AUTH || true)"
        return 0
    done

    return 1
}

ensure_frontend_session_env() {
    local display=""
    local sway_sock=""

    capture_frontend_env || true

    unset GAMESCOPE_WAYLAND_DISPLAY
    unset GAMESCOPE_DISPLAY
    unset GAMESCOPE_SESSION
    unset WAYLAND_DISPLAY

    if [[ -S /tmp/.X11-unix/X0 ]]; then
        display=":0"
    elif [[ -n "${FRONTEND_DISPLAY:-}" ]]; then
        display="${FRONTEND_DISPLAY}"
    elif command -v getLocalXDisplay >/dev/null 2>&1; then
        display="$(getLocalXDisplay 2>/dev/null || true)"
    fi
    export DISPLAY="${display:-${DISPLAY:-:0}}"

    sway_sock="${FRONTEND_SWAYSOCK:-}"
    if [[ -z "${sway_sock}" && -n "${XDG_RUNTIME_DIR:-}" && -S "${XDG_RUNTIME_DIR}/sway-ipc.0.sock" ]]; then
        sway_sock="${XDG_RUNTIME_DIR}/sway-ipc.0.sock"
    elif [[ -z "${sway_sock}" && -S /var/run/sway-ipc.0.sock ]]; then
        sway_sock="/var/run/sway-ipc.0.sock"
    fi
    if [[ -n "${sway_sock}" ]]; then
        export SWAYSOCK="${sway_sock}"
    else
        unset SWAYSOCK
    fi

    if [[ -f /var/lib/.Xauthority ]]; then
        export XAUTHORITY="/var/lib/.Xauthority"
    fi
    export WLR_XWAYLAND_NO_AUTH="${FRONTEND_WLR_XWAYLAND_NO_AUTH:-1}"
    export XDG_SESSION_TYPE="x11"
    export XDG_CURRENT_DESKTOP="${FRONTEND_XDG_CURRENT_DESKTOP:-sway}"
    export XDG_SESSION_DESKTOP="${FRONTEND_XDG_SESSION_DESKTOP:-${XDG_CURRENT_DESKTOP}}"
    export DBUS_SESSION_BUS_ADDRESS="${FRONTEND_DBUS_SESSION_BUS_ADDRESS:-${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/dbus/system_bus_socket}}"
    export DBUS_SYSTEM_BUS_ADDRESS="${FRONTEND_DBUS_SYSTEM_BUS_ADDRESS:-${DBUS_SYSTEM_BUS_ADDRESS:-unix:path=/run/dbus/system_bus_socket}}"
    case "${XDG_RUNTIME_DIR:-}" in
        /run|/var/run)
            unset XDG_RUNTIME_DIR
            ;;
    esac
    ensure_runtime_dir
    export GDK_BACKEND="x11"
    export SDL_VIDEODRIVER="x11"

    log_msg "Steam frontend env (${MODE}): DISPLAY=${DISPLAY}, WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset}, SWAYSOCK=${SWAYSOCK:-unset}, XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset}, DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}"
}

start_stub() {
    local stub="$1"
    local pattern="$2"

    if [[ ! -x "${stub}" ]]; then
        return
    fi

    if pgrep -f "${pattern}" >/dev/null 2>&1; then
        return
    fi

    nohup "${stub}" >> "${log}" 2>&1 &
    sleep 0.2
}

start_compat_shims() {
    ensure_system_bus_address
    start_stub "/usr/bin/batocera-networkmanager-stub" '(^|/)batocera-networkmanager-stub([[:space:]]|$)'
    start_stub "/usr/bin/batocera-login1-stub" '(^|/)batocera-login1-stub([[:space:]]|$)'
    start_stub "/usr/bin/batocera-consolekit-stub" '(^|/)batocera-consolekit-stub([[:space:]]|$)'
    start_stub "/usr/bin/batocera-displaymanager-stub" '(^|/)batocera-displaymanager-stub([[:space:]]|$)'
}

normalize_game_target() {
    local game="$1"

    if [[ -z "${game}" ]]; then
        return
    fi

    if [[ "${game}" =~ ^steam://rungameid/[0-9]+$ ]]; then
        printf '%s' "${game}"
        return
    fi

    if [[ "${game}" =~ ^[0-9]+$ ]]; then
        printf '%s' "${game}"
        return
    fi

    printf '%s' "${game}"
}

steam_gamepadui_enabled() {
    case "${BATOCERA_STEAM_GAMEPADUI:-1}" in
        0|false|FALSE|False|no|NO|No|off|OFF|Off)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

steam_client_library_path() {
    local path="${STEAM_ROOT}/lib/aarch64-linux-gnu:${STEAM_ROOT}/steamrtarm64"

    if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
        path="${path}:${LD_LIBRARY_PATH}"
    fi

    printf '%s\n' "${path}"
}

steam_client_dependencies_ready() {
    local steamui="${STEAM_ROOT}/steamrtarm64/steamui.so"
    local missing
    local lib

    [[ -f "${steamui}" ]] || return 1

    if command -v ldd >/dev/null 2>&1; then
        missing="$(LD_LIBRARY_PATH="$(steam_client_library_path)" ldd "${steamui}" 2>/dev/null | grep 'not found' || true)"
        if [[ -n "${missing}" ]]; then
            log_msg "Steam client runtime dependencies are incomplete:"
            while IFS= read -r lib; do
                [[ -n "${lib}" ]] && log_msg "  ${lib}"
            done <<< "${missing}"
            return 1
        fi
        return 0
    fi

    for lib in \
        libavcodec.so.62 \
        libavfilter.so.11 \
        libavformat.so.62 \
        libavutil.so.60 \
        libswresample.so.6 \
        libswscale.so.9
    do
        [[ -e "${STEAM_ROOT}/steamrtarm64/${lib}" || -e "${STEAM_ROOT}/lib/aarch64-linux-gnu/${lib}" ]] || return 1
    done
}

steam_startup_args_enabled() {
    local startup_args="${BATOCERA_STEAM_STARTUP_ARGS:-auto}"

    case "${startup_args}" in
        0|false|FALSE|False|no|NO|No|off|OFF|Off)
            return 1
            ;;
        1|true|TRUE|True|yes|YES|Yes|on|ON|On)
            ;;
        *)
            log_msg "Steam client bootstrap/update is enabled; not appending startup bypass args."
            return 1
            ;;
    esac

    if ! steam_client_dependencies_ready; then
        log_msg "Steam client packages are incomplete; allowing bootstrap/update before launch."
        return 1
    fi

    return 0
}

append_steam_startup_args() {
    local -n args="$1"

    if ! steam_startup_args_enabled; then
        return
    fi

    args+=(
        -noverifyfiles
        -nobootstrapupdate
        -skipinitialbootstrap
        -norepairfiles
    )
}

build_steam_args() {
    local -n out_args="$1"
    local game_target="$2"
    local -a extra_args=()

    out_args=()

    if steam_gamepadui_enabled; then
        if [[ "${MODE}" == "steamos" ]]; then
            out_args+=(-steamdeck -steamos3 -gamepadui)
        else
            out_args+=("${BATOCERA_STEAM_GAMEPADUI_ARG:-${BATOCERA_STEAM_BIGPICTURE_ARG:--gamepadui}}")
        fi
        export STEAM_GAMEPADUI=1
        export STEAM_FORCE_DESKTOPUI=0
    else
        out_args+=(-nofriendsui)
        export STEAM_GAMEPADUI=0
        export STEAM_FORCE_DESKTOPUI=1
    fi

    append_steam_startup_args out_args

    if [[ "${STEAM_LAUNCH_OFFLINE:-0}" == "1" ]]; then
        out_args+=(-offline)
    fi

    if [[ -n "${BATOCERA_STEAM_EXTRA_ARGS:-}" ]]; then
        read -r -a extra_args <<< "${BATOCERA_STEAM_EXTRA_ARGS}"
        out_args+=("${extra_args[@]}")
    fi

    if ! proton11_arm64_payload_exists; then
        if proton_cachyos_enabled; then
            log_msg "Proton-CachyOS ${PROTON_CACHYOS_VERSION_FULL} payload is missing; setup should install it before launch."
        else
            log_msg "Proton 11.0 (ARM64) payload missing; requesting Steam install for AppID ${PROTON11_ARM64_APPID}."
            out_args+=("${PROTON11_ARM64_INSTALL_URI}")
            if [[ -n "${game_target}" ]]; then
                log_msg "Deferring requested game '${game_target}' until Proton 11.0 (ARM64) is installed."
                return 0
            fi
        fi
    fi

    if [[ -n "${game_target}" ]]; then
        if [[ "${game_target}" =~ ^[0-9]+$ ]]; then
            out_args+=(-applaunch "${game_target}")
        else
            out_args+=("${game_target}")
        fi
    fi
}

ensure_steam_links() {
    mkdir -p "${STEAM_ROOT}" "${HOME}/.steam"

    if [[ -L "${HOME}/.steam/steam" || ! -e "${HOME}/.steam/steam" ]]; then
        ln -sfn "${STEAM_ROOT}" "${HOME}/.steam/steam"
    fi

    if [[ -L "${HOME}/.steam/root" || ! -e "${HOME}/.steam/root" ]]; then
        ln -sfn "${STEAM_ROOT}" "${HOME}/.steam/root"
    fi

    if [[ -d "${STEAM_ROOT}/linuxarm64" ]]; then
        ln -sfn "${STEAM_ROOT}/linuxarm64" "${HOME}/.steam/sdkarm64"
    fi
}

sync_steam_library_folders() {
    local -a candidates=()
    local mount_point
    local source
    local boot_source
    local userdata_source
    local size_kb
    local library_path

    candidates+=("/userdata/roms/steam")
    boot_source="$(findmnt -n -o SOURCE /boot 2>/dev/null || true)"
    userdata_source="$(findmnt -n -o SOURCE /userdata 2>/dev/null || true)"

    while IFS= read -r mount_point; do
        [[ -d "${mount_point}" ]] || continue
        source="$(findmnt -n -o SOURCE --target "${mount_point}" 2>/dev/null || true)"
        [[ -n "${source}" ]] || continue
        [[ -n "${boot_source}" && "${source}" == "${boot_source}" ]] && continue
        [[ -n "${userdata_source}" && "${source}" == "${userdata_source}" ]] && continue

        size_kb="$(df -Pk "${mount_point}" 2>/dev/null | awk 'NR == 2 { print $2 }')"
        [[ "${size_kb}" =~ ^[0-9]+$ ]] || size_kb=0
        [[ "${size_kb}" -ge "${BATOCERA_STEAM_EXTERNAL_LIBRARY_MIN_KB:-8388608}" ]] || continue

        library_path="${mount_point%/}/SteamLibrary"
        mkdir -p "${library_path}/steamapps" 2>/dev/null || continue
        [[ -w "${library_path}/steamapps" ]] || continue
        candidates+=("${library_path}")
    done < <(awk '$2 ~ /^\/media\/[^/]+$/ { print $2 }' /proc/mounts | sort -u)

    mkdir -p "${STEAM_ROOT}/config" "${STEAM_ROOT}/steamapps" "/userdata/roms/steam/steamapps"

    command -v python3 >/dev/null 2>&1 || return 0
    python3 - "${STEAM_ROOT}/config/libraryfolders.vdf" "${STEAM_ROOT}/steamapps/libraryfolders.vdf" "${candidates[@]}" <<'PY' >> "${log}" 2>&1 || true
from __future__ import annotations

import hashlib
import sys
from pathlib import Path


def q(value: object) -> str:
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def tokenize(text: str) -> list[str]:
    tokens: list[str] = []
    index = 0
    while index < len(text):
        char = text[index]
        if char.isspace():
            index += 1
            continue
        if char == "/" and index + 1 < len(text) and text[index + 1] == "/":
            while index < len(text) and text[index] != "\n":
                index += 1
            continue
        if char in "{}":
            tokens.append(char)
            index += 1
            continue
        if char == '"':
            index += 1
            buf: list[str] = []
            while index < len(text):
                current = text[index]
                if current == "\\" and index + 1 < len(text):
                    buf.append(text[index + 1])
                    index += 2
                    continue
                if current == '"':
                    index += 1
                    break
                buf.append(current)
                index += 1
            tokens.append("".join(buf))
            continue

        start = index
        while index < len(text) and not text[index].isspace() and text[index] not in "{}":
            index += 1
        tokens.append(text[start:index])
    return tokens


def parse_object(tokens: list[str], index: int = 0) -> tuple[dict[str, object], int]:
    data: dict[str, object] = {}
    while index < len(tokens):
        token = tokens[index]
        if token == "}":
            return data, index + 1
        key = token
        index += 1
        if index >= len(tokens):
            data[key] = ""
            break
        token = tokens[index]
        if token == "{":
            value, index = parse_object(tokens, index + 1)
            data[key] = value
        else:
            data[key] = token
            index += 1
    return data, index


def load_vdf(path: Path) -> dict[str, object]:
    if not path.exists():
        return {}
    try:
        data, _ = parse_object(tokenize(path.read_text(encoding="utf-8", errors="ignore")))
        return data
    except Exception:
        return {}


def dump_object(node: dict[str, object], indent: str = "") -> list[str]:
    lines: list[str] = []
    for key, value in node.items():
        if isinstance(value, dict):
            lines.append(f"{indent}{q(key)}")
            lines.append(f"{indent}" + "{")
            lines.extend(dump_object(value, indent + "\t"))
            lines.append(f"{indent}" + "}")
        else:
            lines.append(f"{indent}{q(key)}\t\t{q(value)}")
    return lines


def content_id(path: str) -> str:
    return str(int(hashlib.sha1(path.encode("utf-8")).hexdigest()[:15], 16))


def make_entry(path: str, label: str) -> dict[str, object]:
    return {
        "path": path,
        "label": label,
        "contentid": content_id(path),
        "totalsize": "0",
        "update_clean_bytes_tally": "0",
        "time_last_update_verified": "0",
        "apps": {},
    }


config_path = Path(sys.argv[1])
legacy_path = Path(sys.argv[2])
candidates = []
for raw in sys.argv[3:]:
    path = str(Path(raw))
    if path not in candidates and Path(path, "steamapps").is_dir():
        candidates.append(path)

data = load_vdf(config_path)
libraryfolders = data.get("libraryfolders")
if not isinstance(libraryfolders, dict):
    libraryfolders = {}
    data = {"libraryfolders": libraryfolders}

existing_paths: set[str] = set()
max_index = -1
for key, value in libraryfolders.items():
    if key.isdigit():
        max_index = max(max_index, int(key))
    if isinstance(value, dict) and isinstance(value.get("path"), str):
        existing_paths.add(str(Path(value["path"])))

if candidates and candidates[0] not in existing_paths and "0" not in libraryfolders:
    libraryfolders["0"] = make_entry(candidates[0], "")
    existing_paths.add(candidates[0])
    max_index = max(max_index, 0)

for candidate in candidates:
    if candidate in existing_paths:
        continue
    max_index += 1
    label = "Batocera External" if candidate.startswith("/media/") else ""
    libraryfolders[str(max_index)] = make_entry(candidate, label)
    existing_paths.add(candidate)

text = "\n".join(dump_object(data)) + "\n"
for path in (config_path, legacy_path):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")

print("Synced Steam libraries: " + ", ".join(candidates))
PY
}


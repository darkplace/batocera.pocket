    printf '%s\n' "publicbeta" > "${STEAM_ROOT}/package/beta"
    : > "${STEAM_ROOT}/.steam-enable-steamrt64-client"
    ensure_steam_taskset_shim

    if [[ -d "${STEAM_ROOT}/linuxarm64" ]]; then
        ln -sfn "${STEAM_ROOT}/linuxarm64" "${HOME}/.steam/sdkarm64"
    fi

    for helper in \
        steam \
        steamwebhelper \
        steamwebhelper.sh \
        gldriverquery \
        vulkandriverquery \
        steamsysinfo
    do
        [[ -e "${STEAM_ROOT}/steamrtarm64/${helper}" ]] || continue
        chmod +x "${STEAM_ROOT}/steamrtarm64/${helper}" 2>/dev/null || true
    done
}


link_arm64_runtime_libs() {
    local runtime_lib_dir
    local ibus_lib
    local gtk2_lib
    local gdk2_lib
    local libnm_lib

    runtime_lib_dir="$(find "${STEAM_ROOT}/steam-runtime-steamrt-arm64" -path '*/files/lib/aarch64-linux-gnu' -type d 2>/dev/null | head -n 1 || true)"
    [[ -n "${runtime_lib_dir}" ]] || return 0

    ibus_lib="$(find "${runtime_lib_dir}" -maxdepth 1 -name 'libibus-1.0.so.5.*' -type f 2>/dev/null | head -n 1 || true)"
    if [[ -n "${ibus_lib}" ]]; then
        mkdir -p "${STEAM_ROOT}/lib/aarch64-linux-gnu"
        ln -sfn "${ibus_lib}" "${STEAM_ROOT}/lib/aarch64-linux-gnu/libibus-1.0.so.5"
    fi

    gtk2_lib="$(find "${runtime_lib_dir}" -maxdepth 1 -name 'libgtk-x11-2.0.so.0.*' -type f 2>/dev/null | head -n 1 || true)"
    if [[ -n "${gtk2_lib}" ]]; then
        mkdir -p "${STEAM_ROOT}/lib/aarch64-linux-gnu"
        ln -sfn "${gtk2_lib}" "${STEAM_ROOT}/lib/aarch64-linux-gnu/libgtk-x11-2.0.so.0"
    fi

    gdk2_lib="$(find "${runtime_lib_dir}" -maxdepth 1 -name 'libgdk-x11-2.0.so.0.*' -type f 2>/dev/null | head -n 1 || true)"
    if [[ -n "${gdk2_lib}" ]]; then
        mkdir -p "${STEAM_ROOT}/lib/aarch64-linux-gnu"
        ln -sfn "${gdk2_lib}" "${STEAM_ROOT}/lib/aarch64-linux-gnu/libgdk-x11-2.0.so.0"
    fi

    libnm_lib="$(find "${runtime_lib_dir}" -maxdepth 1 -name 'libnm.so.0.*' -type f 2>/dev/null | head -n 1 || true)"
    if [[ -n "${libnm_lib}" ]]; then
        mkdir -p "${STEAM_ROOT}/lib/aarch64-linux-gnu"
        ln -sfn "${libnm_lib}" "${STEAM_ROOT}/lib/aarch64-linux-gnu/libnm.so.0"
    fi
}

ensure_steam_taskset_shim() {
    local shim_dir="${STEAM_ROOT}/batocera-bin"
    local shim="${shim_dir}/taskset"

    mkdir -p "${shim_dir}"
    cat > "${shim}" <<'EOF'
#!/bin/sh
# Minimal taskset shim for images without util-linux taskset.

if [ "$#" -lt 2 ]; then
    echo "usage: taskset mask command [args...]" >&2
    exit 1
fi

case "$1" in
    -p|--pid)
        echo "taskset shim: pid mode is not supported" >&2
        exit 1
        ;;
    -c|--cpu-list|-a|--all-tasks)
        shift
        ;;
esac

shift
exec "$@"
EOF
    chmod +x "${shim}" 2>/dev/null || true
    case ":${PATH}:" in
        *":${shim_dir}:"*) ;;
        *) export PATH="${shim_dir}:${PATH}" ;;
    esac
}

ensure_arm64_steam_runtime() {
    local archive="${STEAM_ROOT}/steam-runtime-steamrt-arm64.tar.xz"
    local url="https://repo.steampowered.com/steamrt3c/images/latest-public-beta/steam-runtime-steamrt-arm64.tar.xz"

    if [[ -d "${STEAM_ROOT}/steam-runtime-steamrt-arm64" ]]; then
        link_arm64_runtime_libs
        return
    fi

    command -v tar >/dev/null 2>&1 || die "tar is required to install the ARM64 Steam runtime."
    log_msg "Downloading ARM64 Steam runtime from ${url}"
    download_file "${url}" "${archive}" "Steam runtime" || die "Failed to download ARM64 Steam runtime."
    tar -xf "${archive}" -C "${STEAM_ROOT}" >> "${log}" 2>&1 || die "Failed to extract ARM64 Steam runtime."
    rm -f "${archive}"
    link_arm64_runtime_libs
}

ensure_native_steam_client() {
    local manifest
    local target_file
    local archive="${STEAM_ROOT}/linuxarm64.zip"
    local manifest_url="https://client-update.fastly.steamstatic.com/steam_client_publicbeta_linuxarm64"

    ensure_arm64_steam_runtime

    if [[ -x "${STEAM_ROOT}/steamrtarm64/steam" ]] && steam_client_dependencies_ready; then
        return
    fi

    if [[ -x "${STEAM_ROOT}/steamrtarm64/steam" ]]; then
        log_msg "ARM64 Steam client install is incomplete; reinstalling client."
    fi

    command -v unzip >/dev/null 2>&1 || die "unzip is required to install the ARM64 Steam client."
    command -v strings >/dev/null 2>&1 || die "strings is required to parse the ARM64 Steam client manifest."

    log_msg "Downloading ARM64 Steam client manifest from ${manifest_url}"
    if ! manifest="$(fetch_url_stdout "${manifest_url}" | strings)"; then
        die "Failed to download ARM64 Steam client manifest."
    fi

    target_file="$(printf '%s\n' "${manifest}" | grep -Eo 'bins_linuxarm64_linuxarm64\.zip\.[^"[:space:]]+' | grep -v '\.vz\.' | head -n 1 || true)"
    [[ -n "${target_file}" ]] || die "Could not find ARM64 Steam client archive in manifest."

    log_msg "Downloading ARM64 Steam client ${target_file}"
    download_file "https://client-update.steamstatic.com/${target_file}" "${archive}" "Steam client" || die "Failed to download ARM64 Steam client."
    unzip -o "${archive}" -d "${STEAM_ROOT}" >> "${log}" 2>&1 || die "Failed to extract ARM64 Steam client."
    rm -f "${archive}"
    chmod +x "${STEAM_ROOT}/steamrtarm64/steam" 2>/dev/null || true

    [[ -x "${STEAM_ROOT}/steamrtarm64/steam" ]] || die "ARM64 Steam client did not install to ${STEAM_ROOT}/steamrtarm64/steam."
}

install_proton_cachyos() {
    local dest_dir="${STEAM_ROOT}/compatibilitytools.d"
    local tar_path="${dest_dir}/${PROTON_CACHYOS_TAR}"
    local extracted_dir="${dest_dir}/${PROTON_CACHYOS_DIR}"

    proton_cachyos_enabled || return 0

    command -v tar >/dev/null 2>&1 || die "tar is required to install Proton-CachyOS."
    mkdir -p "${dest_dir}"

    if [[ -x "${extracted_dir}/proton" ]]; then
        repair_proton_cachyos_dir "${extracted_dir}"
        log_msg "Proton-CachyOS ${PROTON_CACHYOS_VERSION_FULL} already installed."
        return 0
    fi

    if [[ -d "${extracted_dir}" ]]; then
        log_msg "Removing incomplete Proton-CachyOS install: ${PROTON_CACHYOS_DIR}"
        rm -rf "${extracted_dir}"
    fi

    log_msg "Downloading Proton-CachyOS ${PROTON_CACHYOS_VERSION_FULL} from ${PROTON_CACHYOS_URL}"
    download_file "${PROTON_CACHYOS_URL}" "${tar_path}" "Proton-CachyOS ${PROTON_CACHYOS_VERSION_FULL}" || die "Failed to download Proton-CachyOS ${PROTON_CACHYOS_VERSION_FULL}."
    tar -xf "${tar_path}" -C "${dest_dir}" >> "${log}" 2>&1 || die "Failed to extract Proton-CachyOS ${PROTON_CACHYOS_VERSION_FULL}."
    rm -f "${tar_path}"

    [[ -x "${extracted_dir}/proton" ]] || die "Proton-CachyOS did not install to ${extracted_dir}/proton."
    repair_proton_cachyos_dir "${extracted_dir}"
    log_msg "Installed Proton-CachyOS ${PROTON_CACHYOS_VERSION_FULL}."
}


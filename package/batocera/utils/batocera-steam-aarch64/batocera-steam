repair_proton_cachyos_dir() {
    local proton_dir="$1"
    local version
    local manifest

    [[ -d "${proton_dir}" ]] || return 1

    if [[ ! -e "${proton_dir}/files" && -d "${proton_dir}/share/default_pfx_arm64" ]]; then
        ln -s . "${proton_dir}/files" 2>/dev/null || true
    fi

    version="$(proton_cachyos_version_from_dir "${proton_dir}")"
    manifest="${proton_dir}/toolmanifest.vdf"

    if [[ -f "${manifest}" ]]; then
        sed -i '/require_tool_appid/d' "${manifest}" 2>/dev/null || true
    fi

    if [[ ! -f "${manifest}" ]] || ! grep -q '"commandline" "/proton %verb%"' "${manifest}" 2>/dev/null; then
        write_proton_cachyos_toolmanifest_vdf "${manifest}"
    fi
    chmod 0644 "${manifest}" 2>/dev/null || true

    write_proton_cachyos_compatibilitytool_vdf "${proton_dir}" "${version}"
    chmod +x "${proton_dir}/proton" 2>/dev/null || true
}

repair_proton_ge_dir() {
    local proton_dir="$1"
    local version
    local manifest

    [[ -d "${proton_dir}" ]] || return 1

    version="$(proton_ge_version_from_dir "${proton_dir}")"
    manifest="${proton_dir}/toolmanifest.vdf"

    if [[ -f "${manifest}" ]]; then
        sed -i '/require_tool_appid/d' "${manifest}" 2>/dev/null || true
    fi

    if [[ ! -f "${manifest}" ]] || ! grep -q '"commandline" "/proton %verb%"' "${manifest}" 2>/dev/null; then
        write_proton_ge_toolmanifest_vdf "${manifest}"
    fi
    chmod 0644 "${manifest}" 2>/dev/null || true

    write_proton_ge_compatibilitytool_vdf "${proton_dir}" "${version}"
    chmod +x "${proton_dir}/proton" 2>/dev/null || true
}

register_proton_cachyos_versions() {
    local proton_dir
    local version
    local registered=0

    for proton_dir in "${STEAM_ROOT}/compatibilitytools.d"/proton-cachyos-*-arm64; do
        [[ -d "${proton_dir}" ]] || continue

        version="$(proton_cachyos_version_from_dir "${proton_dir}")"
        if [[ -x "${proton_dir}/proton" ]]; then
            repair_proton_cachyos_dir "${proton_dir}" || true
            registered=$((registered + 1))
            log_msg "Registered Proton-CachyOS ${version} as a Steam compatibility tool."
        else
            log_msg "Ignoring incomplete Proton-CachyOS ${version}: missing executable proton script."
        fi
    done

    if (( registered > 1 )); then
        log_msg "Registered ${registered} Proton-CachyOS ARM64 compatibility-tool variants."
    fi
}

register_proton_ge_versions() {
    local proton_dir
    local version
    local registered=0

    for proton_dir in "${STEAM_ROOT}/compatibilitytools.d"/GE-Proton*; do
        [[ -d "${proton_dir}" ]] || continue

        version="$(proton_ge_version_from_dir "${proton_dir}")"
        if [[ -x "${proton_dir}/proton" ]]; then
            repair_proton_ge_dir "${proton_dir}" || true
            registered=$((registered + 1))
            log_msg "Registered ${version} as a Steam compatibility tool."
        else
            log_msg "Ignoring incomplete ${version}: missing executable proton script."
        fi
    done

    if (( registered > 1 )); then
        log_msg "Registered ${registered} GE-Proton compatibility-tool variants."
    fi
}

register_proton11_arm64() {
    local proton_dir="${STEAM_ROOT}/steamapps/common/${PROTON11_ARM64_DIR_NAME}"
    local compat_dir="${STEAM_ROOT}/compatibilitytools.d"

    mkdir -p "${proton_dir}" "${compat_dir}"
    ln -sfn "${proton_dir}" "${compat_dir}/Proton11ARM"
    write_compatibilitytool_vdf "${compat_dir}/compatibilitytool.vdf"
    write_toolmanifest_vdf "${proton_dir}/toolmanifest.vdf"
    register_proton_cachyos_versions
    register_proton_ge_versions

    if proton_cachyos_enabled && [[ -x "${STEAM_ROOT}/compatibilitytools.d/${PROTON_CACHYOS_DIR}/proton" ]]; then
        log_msg "Selected Proton-CachyOS ${PROTON_CACHYOS_VERSION_FULL} is available."
    elif proton_ge_enabled && [[ -x "${STEAM_ROOT}/compatibilitytools.d/${PROTON_GE_DIR}/proton" ]]; then
        log_msg "Selected GE-Proton ${PROTON_GE_VERSION_FULL} is available."
    elif [[ -e "${proton_dir}/proton" ]]; then
        chmod +x "${proton_dir}/proton" 2>/dev/null || true
        log_msg "Registered installed Proton 11.0 (ARM64) as compatibility tool proton11_arm64."
    else
        log_msg "Prepared Proton 11.0 (ARM64) compatibility-tool registration; Proton payload is not installed yet."
    fi
}

proton11_toolmanifest_needs_repair() {
    local manifest="$1"

    [[ -f "${manifest}" ]] || return 0
    grep -q '"require_tool_appid"' "${manifest}" 2>/dev/null && return 0
    grep -q '"commandline" "/proton %verb%"' "${manifest}" 2>/dev/null || return 0
    return 1
}

repair_proton11_toolmanifest() {
    local proton_dir="${STEAM_ROOT}/steamapps/common/${PROTON11_ARM64_DIR_NAME}"
    local manifest="${proton_dir}/toolmanifest.vdf"

    mkdir -p "${proton_dir}"
    if proton11_toolmanifest_needs_repair "${manifest}"; then
        write_toolmanifest_vdf "${manifest}"
        chmod 0644 "${manifest}" 2>/dev/null || true
        log_msg "Rewrote Proton 11.0 (ARM64) toolmanifest without Steam Linux Runtime dependency."
    fi
}

start_proton11_toolmanifest_watcher() {
    local watch_seconds="${BATOCERA_STEAM_PROTON11_WATCH_SECONDS:-1800}"

    [[ "${watch_seconds}" =~ ^[0-9]+$ ]] || watch_seconds=1800
    (
        local end_time=$((SECONDS + watch_seconds))
        local proton_dir="${STEAM_ROOT}/steamapps/common/${PROTON11_ARM64_DIR_NAME}"
        local manifest="${proton_dir}/toolmanifest.vdf"

        while (( SECONDS < end_time )); do
            if [[ -d "${proton_dir}" ]] && proton11_toolmanifest_needs_repair "${manifest}"; then
                repair_proton11_toolmanifest
            fi
            sleep 2
        done
    ) >> "${log}" 2>&1 &
    PROTON11_TOOLMANIFEST_WATCHER_PID="$!"
}

apply_steam_user_selection() {
    local selection="${1:-auto}"

    case "${selection}" in
        ""|auto|AUTO|Auto)
            return 0
            ;;
    esac

    if [[ ! -x /usr/bin/batocera-steam-users ]]; then
        log_msg "Steam user selection requested but batocera-steam-users is missing."
        return 0
    fi

    BATOCERA_STEAM_HOME="${STEAM_ROOT}" /usr/bin/batocera-steam-users apply "${selection}" >> "${log}" 2>&1 || \
        log_msg "Steam user selection apply failed for '${selection}'."
}

disable_host_binfmt() {
    local name entry

    for name in x86_64 x86 FEX-x86_64 FEX-x86 box64 box32; do
        entry="/proc/sys/fs/binfmt_misc/${name}"
        [[ -f "${entry}" && -w "${entry}" ]] || continue
        if grep -q '^enabled' "${entry}" 2>/dev/null && echo 0 > "${entry}" 2>/dev/null; then
            DISABLED_BINFMT+=("${entry}")
            log_msg "Disabled host binfmt handler ${name} for native ARM64 Steam launch."
        fi
    done
}

enable_fex_binfmt() {
    local name conf entry

    for name in FEX-x86_64 FEX-x86; do
        conf="/usr/lib/binfmt.d/${name}.conf"
        entry="/proc/sys/fs/binfmt_misc/${name}"

        [[ -f "${conf}" ]] || die "Missing ${conf}; FEX binfmt cannot be registered for Steam."
        if [[ -f "${entry}" ]]; then
            if grep -q '^disabled' "${entry}" 2>/dev/null; then
                echo 1 > "${entry}" 2>/dev/null || die "Failed to enable ${name} binfmt handler."
                ENABLED_BINFMT+=("${entry}")
            fi
            continue
        fi

        cat "${conf}" > /proc/sys/fs/binfmt_misc/register 2>/dev/null || die "Failed to register ${name} binfmt handler."
        REGISTERED_BINFMT+=("${entry}")
        log_msg "Registered ${name} binfmt handler for Steam Proton/FEX."
    done
}

ensure_binfmt_misc() {
    if [[ ! -d /proc/sys/fs/binfmt_misc || ! -f /proc/sys/fs/binfmt_misc/register ]]; then
        mount binfmt_misc -t binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null || true
    fi

    [[ -f /proc/sys/fs/binfmt_misc/register ]] || die "binfmt_misc is not available."
    if [[ "$(cat /proc/sys/fs/binfmt_misc/status 2>/dev/null || true)" = "disabled" ]]; then
        echo 1 > /proc/sys/fs/binfmt_misc/status 2>/dev/null || true
    fi
}

fex_rootfs_configured() {
    local fex_config="${HOME}/.config/fex-emu/Config.json"
    local rootfs_dir="${HOME}/.local/share/fex-emu/RootFS"
    local rootfs_name

    [[ -f "${fex_config}" ]] || return 1
    rootfs_name="$(sed -n 's/.*"RootFS"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${fex_config}" | head -n 1)"
    [[ -n "${rootfs_name}" ]] || return 1
    [[ "${rootfs_name}" != *.ero ]] || return 1
    [[ -e "${rootfs_dir}/${rootfs_name}" ]]
}

steam_setup_state() {
    if [[ ! -x "${STEAM_ROOT}/steamrtarm64/steam" ]] || ! steam_client_dependencies_ready; then
        printf 'client\n'
        return 0
    fi

    if ! fex_rootfs_configured; then
        printf 'support\n'
        return 0
    fi

    if proton_cachyos_enabled && [[ ! -x "${STEAM_ROOT}/compatibilitytools.d/${PROTON_CACHYOS_DIR}/proton" ]] && ! proton_cachyos_any_payload_exists; then
        printf 'support\n'
        return 0
    fi

    if proton_ge_enabled && [[ ! -x "${STEAM_ROOT}/compatibilitytools.d/${PROTON_GE_DIR}/proton" ]] && ! proton_ge_any_payload_exists; then
        printf 'support\n'
        return 0
    fi

    if ! proton11_arm64_payload_exists; then
        printf 'support\n'
        return 0
    fi

    printf 'none\n'
}

steam_setup_incomplete_without_network() {
    local setup_state="$1"

    log_msg "ARM64 Steam bootstrap is incomplete (${setup_state}) and no network is available."
    flash_msg 8 "ARM Steam setup is incomplete." 22
    flash_msg 8 "Connect to the internet and launch Steam again." 18
    die "ARM Steam bootstrap is incomplete. Connect to the internet and launch Steam again."
}

ensure_network_for_steam_setup() {
    local setup_state

    setup_state="$(steam_setup_state)"
    if [[ "${setup_state}" == "none" ]]; then
        return 0
    fi

    if ! has_network; then
        steam_setup_incomplete_without_network "${setup_state}"
    fi

    log_msg "Steam/Proton/FEX setup is incomplete; preparing setup."
    export BATOCERA_STEAM_SETUP_PENDING=1
    export BATOCERA_STEAM_SETUP_KIND="${setup_state}"
    if [[ "${setup_state}" == "client" ]]; then
        export BATOCERA_STEAM_FIRST_RUN=1
    fi

    if [[ "${setup_state}" == "client" ]]; then
        flash_msg 6 "Steam first launch setup is starting." 21
        flash_msg "${BATOCERA_STEAM_FIRST_RUN_WAIT_SECS:-12}" "Steam downloads can take several minutes." 18
    else
        flash_msg 6 "Steam support setup is starting." 22
        flash_msg "${BATOCERA_STEAM_FIRST_RUN_WAIT_SECS:-12}" "Proton/FEX setup may take several minutes." 18
    fi
    if [[ "${MODE}" == "steamos" || "${BATOCERA_STEAM_USE_GAMESCOPE:-0}" == "1" ]]; then
        flash_msg 7 "Gamescope will start after setup completes." 19
    else
        flash_msg 7 "After setup completes, you may need to relaunch Steam." 19
    fi
    if proton_cachyos_enabled; then
        flash_msg 9 "Select Proton-CachyOS as the Steam compatibility runner." 16
    elif proton_ge_enabled; then
        flash_msg 9 "Select GE-Proton as the Steam compatibility runner." 16
    else
        flash_msg 9 "Select Proton 11.0 (ARM64) as the Steam compatibility runner." 16
    fi

    log_msg "Network is available for Steam setup."
}

prepare_steam_network_mode() {
    STEAM_LAUNCH_OFFLINE=0
    export BATOCERA_STEAM_LAUNCH_OFFLINE=0

    if has_network; then
        log_msg "Network is available for Steam launch."
        return 0
    fi

    STEAM_LAUNCH_OFFLINE=1
    export BATOCERA_STEAM_LAUNCH_OFFLINE=1
    log_msg "Network is unavailable; launching Steam in offline mode."
    flash_msg 5 "No network. Launching Steam offline." 20
}

ensure_fex_rootfs() {
    local rootfs_dir="${HOME}/.local/share/fex-emu/RootFS"
    local fex_config="${HOME}/.config/fex-emu/Config.json"
    local target="${rootfs_dir}/${BATOCERA_STEAM_FEX_ROOTFS_NAME}"

    command -v FEX >/dev/null 2>&1 || die "FEX is required for Proton 11.0 (ARM64)."
    command -v squashfuse >/dev/null 2>&1 || die "squashfuse is required for the Steam FEX rootfs."

    if fex_rootfs_configured; then
        return
    fi

    mkdir -p "${rootfs_dir}" "$(dirname "${fex_config}")"
    if [[ ! -f "${target}" ]]; then
        log_msg "Downloading FEX rootfs ${BATOCERA_STEAM_FEX_ROOTFS_NAME} from ${BATOCERA_STEAM_FEX_ROOTFS_URL}"
        download_file "${BATOCERA_STEAM_FEX_ROOTFS_URL}" "${target}" "FEX rootfs" || die "Failed to download FEX rootfs."
    fi

    cat > "${fex_config}" <<EOF
{"Config":{"RootFS":"${BATOCERA_STEAM_FEX_ROOTFS_NAME}","DynamicL1Cache":"1","DisableL2Cache":"1"},"ThunksDB":{}}
EOF
    chmod 0644 "${fex_config}" 2>/dev/null || true
    log_msg "Configured FEX rootfs ${BATOCERA_STEAM_FEX_ROOTFS_NAME}."
}

prepare_steam_binfmt() {
    ensure_binfmt_misc
    disable_host_binfmt
    enable_fex_binfmt
}

restore_host_binfmt() {
    local entry

    for entry in "${REGISTERED_BINFMT[@]}"; do
        [[ -f "${entry}" && -w "${entry}" ]] || continue
        echo -1 > "${entry}" 2>/dev/null || true
    done
    REGISTERED_BINFMT=()

    for entry in "${ENABLED_BINFMT[@]}"; do
        [[ -f "${entry}" && -w "${entry}" ]] || continue
        echo 0 > "${entry}" 2>/dev/null || true
    done
    ENABLED_BINFMT=()

    for entry in "${DISABLED_BINFMT[@]}"; do
        [[ -f "${entry}" && -w "${entry}" ]] || continue
        echo 1 > "${entry}" 2>/dev/null || true
    done
    DISABLED_BINFMT=()
}

cleanup() {
    batocera-mouse hide >/dev/null 2>&1 || true
    if [[ -n "${PROTON11_TOOLMANIFEST_WATCHER_PID:-}" ]]; then
        kill "${PROTON11_TOOLMANIFEST_WATCHER_PID}" >/dev/null 2>&1 || true
        wait "${PROTON11_TOOLMANIFEST_WATCHER_PID}" >/dev/null 2>&1 || true
        PROTON11_TOOLMANIFEST_WATCHER_PID=""
    fi
    restore_host_binfmt
    cleanup_steam_session_leftovers
    restore_sm8550_gpu_profile
}

steam_update_exit_detected() {
    local before_line="$1"
    local bootstrap_log="${STEAM_ROOT}/logs/bootstrap_log.txt"
    local new_log

    [[ -f "${bootstrap_log}" ]] || return 1
    new_log="$(sed -n "$((before_line + 1)),\$p" "${bootstrap_log}" 2>/dev/null || true)"
    printf '%s\n' "${new_log}" | grep -Eq 'Update complete, launching( Steam)?'
}

launch_native_steam() {
    local -a steam_args=()
    local game_target
    local attempt
    local bootstrap_lines
    local status
    local max_attempts=3

    game_target="$(normalize_game_target "${GAME_ID}")"
    build_steam_args steam_args "${game_target}"

    export LD_LIBRARY_PATH="$(steam_client_library_path)"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_ROOT}"

    for attempt in $(seq 1 "${max_attempts}"); do
        bootstrap_lines=0
        if [[ -f "${STEAM_ROOT}/logs/bootstrap_log.txt" ]]; then
            bootstrap_lines="$(wc -l < "${STEAM_ROOT}/logs/bootstrap_log.txt" 2>/dev/null || echo 0)"
        fi

        log_msg "Launching native ARM64 Steam in ${MODE} mode (attempt ${attempt}/${max_attempts}): ${STEAM_ROOT}/steamrtarm64/steam ${steam_args[*]:-}"
        ensure_frontend_session_env
        batocera-mouse show
        set +e
        (cd "${STEAM_ROOT}" && "${STEAM_ROOT}/steamrtarm64/steam" "${steam_args[@]}")
        status=$?
        set -e

        if [[ "${attempt}" -lt "${max_attempts}" ]] && steam_update_exit_detected "${bootstrap_lines}"; then
            log_msg "Steam exited after applying an update; relaunching client."
            sleep 2
            continue
        fi

        return "${status}"
    done
}

launch_steam_deck_session() {
    local -a steam_args=()
    local game_target
    local steam_bin="${STEAM_ROOT}/steamrtarm64/steam"
    local attempt
    local bootstrap_lines
    local status
    local max_attempts=3

    game_target="$(normalize_game_target "${GAME_ID}")"
    build_steam_args steam_args "${game_target}"

    export LD_LIBRARY_PATH="$(steam_client_library_path)"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_ROOT}"
    export BATOCERA_STEAM_USE_GAMESCOPE="1"
    export BATOCERA_STEAM_GAMEPADUI="${BATOCERA_STEAM_GAMEPADUI:-1}"
    export BATOCERA_STEAM_GS_MANGOAPP="${BATOCERA_STEAM_GS_MANGOAPP:-0}"
    export BATOCERA_STEAM_GS_MANGOAPP_LEVEL="${BATOCERA_STEAM_GS_MANGOAPP_LEVEL:-0}"

    for attempt in $(seq 1 "${max_attempts}"); do
        bootstrap_lines=0
        if [[ -f "${STEAM_ROOT}/logs/bootstrap_log.txt" ]]; then
            bootstrap_lines="$(wc -l < "${STEAM_ROOT}/logs/bootstrap_log.txt" 2>/dev/null || echo 0)"
        fi

        log_msg "Launching native ARM64 SteamDeck session via gamescope (attempt ${attempt}/${max_attempts}): ${steam_bin} ${steam_args[*]:-}"
        set +e
        BATOCERA_STEAM_FIRST_RUN="${BATOCERA_STEAM_FIRST_RUN:-0}" /usr/bin/batocera-steam-session "${steam_bin}" "${steam_args[@]}"
        status=$?
        set -e

        if [[ "${attempt}" -lt "${max_attempts}" ]] && steam_update_exit_detected "${bootstrap_lines}"; then
            log_msg "SteamDeck session exited after applying an update; relaunching client."
            sleep 2
            continue
        fi

        return "${status}"
    done
}

steam_deck_session_enabled() {
    [[ "${MODE}" == "steamos" ]] || return 1

    case "${BATOCERA_STEAM_USE_GAMESCOPE:-1}" in
        0|false|FALSE|False|no|NO|No|off|OFF|Off)
            return 1
            ;;
    esac

    return 0
}


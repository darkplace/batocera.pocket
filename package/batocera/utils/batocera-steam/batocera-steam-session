#!/bin/bash
# SPDX-FileCopyrightText: Added/modified by suckbluefrog
set -euo pipefail

log="/userdata/system/logs/steam.log"
mkdir -p "$(dirname "$log")"
if [[ -f "${log}" ]]; then
    log_size="$(wc -c < "${log}" 2>/dev/null || echo 0)"
    if [[ "${log_size}" =~ ^[0-9]+$ ]] && (( log_size > 5242880 )); then
        mv -f "${log}" "${log}.1"
    fi
fi

if [[ $# -lt 1 ]]; then
    echo "Usage: $0 <steam command> [args...]" >&2
    exit 1
fi

export STEAM_DECK=1
export STEAMOS=1
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=gamescope
export HOME="/userdata/system"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${HOME}/.cache"
STEAM_FIRST_RUN_WIFI_STAMP="/userdata/system/.steam-first-run-wifi-pending"
STEAM_FIRST_RUN_PENDING=0
STEAM_SETUP_KIND="${BATOCERA_STEAM_SETUP_KIND:-}"
STEAM_INSTALL_CALLOUT_PID=""
THOR_BRIGHTNESS_WATCH_PID=""
STEAM_SESSION_DBUS_PID=""
DECKY_STARTER_PID=""
STEAM_NIGHTMODE_WATCH_PID=""
BATOCERA_NIGHTMODE_SUSPENDED=0
STEAM_PORTAL_PIDS=()
STEAM_CHILD_LSFG_ENV=()
ALLY_HOTKEY_DIR="/userdata/system/configs/hotkeygen"
ALLY_ACTIVE_MAP="${ALLY_HOTKEY_DIR}/ASUS_ROG_Ally_Config-b05-1abe.mapping"
ALLY_ES_MAP="${ALLY_HOTKEY_DIR}/ASUS_ROG_Ally_Config-b05-1abe.mapping.es"
ALLY_STEAM_MAP="${ALLY_HOTKEY_DIR}/ASUS_ROG_Ally_Config-b05-1abe.mapping.steam"
ALLY_SYSTEM_DIR="/usr/share/hotkeygen/allyhotkeys.d"
ALLY_SYSTEM_DEFAULT_MAP="${ALLY_SYSTEM_DIR}/ASUS_ROG_Ally_Config-b05-1abe.mapping"
ALLY_SYSTEM_ES_MAP="${ALLY_SYSTEM_DIR}/ASUS_ROG_Ally_Config-b05-1abe.mapping.es"
ALLY_SYSTEM_STEAM_MAP="${ALLY_SYSTEM_DIR}/ASUS_ROG_Ally_Config-b05-1abe.mapping.steam"
ALLY_DATAINIT_DIR="/usr/share/batocera/datainit/system/configs/hotkeygen"
HOTKEY_PROFILE_SYSTEM_DIR="/usr/share/hotkeygen"

run_ally_hotkey_hook() {
    local event="$1"
    local helper=""
    local helper_found=0

    apply_ally_hotkey_map_for_event "${event}" || true

    for helper in \
        "/userdata/system/scripts/50-ally-steam-hotkeys.sh" \
        "/usr/share/batocera/datainit/system/scripts/50-ally-steam-hotkeys.sh" \
        "/usr/share/batocera/configgen/scripts/50-ally-steam-hotkeys.sh"
    do
        if [[ -f "${helper}" ]]; then
            /bin/sh "${helper}" "${event}" "steam" "steam" "steam" "" >> "${log}" 2>&1 || true
            helper_found=1
        fi
    done

    [[ "${helper_found}" -eq 1 ]]
}

hotkeygen_permanent_running() {
    pgrep -f '(^|[[:space:]])(/usr/bin/)?hotkeygen([[:space:]].*)?--permanent([[:space:]]|$)' >/dev/null 2>&1
}

ensure_hotkeygen_started() {
    if command -v hotkeygen >/dev/null 2>&1; then
        if ! hotkeygen_permanent_running && [ -x /etc/init.d/S90hotkeygen ]; then
            /etc/init.d/S90hotkeygen start >/dev/null 2>&1 || true
        fi
    fi
}

start_session_supervisor() {
    command -v batocera-steam-session-supervisor >/dev/null 2>&1 || return 0
    batocera-steam-session-supervisor start "batocera-steam-session" >/dev/null 2>&1 || true
}

apply_hotkey_profile_maps() {
    local profile="$1"
    local src=""
    local base=""
    local target=""
    local applied=0
    local -a sources=()

    mkdir -p "${ALLY_HOTKEY_DIR}" 2>/dev/null || true
    shopt -s nullglob
    sources=(
        "${ALLY_HOTKEY_DIR}"/*.mapping."${profile}"
        "${HOTKEY_PROFILE_SYSTEM_DIR}"/*.mapping."${profile}"
        "${ALLY_DATAINIT_DIR}"/*.mapping."${profile}"
    )
    shopt -u nullglob

    for src in "${sources[@]}"; do
        [[ -f "${src}" ]] || continue
        case "$(basename "${src}")" in
            ASUS_ROG_Ally_*)
                continue
                ;;
        esac
        base="$(basename "${src}")"
        base="${base%.${profile}}"
        target="${ALLY_HOTKEY_DIR}/${base}"
        if [[ "${profile}" == "steam" && -f "${target}" && ! -f "${target}.es" ]]; then
            cp -f "${target}" "${target}.es" 2>/dev/null || true
        fi
        cp -f "${src}" "${target}" 2>/dev/null || continue
        applied=1
        echo "Steam hotkeys: applied ${profile} profile from ${src}" >> "${log}"
    done

    if [[ "${applied}" == "1" ]]; then
        ensure_hotkeygen_started
        /usr/bin/hotkeygen --reload >/dev/null 2>&1 || true
        return 0
    fi

    return 1
}

apply_ally_hotkey_map() {
    local profile="$1"
    local src=""

    if apply_hotkey_profile_maps "${profile}"; then
        return 0
    fi

    mkdir -p "${ALLY_HOTKEY_DIR}" 2>/dev/null || true

    case "${profile}" in
        steam)
            for src in \
                "${ALLY_STEAM_MAP}" \
                "${ALLY_SYSTEM_STEAM_MAP}" \
                "${ALLY_DATAINIT_DIR}/ASUS_ROG_Ally_Config-b05-1abe.mapping.steam"
            do
                if [[ -f "${src}" ]]; then
                    cp -f "${src}" "${ALLY_ACTIVE_MAP}" 2>/dev/null || true
                    ensure_hotkeygen_started
                    /usr/bin/hotkeygen --reload >/dev/null 2>&1 || true
                    echo "Steam hotkeys: applied steam profile from ${src}" >> "${log}"
                    return 0
                fi
            done
            ;;
        es)
            for src in \
                "${ALLY_ES_MAP}" \
                "${ALLY_SYSTEM_ES_MAP}" \
                "${ALLY_SYSTEM_DEFAULT_MAP}" \
                "${ALLY_DATAINIT_DIR}/ASUS_ROG_Ally_Config-b05-1abe.mapping.es" \
                "${ALLY_DATAINIT_DIR}/ASUS_ROG_Ally_Config-b05-1abe.mapping"
            do
                if [[ -f "${src}" ]]; then
                    cp -f "${src}" "${ALLY_ACTIVE_MAP}" 2>/dev/null || true
                    ensure_hotkeygen_started
                    /usr/bin/hotkeygen --reload >/dev/null 2>&1 || true
                    echo "Steam hotkeys: applied ES profile from ${src}" >> "${log}"
                    return 0
                fi
            done
            ;;
    esac

    echo "Steam hotkeys: missing profile '${profile}' mapping" >> "${log}"
    return 1
}

apply_ally_hotkey_map_for_event() {
    local event="$1"

    case "${event}" in
        gameStart)
            apply_ally_hotkey_map steam
            ;;
        gameStop)
            apply_ally_hotkey_map es
            ;;
        *)
            return 0
            ;;
    esac
}

recover_hotkeys() {
    if command -v hotkeygen >/dev/null 2>&1; then
        if ! hotkeygen_permanent_running && [ -x /etc/init.d/S90hotkeygen ]; then
            /etc/init.d/S90hotkeygen start >/dev/null 2>&1 || true
        fi
        /usr/bin/hotkeygen --reload >/dev/null 2>&1 || true
    fi
}

flash_msg() {
    local seconds="$1"
    local message="$2"
    local size="${3:-20}"

    if command -v batocera-flash-screen >/dev/null 2>&1; then
        /usr/bin/batocera-flash-screen "${seconds}" "#ffffff" "${message}" "${size}" >/dev/null 2>&1 || true
    fi
}

start_steam_install_callouts() {
    if [[ "${STEAM_FIRST_RUN_PENDING}" != "1" || "${BATOCERA_STEAM_INSTALL_CALLOUTS:-1}" == "0" ]]; then
        return
    fi

    (
        sleep "${BATOCERA_STEAM_INSTALL_CALLOUT_FIRST_SECS:-45}"
        while true; do
            if [[ "${STEAM_SETUP_KIND}" == "client" ]]; then
                flash_msg 5 "Steam setup is still running..." 20
            else
                flash_msg 5 "Steam support setup is still running..." 19
            fi
            sleep "${BATOCERA_STEAM_INSTALL_CALLOUT_SECS:-120}"
            flash_msg 6 "Do not power off. You may need to relaunch Steam when complete." 18
            sleep "${BATOCERA_STEAM_INSTALL_CALLOUT_SECS:-120}"
        done
    ) &
    STEAM_INSTALL_CALLOUT_PID="$!"
}

stop_steam_install_callouts() {
    if [[ -n "${STEAM_INSTALL_CALLOUT_PID}" ]]; then
        kill "${STEAM_INSTALL_CALLOUT_PID}" 2>/dev/null || true
        wait "${STEAM_INSTALL_CALLOUT_PID}" 2>/dev/null || true
        STEAM_INSTALL_CALLOUT_PID=""
    fi
}

is_ayn_thor() {
    local model=""

    if [[ -x /usr/bin/batocera-model ]]; then
        model="$(/usr/bin/batocera-model 2>/dev/null || true)"
    elif command -v batocera-model >/dev/null 2>&1; then
        model="$(batocera-model 2>/dev/null || true)"
    fi

    [[ "${model}" == "AYN_Thor" ]]
}

list_backlight_dirs() {
    local backlight

    for backlight in /sys/class/backlight/*; do
        [[ -d "${backlight}" ]] || continue
        [[ -r "${backlight}/brightness" && -w "${backlight}/brightness" && -r "${backlight}/max_brightness" ]] || continue
        printf '%s\n' "${backlight}"
    done | sort
}

backlight_percent() {
    local backlight="$1"
    local current max percent

    current="$(cat "${backlight}/brightness" 2>/dev/null || printf '0')"
    max="$(cat "${backlight}/max_brightness" 2>/dev/null || printf '0')"
    [[ "${current}" =~ ^[0-9]+$ && "${max}" =~ ^[0-9]+$ && "${max}" -gt 0 ]] || return 1

    percent=$(((current * 100 + max / 2) / max))
    (( percent < 0 )) && percent=0
    (( percent > 100 )) && percent=100
    printf '%s\n' "${percent}"
}

write_backlight_percent() {
    local backlight="$1"
    local percent="$2"
    local current max target

    max="$(cat "${backlight}/max_brightness" 2>/dev/null || printf '0')"
    current="$(cat "${backlight}/brightness" 2>/dev/null || printf '0')"
    [[ "${max}" =~ ^[0-9]+$ && "${max}" -gt 0 ]] || return 0
    [[ "${current}" =~ ^[0-9]+$ ]] || current=0

    target=$(((percent * max + 50) / 100))
    (( target < 0 )) && target=0
    (( target > max )) && target="${max}"
    [[ "${current}" == "${target}" ]] && return 0

    printf '%s\n' "${target}" > "${backlight}/brightness" 2>/dev/null || true
}

start_thor_backlight_mirror() {
    local -a backlights=()
    local backlight

    [[ "${BATOCERA_STEAM_MIRROR_BACKLIGHTS:-1}" != "0" ]] || return 0
    is_ayn_thor || return 0

    while IFS= read -r backlight; do
        backlights+=("${backlight}")
    done < <(list_backlight_dirs)

    (( ${#backlights[@]} > 1 )) || return 0

    (
        watch_backlights=("${backlights[@]}")
        last=()
        current=()

        for i in "${!watch_backlights[@]}"; do
            last[$i]="$(cat "${watch_backlights[$i]}/brightness" 2>/dev/null || printf '')"
        done

        echo "Thor backlight mirror watching: ${watch_backlights[*]}" >> "${log}"
        while true; do
            changed=""
            percent=""

            for i in "${!watch_backlights[@]}"; do
                current[$i]="$(cat "${watch_backlights[$i]}/brightness" 2>/dev/null || printf '')"
                if [[ -z "${changed}" && "${current[$i]}" != "${last[$i]:-}" ]]; then
                    value="$(backlight_percent "${watch_backlights[$i]}" || true)"
                    if [[ "${value}" =~ ^[0-9]+$ ]]; then
                        changed="${watch_backlights[$i]}"
                        percent="${value}"
                    fi
                fi
            done

            if [[ -n "${changed}" && -n "${percent}" ]]; then
                for backlight in "${watch_backlights[@]}"; do
                    write_backlight_percent "${backlight}" "${percent}"
                done
                for i in "${!watch_backlights[@]}"; do
                    last[$i]="$(cat "${watch_backlights[$i]}/brightness" 2>/dev/null || printf '')"
                done
            else
                for i in "${!watch_backlights[@]}"; do
                    last[$i]="${current[$i]:-${last[$i]:-}}"
                done
            fi

            sleep "${BATOCERA_STEAM_MIRROR_BACKLIGHTS_INTERVAL:-0.25}"
        done
    ) &
    THOR_BRIGHTNESS_WATCH_PID="$!"
    echo "Thor backlight mirror started pid=${THOR_BRIGHTNESS_WATCH_PID}" >> "${log}"
}

stop_thor_backlight_mirror() {
    if [[ -n "${THOR_BRIGHTNESS_WATCH_PID}" ]]; then
        kill "${THOR_BRIGHTNESS_WATCH_PID}" 2>/dev/null || true
        wait "${THOR_BRIGHTNESS_WATCH_PID}" 2>/dev/null || true
        THOR_BRIGHTNESS_WATCH_PID=""
    fi
}

cleanup_steam_portal_session() {
    local pid

    for pid in "${STEAM_PORTAL_PIDS[@]}"; do
        kill "${pid}" >/dev/null 2>&1 || true
        wait "${pid}" >/dev/null 2>&1 || true
    done
    STEAM_PORTAL_PIDS=()

    if [[ -n "${STEAM_SESSION_DBUS_PID}" ]]; then
        kill "${STEAM_SESSION_DBUS_PID}" >/dev/null 2>&1 || true
        wait "${STEAM_SESSION_DBUS_PID}" >/dev/null 2>&1 || true
        STEAM_SESSION_DBUS_PID=""
    fi
}

cleanup_fex_session_leftovers() {
    local mount

    pkill -TERM -f '(^|/)FEXServer([[:space:]]|$)' >/dev/null 2>&1 || true
    sleep 0.2
    pkill -KILL -f '(^|/)FEXServer([[:space:]]|$)' >/dev/null 2>&1 || true

    for mount in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/.FEXMount* /run/user/*/.FEXMount*; do
        [[ -e "${mount}" ]] || continue
        fusermount3 -uz "${mount}" >/dev/null 2>&1 || \
            fusermount -uz "${mount}" >/dev/null 2>&1 || \
            umount -l "${mount}" >/dev/null 2>&1 || true
    done
}

stop_nightmode_watch() {
    local watcher_pattern='(^|/)batocera-steam-nightmode-watch([[:space:]]|$)'
    local attempt

    if [[ -n "${STEAM_NIGHTMODE_WATCH_PID}" ]]; then
        kill "${STEAM_NIGHTMODE_WATCH_PID}" >/dev/null 2>&1 || true
        wait "${STEAM_NIGHTMODE_WATCH_PID}" >/dev/null 2>&1 || true
        STEAM_NIGHTMODE_WATCH_PID=""
    fi

    pkill -TERM -f "${watcher_pattern}" >/dev/null 2>&1 || true
    for attempt in {1..20}; do
        pgrep -f "${watcher_pattern}" >/dev/null 2>&1 || return 0
        sleep 0.05
    done
    pkill -KILL -f "${watcher_pattern}" >/dev/null 2>&1 || true
}

suspend_batocera_nightmode() {
    command -v batocera-nightmode >/dev/null 2>&1 || return 0

    if batocera-nightmode suspend "$$"; then
        BATOCERA_NIGHTMODE_SUSPENDED=1
        echo "Steam session: suspended Batocera night mode" >> "${log}"
    else
        echo "Steam session: unable to suspend Batocera night mode" >> "${log}"
    fi
}

resume_batocera_nightmode() {
    [[ "${BATOCERA_NIGHTMODE_SUSPENDED}" == "1" ]] || return 0

    BATOCERA_NIGHTMODE_SUSPENDED=0
    batocera-nightmode resume >/dev/null 2>&1 || true
    echo "Steam session: restored Batocera night mode" >> "${log}"
}

cleanup_hotkeys_on_exit() {
    # "Switch to Desktop" kills the original session outside configgen's normal cleanup path.
    # Restore an explicit default context and ES profile when that happens.
    if declare -F stop_decky_loader >/dev/null 2>&1; then
        stop_decky_loader
    fi
    stop_nightmode_watch
    resume_batocera_nightmode
    stop_steam_install_callouts
    stop_thor_backlight_mirror
    release_steam_touchscreens || true
    cleanup_steam_portal_session
    cleanup_fex_session_leftovers
    run_ally_hotkey_hook gameStop || true
    if command -v hotkeygen >/dev/null 2>&1; then
        if ! hotkeygen_permanent_running && [ -x /etc/init.d/S90hotkeygen ]; then
            /etc/init.d/S90hotkeygen start >/dev/null 2>&1 || true
        fi
        /usr/bin/hotkeygen --default-context >/dev/null 2>&1 || true
        /usr/bin/hotkeygen --reload >/dev/null 2>&1 || true
    fi
}

cleanup_hotkeys_and_forward() {
    cleanup_hotkeys_on_exit || true
}

trap cleanup_hotkeys_and_forward EXIT TERM INT
start_session_supervisor

if [[ "${BATOCERA_STEAM_SETUP_PENDING:-0}" == "1" ]] || [[ "${BATOCERA_STEAM_FIRST_RUN:-0}" == "1" ]] || [[ -f "${STEAM_FIRST_RUN_WIFI_STAMP}" ]]; then
    STEAM_FIRST_RUN_PENDING=1
fi
if [[ -z "${STEAM_SETUP_KIND}" && "${BATOCERA_STEAM_FIRST_RUN:-0}" == "1" ]]; then
    STEAM_SETUP_KIND="client"
fi
if [[ -z "${STEAM_SETUP_KIND}" && "${STEAM_FIRST_RUN_PENDING}" == "1" ]]; then
    STEAM_SETUP_KIND="support"
fi

has_network() {
    if command -v ip >/dev/null 2>&1; then
        if ! ip route get 1.1.1.1 >/dev/null 2>&1; then
            return 1
        fi
    fi
    if command -v ping >/dev/null 2>&1; then
        timeout 2 ping -c 1 -W 1 1.1.1.1 >/dev/null 2>&1
        return $?
    fi
    return 0
}

steam_offline_launch_requested() {
    local arg

    case "${BATOCERA_STEAM_LAUNCH_OFFLINE:-0}" in
        1|true|TRUE|True|yes|YES|Yes|on|ON|On)
            return 0
            ;;
    esac

    for arg in "$@"; do
        [[ "${arg}" == "-offline" ]] && return 0
    done

    return 1
}

STEAM_OFFLINE_LAUNCH=0
if steam_offline_launch_requested "$@"; then
    STEAM_OFFLINE_LAUNCH=1
fi

if [[ "${STEAM_OFFLINE_LAUNCH}" == "1" ]] && [[ "${BATOCERA_STEAM_SETUP_PENDING:-0}" != "1" ]] && [[ "${BATOCERA_STEAM_FIRST_RUN:-0}" != "1" ]] && [[ -f "${STEAM_FIRST_RUN_WIFI_STAMP}" ]]; then
    rm -f "${STEAM_FIRST_RUN_WIFI_STAMP}"
    STEAM_FIRST_RUN_PENDING=0
    STEAM_SETUP_KIND=""
    echo "Ignoring stale Steam first-run Wi-Fi stamp for explicit offline launch" >> "${log}"
fi

STEAM_HAS_NETWORK=0
if has_network; then
    STEAM_HAS_NETWORK=1
fi

if [[ "${BATOCERA_STEAM_REQUIRE_NETWORK:-1}" == "1" ]] && [[ "${STEAM_HAS_NETWORK}" != "1" ]] && [[ "${STEAM_OFFLINE_LAUNCH}" != "1" ]]; then
    echo "No internet connection detected; aborting Steam launch" >> "${log}"

    if [[ "${STEAM_FIRST_RUN_PENDING}" == "1" ]]; then
        mkdir -p "$(dirname "${STEAM_FIRST_RUN_WIFI_STAMP}")"
        : > "${STEAM_FIRST_RUN_WIFI_STAMP}"
        echo "Steam first run is pending network; keeping ${STEAM_FIRST_RUN_WIFI_STAMP}" >> "${log}"
    fi

    if command -v batocera-flash-screen >/dev/null 2>&1; then
        if [[ "${STEAM_FIRST_RUN_PENDING}" == "1" ]]; then
            if [[ "${STEAM_SETUP_KIND}" == "client" ]]; then
                /usr/bin/batocera-flash-screen 6 "#ffffff" "Steam first setup needs Wi-Fi." 22 >/dev/null 2>&1 || true
            else
                /usr/bin/batocera-flash-screen 6 "#ffffff" "Steam support setup needs Wi-Fi." 21 >/dev/null 2>&1 || true
            fi
            /usr/bin/batocera-flash-screen 6 "#ffffff" "Please restart with Wi-Fi enabled." 20 >/dev/null 2>&1 || true
        else
            /usr/bin/batocera-flash-screen 6 "#ffffff" "No internet connection." 22 >/dev/null 2>&1 || true
            /usr/bin/batocera-flash-screen 6 "#ffffff" "Please connect to the internet and launch Steam again." 20 >/dev/null 2>&1 || true
        fi
    fi

    exit 1
fi

if [[ "${STEAM_HAS_NETWORK}" != "1" ]] && [[ "${STEAM_OFFLINE_LAUNCH}" == "1" ]]; then
    echo "No internet connection detected; continuing with Steam offline launch" >> "${log}"
fi

ensure_runtime_dir() {
    local uid
    local candidate

    if [[ -n "${XDG_RUNTIME_DIR:-}" ]] && [[ -d "${XDG_RUNTIME_DIR}" ]]; then
        return
    fi

    uid="$(id -u)"
    candidate="/run/user/${uid}"
    if mkdir -p "${candidate}" 2>/dev/null; then
        chmod 700 "${candidate}" 2>/dev/null || true
        export XDG_RUNTIME_DIR="${candidate}"
        return
    fi

    candidate="/tmp/runtime-${uid}"
    mkdir -p "${candidate}"
    chmod 700 "${candidate}" 2>/dev/null || true
    export XDG_RUNTIME_DIR="${candidate}"
}
ensure_runtime_dir

if [[ "${BATOCERA_STEAM_GAMEPADUI:-1}" == "0" ]]; then
    export STEAM_GAMEPADUI=0
    export STEAM_FORCE_DESKTOPUI=1
else
    export STEAM_GAMEPADUI=1
    export STEAM_FORCE_DESKTOPUI=0
fi

setup_cef_remote_debugging() {
    local marker
    local -a candidates=(
        "/userdata/system/steam/.cef-enable-remote-debugging"
        "/userdata/system/.steam/steam/.cef-enable-remote-debugging"
        "/userdata/system/.local/share/Steam/.cef-enable-remote-debugging"
    )

    for marker in "${candidates[@]}"; do
        mkdir -p "$(dirname "${marker}")"
        touch "${marker}"
    done
}

decky_process_pids() {
    local proc
    local pid
    local cmd

    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        [[ "${pid}" != "$$" && "${pid}" != "${BASHPID:-$$}" ]] || continue
        cmd="$(tr '\0' ' ' 2>/dev/null < "${proc}/cmdline" || true)"
        [[ -n "${cmd}" ]] || continue
        case "${cmd}" in
            *"/userdata/system/homebrew/services/PluginLoader"*|*"Decky Loader"*|*"/userdata/system/homebrew/plugin"*|*"Decky Terminal"*|*"Animation Changer"*|*"Game Theme Music"*|*"ProtonDB Badges"*)
                printf '%s\n' "${pid}"
                ;;
        esac
    done
}

decky_process_alive() {
    [[ -n "$(decky_process_pids | head -n 1)" ]]
}

kill_decky_processes() {
    local signal="$1"
    local pid

    while IFS= read -r pid; do
        [[ -n "${pid}" ]] || continue
        kill "-${signal}" "${pid}" >/dev/null 2>&1 || true
    done < <(decky_process_pids | sort -u)
}

wait_for_decky_processes_to_exit() {
    local max_tries="${1:-20}"
    local i

    for i in $(seq 1 "${max_tries}"); do
        decky_process_alive || return 0
        sleep 0.2
    done

    return 1
}

stop_decky_loader() {
    if [[ -n "${DECKY_STARTER_PID}" ]]; then
        kill "${DECKY_STARTER_PID}" >/dev/null 2>&1 || true
        wait "${DECKY_STARTER_PID}" >/dev/null 2>&1 || true
        DECKY_STARTER_PID=""
    fi

    decky_process_alive || return 0
    echo "Stopping Decky Loader process stack" >> "${log}"
    kill_decky_processes TERM
    if ! wait_for_decky_processes_to_exit 25; then
        kill_decky_processes KILL
        wait_for_decky_processes_to_exit 10 || true
    fi
}

steam_cef_remote_debugging_ready() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsS --max-time 1 http://127.0.0.1:8080/json >/dev/null 2>&1 && return 0
    fi
    if command -v wget >/dev/null 2>&1; then
        wget -q -T 1 -O - http://127.0.0.1:8080/json >/dev/null 2>&1 && return 0
    fi
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | grep -q '127[.]0[.]0[.]1:8080' && return 0
    fi

    return 1
}

start_decky_loader() {
    local decky_bin="${BATOCERA_STEAM_DECKY_BIN:-/userdata/system/homebrew/services/PluginLoader}"
    local decky_log="/userdata/system/logs/decky-loader.log"
    local max_secs="${BATOCERA_STEAM_DECKY_WAIT_SECS:-120}"

    if [[ ! -x "${decky_bin}" ]]; then
        return
    fi

    setup_cef_remote_debugging
    stop_decky_loader

    [[ "${max_secs}" =~ ^[0-9]+$ ]] || max_secs=120
    if (( max_secs < 1 )); then
        max_secs=120
    fi

    echo "Decky Loader: waiting for Steam CEF before starting ${decky_bin}" >> "${log}"
    (
        local waited=0

        exec 8>&- 2>/dev/null || true
        while (( waited < max_secs )); do
            if steam_cef_remote_debugging_ready; then
                echo "Starting Decky Loader from ${decky_bin}" >> "${log}"
                exec env \
                    HOME="${HOME}" \
                    XDG_DATA_HOME="${XDG_DATA_HOME}" \
                    XDG_CONFIG_HOME="${XDG_CONFIG_HOME}" \
                    XDG_CACHE_HOME="${XDG_CACHE_HOME}" \
                    STEAM_COMPAT_CLIENT_INSTALL_PATH="${XDG_DATA_HOME}/Steam" \
                    STEAM_ROOT="${XDG_DATA_HOME}/Steam" \
                    STEAM_BASE_FOLDER="${XDG_DATA_HOME}/Steam" \
                    DECKY_HOME="/userdata/system/homebrew" \
                    "${decky_bin}" </dev/null >> "${decky_log}" 2>&1
            fi
            sleep 1
            waited=$((waited + 1))
        done

        echo "Decky Loader: Steam CEF did not become ready after ${max_secs}s; not starting Decky" >> "${log}"
        exit 0
    ) &
    DECKY_STARTER_PID="$!"
}

parse_resolution() {
    local value="${1:-}"
    if [[ "${value}" =~ ^[[:space:]]*([0-9]+)x([0-9]+)[[:space:]]*$ ]]; then
        printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        return 0
    fi
    return 1
}

parse_positive_int() {
    local value="${1:-}"
    if [[ "${value}" =~ ^[0-9]+$ ]] && (( value > 0 )); then
        printf '%s\n' "${value}"
        return 0
    fi
    return 1
}

gamescope_help_cache=""

gamescope_supports_flag() {
    local flag="$1"
    if [[ -z "${gamescope_help_cache}" ]]; then
        gamescope_help_cache="$(gamescope --help 2>&1 || true)"
    fi
    [[ "${gamescope_help_cache}" == *"${flag}"* ]]
}

append_gamescope_flag() {
    local preferred="$1"
    local fallback="${2:-}"

    if gamescope_supports_flag "${preferred}"; then
        gs_args+=("${preferred}")
        return
    fi

    if [[ -n "${fallback}" ]] && gamescope_supports_flag "${fallback}"; then
        gs_args+=("${fallback}")
        return
    fi

    echo "Steam gamescope: skipping unsupported flag ${preferred}" >> "${log}"
}

append_gamescope_option() {
    local option="$1"
    local value="$2"

    if gamescope_supports_flag "${option}"; then
        gs_args+=("${option}" "${value}")
        return
    fi

    echo "Steam gamescope: skipping unsupported option ${option}" >> "${log}"
}

detect_output_resolution() {
    local parsed
    parsed="$(parse_resolution "${BATOCERA_STEAM_GS_OUTPUT_RES:-}" || true)"
    if [[ -n "${parsed}" ]]; then
        printf '%s\n' "${parsed}"
        return
    fi

    parsed="$(parse_resolution "${BATOCERA_STEAM_GS_DEFAULT_RES:-}" || true)"
    if [[ -n "${parsed}" ]]; then
        printf '%s\n' "${parsed}"
        return
    fi

    if command -v batocera-resolution >/dev/null 2>&1; then
        parsed="$(parse_resolution "$(batocera-resolution currentResolution 2>/dev/null || true)" || true)"
        if [[ -n "${parsed}" ]]; then
            printf '%s\n' "${parsed}"
            return
        fi
    fi

    printf '1280 720\n'
}

detect_nested_resolution() {
    local fallback_w="$1"
    local fallback_h="$2"
    local parsed

    parsed="$(parse_resolution "${BATOCERA_STEAM_GS_NESTED_RES:-}" || true)"
    if [[ -n "${parsed}" ]]; then
        printf '%s\n' "${parsed}"
        return
    fi

    printf '%s %s\n' "${fallback_w}" "${fallback_h}"
}

detect_refresh_rate() {
    local value

    value="$(parse_positive_int "${BATOCERA_STEAM_GS_NESTED_REFRESH:-}" || true)"
    if [[ -n "${value}" ]]; then
        printf '%s\n' "${value}"
        return
    fi

    if command -v batocera-resolution >/dev/null 2>&1; then
        value="$(batocera-resolution refreshRate 2>/dev/null || true)"
        if [[ "${value}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
            awk -v rate="${value}" 'BEGIN { printf "%d\n", int(rate + 0.5) }'
            return
        fi
    fi

    printf '0\n'
}


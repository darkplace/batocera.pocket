prepare_gamescope_child_lsfg_env() {
    local key value item filtered_layers
    local -a layer_items=()
    local -a lsfg_keys=(
        ENABLE_LSFG
        LSFG_LEGACY
        LSFG_DLL_PATH
        LSFG_MULTIPLIER
        LSFG_FLOW_SCALE
        LSFG_PERFORMANCE_MODE
        LSFG_HDR_MODE
        LSFG_EXPERIMENTAL_PRESENT_MODE
        LSFG_PROCESS
        BATOCERA_LSFG_WINE_LAYER
    )
    STEAM_CHILD_LSFG_ENV=()

    for key in "${lsfg_keys[@]}"; do
        if [[ -v "${key}" ]]; then
            value="${!key}"
            STEAM_CHILD_LSFG_ENV+=("${key}=${value}")
            unset "${key}"
        fi
    done

    if [[ -v VK_INSTANCE_LAYERS && "${VK_INSTANCE_LAYERS}" == *"VK_LAYER_LS_frame_generation"* ]]; then
        STEAM_CHILD_LSFG_ENV+=("VK_INSTANCE_LAYERS=${VK_INSTANCE_LAYERS}")
        filtered_layers=""
        IFS=':' read -r -a layer_items <<< "${VK_INSTANCE_LAYERS}"
        for item in "${layer_items[@]}"; do
            [[ -z "${item}" || "${item}" == "VK_LAYER_LS_frame_generation" ]] && continue
            filtered_layers+="${filtered_layers:+:}${item}"
        done
        if [[ -n "${filtered_layers}" ]]; then
            export VK_INSTANCE_LAYERS="${filtered_layers}"
        else
            unset VK_INSTANCE_LAYERS
        fi
    fi

    if [[ "${#STEAM_CHILD_LSFG_ENV[@]}" -gt 0 ]]; then
        if [[ -v VK_LAYER_PATH ]]; then
            STEAM_CHILD_LSFG_ENV+=("VK_LAYER_PATH=${VK_LAYER_PATH}")
            unset VK_LAYER_PATH
        fi
        if [[ -v LD_LIBRARY_PATH ]]; then
            STEAM_CHILD_LSFG_ENV+=("LD_LIBRARY_PATH=${LD_LIBRARY_PATH}")
        fi
        echo "Steam gamescope: LSFG layer removed from gamescope compositor env and passed to Steam child." >> "${log}"
    fi
}

run_gamescope_with_child() {

ensure_system_bus_address() {
    # Steam queries org.freedesktop.DisplayManager on the system bus.
    # Prefer the real system bus socket so Steam and our stub are on the same bus.
    if [[ -n "${DBUS_SYSTEM_BUS_ADDRESS:-}" ]]; then
        return
    fi

    if [[ -S /run/dbus/system_bus_socket ]]; then
        export DBUS_SYSTEM_BUS_ADDRESS="unix:path=/run/dbus/system_bus_socket"
        return
    fi

    # Last resort for atypical environments.
    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        export DBUS_SYSTEM_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS}"
    fi
}

session_bus_is_system_bus() {
    [[ "${DBUS_SESSION_BUS_ADDRESS:-}" == *"/run/dbus/system_bus_socket"* ]] || \
    [[ "${DBUS_SESSION_BUS_ADDRESS:-}" == *"/var/run/dbus/system_bus_socket"* ]]
}

session_bus_responds() {
    command -v dbus-send >/dev/null 2>&1 || return 0
    timeout 2 dbus-send --session --type=method_call \
        --dest=org.freedesktop.DBus / org.freedesktop.DBus.ListNames >/dev/null 2>&1
}

ensure_steam_session_bus() {
    local dbus_out
    local address
    local pid

    ensure_runtime_dir

    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] && ! session_bus_is_system_bus && session_bus_responds; then
        return
    fi

    if ! command -v dbus-daemon >/dev/null 2>&1; then
        echo "Steam portal setup: dbus-daemon missing, keeping DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unset}" >> "${log}"
        return
    fi

    dbus_out="$(dbus-daemon --session --fork --print-address=1 --print-pid=1 2>> "${log}" || true)"
    address="$(printf '%s\n' "${dbus_out}" | sed -n '1p')"
    pid="$(printf '%s\n' "${dbus_out}" | sed -n '2p')"
    if [[ -z "${address}" ]]; then
        echo "Steam portal setup: failed to create session bus" >> "${log}"
        return
    fi

    export DBUS_SESSION_BUS_ADDRESS="${address}"
    if [[ "${pid}" =~ ^[0-9]+$ ]]; then
        STEAM_SESSION_DBUS_PID="${pid}"
    fi
    echo "Steam portal setup: started private session bus pid=${STEAM_SESSION_DBUS_PID:-unknown}" >> "${log}"
}

portal_binary() {
    local name="$1"

    if [[ -x "/usr/libexec/${name}" ]]; then

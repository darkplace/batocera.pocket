strip_mangohud_loader_entries() {
    local name="$1"
    local value
    local item
    local filtered=""

    value="$(printenv "${name}" 2>/dev/null || true)"
    [[ -n "${value}" ]] || return 0
    value="${value//:/ }"
    for item in ${value}; do
        case "${item,,}" in
            *mangohud*|*mangoapp*)
                continue
                ;;
        esac
        filtered+="${filtered:+:}${item}"
    done

    if [[ -n "${filtered}" ]]; then
        printf -v "${name}" '%s' "${filtered}"
        export "${name}"
    else
        unset "${name}"
    fi
}

sanitize_inherited_mangohud_environment() {
    local inherited=0

    if [[ -n "${MANGOHUD:-}${MANGOHUD_CONFIG:-}${MANGOHUD_CONFIGFILE:-}${MANGOHUD_DLSYM:-}${MANGOAPP_CONFIG:-}" ]] ||
       [[ "${LD_PRELOAD:-}${LD_AUDIT:-}" == *[Mm]ango[Hh]ud* ]]; then
        inherited=1
    fi

    unset MANGOHUD MANGOHUD_CONFIG MANGOHUD_CONFIGFILE MANGOHUD_DLSYM MANGOAPP_CONFIG
    strip_mangohud_loader_entries LD_PRELOAD
    strip_mangohud_loader_entries LD_AUDIT

    if [[ "${inherited}" == "1" ]]; then
        echo "Steam gamescope: discarded inherited generic MangoHud environment." >> "${log}"
    fi
}

prepare_mangoapp_config() {
    local config_path level preset
    local visible="${BATOCERA_STEAM_GS_MANGOAPP_VISIBLE:-auto}"

    level="${BATOCERA_STEAM_GS_MANGOAPP_LEVEL:-}"
    case "${level}" in
        0|1|2|3|4)
            ;;
        *)
            if [[ "${BATOCERA_STEAM_GS_MANGOAPP:-0}" == "0" ]]; then
                level=0
            else
                level=2
            fi
            ;;
    esac

    if [[ "${level}" == "0" && "${BATOCERA_STEAM_GS_MANGOAPP:-0}" == "0" && -z "${MANGOHUD_CONFIGFILE:-}" && "${MANGOHUD:-0}" != "1" ]]; then
        return
    fi

    [[ -z "${MANGOHUD_CONFIGFILE:-}" ]] || return 0

    case "${visible}" in
        0|false|False|FALSE|off|Off|OFF|no|No|NO)
            return
            ;;
        auto|"")
            aarch64_host || return 0
            ;;
    esac

    # Steam writes its performance-overlay preset here and then invokes
    # `mangohudctl toggle reload_config`. MangoApp must read that same file;
    # pointing it at a private runtime file leaves the slider writing and
    # reloading a different configuration, permanently preserving no_display.
    config_path="${STEAM_ROOT:-${HOME}/.local/share/Steam}/config/mangohud.conf"
    mkdir -p "$(dirname "${config_path}")" 2>/dev/null || true
    if [[ ! -s "${config_path}" ]]; then
        case "${level}" in
            0)
                preset=0
                ;;
            1)
                preset=1
                ;;
            2)
                preset=2
                ;;
            3|4)
                preset=4
                ;;
        esac
        {
            printf '%s\n' "control=mangohud"
            printf '%s\n' "fsr_steam_sharpness=5"
            printf '%s\n' "nis_steam_sharpness=10"
            printf 'preset=%s\n' "${preset}"
        } > "${config_path}" || return 0
    fi

    export MANGOHUD_CONFIGFILE="${config_path}"
    echo "Steam MangoApp config: ${config_path} (level ${level})" >> "${log}"
}


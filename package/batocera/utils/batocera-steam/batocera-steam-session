portal_filechooser_available() {
    command -v gdbus >/dev/null 2>&1 || return 1
    timeout 2 gdbus introspect --session \
        --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop 2>/dev/null | \
        grep -q "org.freedesktop.portal.FileChooser"
}

start_steam_portals() {
    local portal_desktop="${BATOCERA_STEAM_PORTAL_DESKTOP:-labwc}"
    local portal
    local portal_gtk

    [[ "${BATOCERA_STEAM_START_PORTALS:-1}" != "0" ]] || return

    if portal_filechooser_available; then
        echo "Steam portal setup: FileChooser already available" >> "${log}"
        return
    fi

    portal="$(portal_binary xdg-desktop-portal)"
    portal_gtk="$(portal_binary xdg-desktop-portal-gtk)"
    if [[ -z "${portal}" || -z "${portal_gtk}" ]]; then
        echo "Steam portal setup: portal binaries missing" >> "${log}"
        return
    fi

    XDG_CURRENT_DESKTOP="${portal_desktop}" "${portal_gtk}" -r >> "${log}" 2>&1 &
    STEAM_PORTAL_PIDS+=("$!")
    sleep 0.1
    XDG_CURRENT_DESKTOP="${portal_desktop}" "${portal}" -r >> "${log}" 2>&1 &
    STEAM_PORTAL_PIDS+=("$!")

    sleep 0.8
    if portal_filechooser_available; then
        echo "Steam portal setup: FileChooser available on session bus using ${portal_desktop}" >> "${log}"
    else
        echo "Steam portal setup: FileChooser still unavailable after portal start" >> "${log}"
    fi
}


From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Fri, 10 Jul 2026 00:00:00 +000
Subject: [PATCH] ui: play Batocera achievement sounds on Linux

Canary only calls the Windows PlaySound API for guest notifications. Use
Batocera's PipeWire/PulseAudio players on Linux so the shared achievement
sound configured by configgen is audible in the native build.
---
 src/xenia/ui/imgui_guest_notification.cc | 51 +++++++++++++++++++++++-
 1 file changed, 50 insertions(+), 1 deletion(-)

diff --git a/src/xenia/ui/imgui_guest_notification.cc b/src/xenia/ui/imgui_guest_notification.cc
--- a/src/xenia/ui/imgui_guest_notification.cc
+++ b/src/xenia/ui/imgui_guest_notification.cc
@@ -7,6 +7,11 @@
  */
 
 #include <cmath>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <thread>
 
 #include "xenia/base/logging.h"
 #include "xenia/base/platform.h"
@@ -23,6 +28,46 @@ DEFINE_string(notification_sound_path, "",
               "MUST be in wav format!",
               "General");
 
+#if XE_PLATFORM_LINUX
+namespace {
+
+std::string ShellQuote(std::string_view value) {
+  std::string quoted = "'";
+  for (const char c : value) {
+    if (c == '\'') {
+      quoted += "'\\''";
+    } else {
+      quoted += c;
+    }
+  }
+  quoted += "'";
+  return quoted;
+}
+
+bool PlayWithBatoceraAudioPlayer(const std::filesystem::path& sound_path) {
+  if (!std::filesystem::exists(sound_path)) {
+    return false;
+  }
+
+  const std::string path = sound_path.string();
+  std::thread([path] {
+    const std::string quoted_path = ShellQuote(path);
+    const std::string pw_play_command =
+        "/usr/bin/pw-play " + quoted_path + " >/dev/null 2>&1";
+    const std::string paplay_command =
+        "/usr/bin/paplay " + quoted_path + " >/dev/null 2>&1";
+
+    if (std::system(pw_play_command.c_str()) != 0) {
+      std::system(paplay_command.c_str());
+    }
+  }).detach();
+
+  return true;
+}
+
+}  // namespace
+#endif
+
 namespace xe {
 namespace ui {
 
@@ -44,7 +89,11 @@ void ImGuiGuestNotification::UpdateNotificationState() {
       // TODO(Gliniak): Implement delayed notifications.
       current_stage_ = NotificationStage::FazeIn;
       notification_draw_progress_ = 0.2f;
-#if XE_PLATFORM_WIN32
+#if XE_PLATFORM_LINUX
+      if (!cvars::notification_sound_path.empty()) {
+        PlayWithBatoceraAudioPlayer(cvars::notification_sound_path);
+      }
+#elif XE_PLATFORM_WIN32
       if (!cvars::notification_sound_path.empty()) {
         auto notification_sound_path = cvars::notification_sound_path;
         if (std::filesystem::exists(notification_sound_path)) {
-- 

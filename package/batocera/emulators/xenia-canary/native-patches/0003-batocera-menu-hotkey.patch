From: Batocera Linux Team <batocera@batocera.linux>
Date: Sun, 31 May 2026 00:00:00 +0000
Subject: [PATCH] input: use Shift+F10 for Batocera menu hotkey

---
 src/xenia/app/emulator_window.cc | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/xenia/app/emulator_window.cc b/src/xenia/app/emulator_window.cc
--- a/src/xenia/app/emulator_window.cc
+++ b/src/xenia/app/emulator_window.cc
@@ -1055,6 +1055,12 @@ void EmulatorWindow::OnKeyDown(ui::KeyEvent& e) {
     case ui::VirtualKey::kF6: {
       ToggleDisplayConfigDialog();
     } break;
+    case ui::VirtualKey::kF10: {
+      if (!e.is_shift_pressed()) {
+        return;
+      }
+      ToggleProfilesConfigDialog();
+    } break;
     case ui::VirtualKey::kF11: {
       ToggleFullscreen();
     } break;

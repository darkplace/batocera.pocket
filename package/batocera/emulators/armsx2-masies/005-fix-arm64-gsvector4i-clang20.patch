From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Mon, 25 May 2026 00:00:00 +0000
Subject: [PATCH] gs: avoid char to u8 narrowing in ARM64 vector constructors

Clang 20 rejects list-initializing the u8 backing array from char
constructor parameters as narrowing. Cast explicitly to keep the existing
byte-preserving behavior while allowing the ARM64 build to compile.
---
 pcsx2/GS/GSVector4i_arm64.h | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/pcsx2/GS/GSVector4i_arm64.h b/pcsx2/GS/GSVector4i_arm64.h
index 1111111..2222222 100644
--- a/pcsx2/GS/GSVector4i_arm64.h
+++ b/pcsx2/GS/GSVector4i_arm64.h
@@ -27,7 +27,8 @@ class alignas(16) GSVector4i
 
 	constexpr GSVector4i(cxpr_init_tag, char b0, char b1, char b2, char b3, char b4, char b5, char b6, char b7, char b8, char b9, char b10, char b11, char b12, char b13, char b14, char b15)
 #if !defined(__APPLE__) && !defined(_MSC_VER)
-		: U8{b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15}
+		: U8{static_cast<u8>(b0), static_cast<u8>(b1), static_cast<u8>(b2), static_cast<u8>(b3), static_cast<u8>(b4), static_cast<u8>(b5), static_cast<u8>(b6), static_cast<u8>(b7),
+			static_cast<u8>(b8), static_cast<u8>(b9), static_cast<u8>(b10), static_cast<u8>(b11), static_cast<u8>(b12), static_cast<u8>(b13), static_cast<u8>(b14), static_cast<u8>(b15)}
 #else
 		: I8{b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15}
 #endif
@@ -104,7 +105,8 @@ public:
 
 	constexpr GSVector4i(char b0, char b1, char b2, char b3, char b4, char b5, char b6, char b7, char b8, char b9, char b10, char b11, char b12, char b13, char b14, char b15)
 #if !defined(__APPLE__) && !defined(_MSC_VER)
-		: U8{b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15}
+		: U8{static_cast<u8>(b0), static_cast<u8>(b1), static_cast<u8>(b2), static_cast<u8>(b3), static_cast<u8>(b4), static_cast<u8>(b5), static_cast<u8>(b6), static_cast<u8>(b7),
+			static_cast<u8>(b8), static_cast<u8>(b9), static_cast<u8>(b10), static_cast<u8>(b11), static_cast<u8>(b12), static_cast<u8>(b13), static_cast<u8>(b14), static_cast<u8>(b15)}
 #else
 		: I8{b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15}
 #endif
-- 
2.50.1

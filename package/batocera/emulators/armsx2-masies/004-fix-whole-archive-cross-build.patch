From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Mon, 25 May 2026 00:00:00 +0000
Subject: [PATCH] cmake: avoid WHOLE_ARCHIVE for non-Apple multi-ISA fallback

CMake does not always advertise LINK_LIBRARY:WHOLE_ARCHIVE support for
Buildroot's cross C++ link language, even when using a new enough CMake.
The project already supports linking these static GS ISA libraries without
WHOLE_ARCHIVE on non-Apple platforms, so keep WHOLE_ARCHIVE only for the
macOS case it is intended to fix.
---
 pcsx2/CMakeLists.txt | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/pcsx2/CMakeLists.txt b/pcsx2/CMakeLists.txt
index 1111111..2222222 100644
--- a/pcsx2/CMakeLists.txt
+++ b/pcsx2/CMakeLists.txt
@@ -781,12 +781,12 @@ if(DISABLE_ADVANCE_SIMD)
 		target_link_libraries(GS-${isa} PRIVATE PCSX2_FLAGS)
 		target_compile_definitions(GS-${isa} PRIVATE MULTI_ISA_UNSHARED_COMPILATION=isa_${isa} MULTI_ISA_IS_FIRST=${is_first_isa} ${pcsx2_defs_${isa}})
 		target_compile_options(GS-${isa} PRIVATE ${compile_options_${isa}})
-		if (${CMAKE_VERSION} VERSION_GREATER_EQUAL 3.24)
-			target_link_libraries(PCSX2 PRIVATE $<LINK_LIBRARY:WHOLE_ARCHIVE,GS-${isa}>)
-		elseif(APPLE)
-			message(FATAL_ERROR "MacOS builds with DISABLE_ADVANCE_SIMD=ON require CMake 3.24")
-		else()
+		if(NOT APPLE)
 			target_link_libraries(PCSX2 PRIVATE GS-${isa})
+		elseif(${CMAKE_VERSION} VERSION_GREATER_EQUAL 3.24)
+			target_link_libraries(PCSX2 PRIVATE $<LINK_LIBRARY:WHOLE_ARCHIVE,GS-${isa}>)
+		else()
+			message(FATAL_ERROR "MacOS builds with DISABLE_ADVANCE_SIMD=ON require CMake 3.24")
 		endif()
 		set(is_first_isa "0")
 	endforeach()
-- 
2.50.1

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Wed, 27 May 2026 00:00:00 +0000
Subject: [PATCH] overlays: use Batocera trophy sound when configured

Allow configgen to route RPCS3 trophy notifications to Batocera's shared
RetroAchievements sound assets. The selected sound is passed through the
BATOCERA_RPCS3_TROPHY_SOUND environment variable and played with
PipeWire/PulseAudio on Linux when the file is not WAV.
---
 rpcs3/Emu/RSX/Overlays/overlays.cpp          |  8 ++++++++
 rpcs3/rpcs3qt/gui_application.cpp            | 13 +++++++++++++
 rpcs3/rpcs3qt/trophy_notification_helper.cpp |  4 +++-
 3 files changed, 24 insertions(+), 1 deletion(-)

--- a/rpcs3/Emu/RSX/Overlays/overlays.cpp
+++ b/rpcs3/Emu/RSX/Overlays/overlays.cpp
@@ -7,6 +7,8 @@
 #include "Emu/RSX/RSXThread.h"
 #include "Emu/System.h"
 
+#include <cstdlib>
+
 LOG_CHANNEL(overlays);
 
 extern bool is_input_allowed();
@@ -17,6 +19,12 @@
 	{
 		std::string get_sound_filepath(sound_effect sound)
 		{
+			if (sound == sound_effect::trophy)
+			{
+				if (const char* batocera_trophy_sound = std::getenv("BATOCERA_RPCS3_TROPHY_SOUND"); batocera_trophy_sound && *batocera_trophy_sound)
+					return batocera_trophy_sound;
+			}
+
 			const auto get_sound_filename = [sound]()
 			{
 				switch (sound)
--- a/rpcs3/rpcs3qt/gui_application.cpp
+++ b/rpcs3/rpcs3qt/gui_application.cpp
@@ -48,6 +48,7 @@
 #include <QDirIterator>
 #include <QFileInfo>
 #include <QMessageBox>
+#include <QProcess>
 #include <QTextDocument>
 #include <QStyleFactory>
 #include <QStyleHints>
@@ -807,6 +808,18 @@
 		{
 			if (fs::is_file(path))
 			{
+#ifdef __linux__
+				const QString sound_path = QString::fromStdString(path);
+				if (!sound_path.endsWith(QStringLiteral(".wav"), Qt::CaseInsensitive))
+				{
+					for (const QString& player : { QStringLiteral("/usr/bin/pw-play"), QStringLiteral("/usr/bin/paplay") })
+					{
+						if (QFileInfo::exists(player) && QProcess::startDetached(player, QStringList{ sound_path }))
+							return;
+					}
+				}
+#endif
+
 				// Allow to play 3 sound effects at the same time
 				while (m_sound_effects.size() >= 3)
 				{
--- a/rpcs3/rpcs3qt/trophy_notification_helper.cpp
+++ b/rpcs3/rpcs3qt/trophy_notification_helper.cpp
@@ -6,6 +6,7 @@
 
 #include "../Emu/RSX/Overlays/overlay_manager.h"
 #include "../Emu/RSX/Overlays/overlay_trophy_notification.h"
+#include "../Emu/RSX/Overlays/overlays.h"
 
 #include "Utilities/File.h"
 
@@ -31,7 +32,8 @@
 		trophy_notification->move(m_game_window->mapToGlobal(QPoint(0, 0)));
 		trophy_notification->show();
 
-		Emu.GetCallbacks().play_sound(fs::get_config_dir() + "sounds/snd_trophy.wav", std::nullopt);
+		Emu.GetCallbacks().play_sound(
+			rsx::overlays::get_sound_filepath(rsx::overlays::sound_effect::trophy), std::nullopt);
 	});
 
 	return 0;
-- 

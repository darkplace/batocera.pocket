From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Tue, 14 Jul 2026 00:00:00 +000
Subject: [PATCH] build: use a native shader compiler while cross-compiling

Buildroot cannot execute the target-aarch64 xenia-shader-cc on the x86_64
build host. Add an explicit host-tool-only configuration and allow the target
configuration to import that native tool.

Signed-off-by: suckbluefrog <suckbluefrog@proton.me>
---
 CMakeLists.txt             | 7 +++++++
 third_party/CMakeLists.txt | 8 +++++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b3c9437c4..6ec2a177f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -77,6 +77,8 @@ message(STATUS "Target architecture: XE_TARGET_AARCH64=${XE_TARGET_AARCH64} XE_T
 
 option(XENIA_BUILD_TESTS "Build test suites" OFF)
 option(XENIA_BUILD_MISC "Build misc subprojects (trace viewers, shader compiler, vfs-dump, demos)" OFF)
+option(XENIA_BUILD_HOST_SHADER_CC_ONLY "Only build the native shader compiler host tool" OFF)
+option(XENIA_USE_HOST_SHADER_CC "Use a prebuilt native xenia-shader-cc during cross builds" OFF)
 option(XENIA_ENABLE_LTO "Enable link-time optimization in Release (slow link)" ON)
 option(XENIA_ENABLE_PROFILER "Enable profiler (UI is Debug-only)" OFF)
 option(XENIA_ENABLE_ITRACE "Enable JIT per-instruction tracing to the log (slow)" OFF)
@@ -181,6 +183,11 @@ add_compile_definitions(
 # Prevent ASan error from ImGUI
 add_compile_definitions($<$<NOT:$<CONFIG:Checked>>:IMGUI_USE_STB_SPRINTF>)
 
+if(XENIA_BUILD_HOST_SHADER_CC_ONLY)
+  add_subdirectory(third_party)
+  return()
+endif()
+
 # ==============================================================================
 # Platform-specific global settings
 # ==============================================================================
diff --git a/third_party/CMakeLists.txt b/third_party/CMakeLists.txt
index 8bda10e16..ea0b3cc78 100644
--- a/third_party/CMakeLists.txt
+++ b/third_party/CMakeLists.txt
@@ -188,7 +188,9 @@ target_include_directories(glslang-spirv PUBLIC glslang)
 # (Windows-on-ARM runs x64 fine via Prism, and macOS handles its own
 # x86_64↔arm64 via Rosetta — both directions are unaffected).
 set(_xe_use_host_shader_cc FALSE)
-if(WIN32 AND CMAKE_CROSSCOMPILING AND XE_TARGET_AARCH64
+if(XENIA_USE_HOST_SHADER_CC)
+  set(_xe_use_host_shader_cc TRUE)
+elseif(WIN32 AND CMAKE_CROSSCOMPILING AND XE_TARGET_AARCH64
     AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64")
   set(_xe_use_host_shader_cc TRUE)
 endif()
@@ -455,6 +457,10 @@ set_target_properties(xenia-shader-cc PROPERTIES
 
 endif()
 
+if(XENIA_BUILD_HOST_SHADER_CC_ONLY)
+  return()
+endif()
+
 # ==============================================================================
 # imgui
 # ==============================================================================
-- 

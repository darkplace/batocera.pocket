config BR2_PACKAGE_EDEN
	bool "Eden (Nintendo Switch)"
	depends on BR2_aarch64
	help
	  Eden Nintendo Switch emulator.

	  This package installs the published Linux AppImage and wraps it with
	  a Batocera runtime launcher under /usr/bin/eden.

if BR2_PACKAGE_EDEN

config BR2_PACKAGE_EDEN_NATIVE
	bool "Build native Eden"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_QT6_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8
	depends on BR2_HOST_GCC_AT_LEAST_8
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	depends on BR2_USE_WCHAR
	depends on BR2_PACKAGE_XORG7
	select BR2_PACKAGE_BOOST
	select BR2_PACKAGE_BOOST_CONTAINER
	select BR2_PACKAGE_BOOST_CONTEXT
	select BR2_PACKAGE_BOOST_FIBER
	select BR2_PACKAGE_BOOST_FILESYSTEM
	select BR2_PACKAGE_BOOST_SYSTEM
	select BR2_PACKAGE_BOOST_THREAD
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_FFMPEG_SWSCALE
	select BR2_PACKAGE_FMT
	select BR2_PACKAGE_JSON_FOR_MODERN_CPP
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBDRM_FREEDRENO if BR2_aarch64
	select BR2_PACKAGE_LIBENET
	select BR2_PACKAGE_LIBEVDEV
	select BR2_PACKAGE_LIBOPENSSL
	select BR2_PACKAGE_LIBUSB
	select BR2_PACKAGE_LIBZIP
	select BR2_PACKAGE_LZ4
	select BR2_PACKAGE_OPUS
	select BR2_PACKAGE_QT6
	select BR2_PACKAGE_QT6BASE_CONCURRENT
	select BR2_PACKAGE_QT6BASE_DBUS
	select BR2_PACKAGE_QT6BASE_GUI
	select BR2_PACKAGE_QT6BASE_NETWORK
	select BR2_PACKAGE_QT6BASE_OPENGL if BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_QT6BASE_OPENGL_DESKTOP if BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_QT6BASE_VULKAN
	select BR2_PACKAGE_QT6BASE_WIDGETS
	select BR2_PACKAGE_QT6BASE_XCB
	select BR2_PACKAGE_QT6CHARTS
	select BR2_PACKAGE_QUAZIP
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_SDL3_OPENGL if BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_SDL3_X11
	select BR2_PACKAGE_SPIRV_HEADERS
	select BR2_PACKAGE_SPIRV_TOOLS
	select BR2_PACKAGE_VULKAN_HEADERS
	select BR2_PACKAGE_VULKAN_LOADER
	select BR2_PACKAGE_VULKAN_UTILITY_LIBRARIES
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_ZSTD
	help
	  Build the UzuCore Eden standalone frontend natively instead of
	  relying only on the upstream AppImage. The AppImage is still
	  installed for fallback and comparison.

endif

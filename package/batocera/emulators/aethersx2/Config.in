config BR2_PACKAGE_AETHERSX2
    bool "aethersx2"
    depends on BR2_aarch64
    depends on BR2_PACKAGE_HAS_GLES3 || BR2_PACKAGE_BATOCERA_VULKAN
    select BR2_PACKAGE_BATOCERA_QT6
    select BR2_PACKAGE_LIBAIO
    select BR2_PACKAGE_LIBCURL
    select BR2_PACKAGE_LIBPCAP
    select BR2_PACKAGE_LIBPNG
    select BR2_PACKAGE_SDL2
    select BR2_PACKAGE_XLIB_LIBXRANDR if BR2_PACKAGE_XORG7
    select BR2_PACKAGE_XZ
    select BR2_PACKAGE_ZLIB

    help
      AetherSX2 is an aarch64 closed-source fork of the PCSX2 PlayStation 2
      emulator.

      This package installs the ROCKNIX native aarch64 tarball instead of
      building AetherSX2 from source.

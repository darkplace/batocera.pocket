@@ -7,15 +7,101 @@

 find_package(PkgConfig REQUIRED)

+set(HOST_THUNK_SYSROOT "" CACHE PATH "Sysroot containing host thunk parsing headers")
+set(HOST_THUNK_TARGET_TRIPLE "" CACHE STRING "Target triple used for host thunk parsing")
+set(HOST_THUNK_TOOLCHAIN_INCLUDE_ROOT "" CACHE PATH "Root of the target toolchain headers used for host thunk parsing")
+set(HOST_THUNK_CXX_INCLUDE_ROOT "" CACHE PATH "Root of the target C++ headers used for host thunk parsing")
+set(CLANG_RESOURCE_DIR "" CACHE PATH "Clang resource directory for thunk parsing")
+set(CLANG_BUILTIN_HEADERS "" CACHE PATH "Clang builtin headers directory for thunk parsing")
+
+function(host_thunk_add_sysroot_include TARGET INCLUDE_DIR)
+  if (INCLUDE_DIR MATCHES "^/usr(/|$)")
+    if (HOST_THUNK_SYSROOT)
+      set(SYSROOT_INCLUDE "${HOST_THUNK_SYSROOT}${INCLUDE_DIR}")
+      if (EXISTS "${SYSROOT_INCLUDE}")
+        target_include_directories(${TARGET} INTERFACE "${SYSROOT_INCLUDE}")
+        return()
+      endif()
+    elseif (CMAKE_SYSROOT)
+      set(SYSROOT_INCLUDE "${CMAKE_SYSROOT}${INCLUDE_DIR}")
+      if (EXISTS "${SYSROOT_INCLUDE}")
+        target_include_directories(${TARGET} INTERFACE "${SYSROOT_INCLUDE}")
+        return()
+      endif()
+    endif()
+  endif()
+
+  if (EXISTS "${INCLUDE_DIR}")
+    target_include_directories(${TARGET} INTERFACE "${INCLUDE_DIR}")
+  endif()
+endfunction()
+
+function(host_thunk_add_common_window_includes TARGET)
+  host_thunk_add_sysroot_include(${TARGET} /usr/include)
+  host_thunk_add_sysroot_include(${TARGET} /usr/include/X11)
+  host_thunk_add_sysroot_include(${TARGET} /usr/include/xcb)
+endfunction()
+
+function(host_thunk_append_parser_flags OUT_VAR)
+  set(FLAGS "")
+  if (CLANG_RESOURCE_DIR)
+    list(APPEND FLAGS "-resource-dir" "${CLANG_RESOURCE_DIR}")
+  endif()
+  if (CLANG_BUILTIN_HEADERS)
+    list(APPEND FLAGS "-isystem" "${CLANG_BUILTIN_HEADERS}")
+  endif()
+  # fex-thunkgen's embedded libclang still advertises a recent clang
+  # version even when it mishandles glibc's AArch64 vector-math probes.
+  # Hide those version macros so glibc takes its conservative path.
+  list(APPEND FLAGS "-U__clang_major__" "-U__clang_minor__" "-U__clang_patchlevel__")
+  if (HOST_THUNK_SYSROOT)
+    list(APPEND FLAGS "--sysroot=${HOST_THUNK_SYSROOT}")
+    # libclang does not reliably resolve <stdint.h> via --sysroot alone;
+    # add the sysroot usr/include explicitly (same fix as guest thunks).
+    list(APPEND FLAGS "-isystem" "${HOST_THUNK_SYSROOT}/usr/include")
+  elseif (CMAKE_SYSROOT)
+    list(APPEND FLAGS "--sysroot=${CMAKE_SYSROOT}")
+    list(APPEND FLAGS "-isystem" "${CMAKE_SYSROOT}/usr/include")
+  endif()
+  if (HOST_THUNK_TARGET_TRIPLE)
+    list(APPEND FLAGS "--target=${HOST_THUNK_TARGET_TRIPLE}")
+  endif()
+  if (HOST_THUNK_TOOLCHAIN_INCLUDE_ROOT AND EXISTS "${HOST_THUNK_TOOLCHAIN_INCLUDE_ROOT}")
+    list(APPEND FLAGS "-isystem" "${HOST_THUNK_TOOLCHAIN_INCLUDE_ROOT}")
+  endif()
+  if (HOST_THUNK_CXX_INCLUDE_ROOT)
+    file(GLOB HOST_CXX_INCLUDE_DIRS LIST_DIRECTORIES true "${HOST_THUNK_CXX_INCLUDE_ROOT}/*")
+    foreach(HOST_CXX_DIR IN LISTS HOST_CXX_INCLUDE_DIRS)
+      if (IS_DIRECTORY "${HOST_CXX_DIR}")
+        list(APPEND FLAGS "-isystem" "${HOST_CXX_DIR}")
+        if (HOST_THUNK_TARGET_TRIPLE AND IS_DIRECTORY "${HOST_CXX_DIR}/${HOST_THUNK_TARGET_TRIPLE}")
+          list(APPEND FLAGS "-isystem" "${HOST_CXX_DIR}/${HOST_THUNK_TARGET_TRIPLE}")
+        endif()
+        if (IS_DIRECTORY "${HOST_CXX_DIR}/backward")
+          list(APPEND FLAGS "-isystem" "${HOST_CXX_DIR}/backward")
+        endif()
+        break()
+      endif()
+    endforeach()
+  endif()
+  set(${OUT_VAR} "${FLAGS}" PARENT_SCOPE)
+endfunction()
+
 # Helper to add include directories from pkg-config, falling back to global defaults if not available.
 # /usr/include is dropped to avoid mixing foreign-architecture standard library headers.
 function(target_include_directories_from_pkgconfig target pkg)
   pkg_check_modules(PKG QUIET ${pkg})
   if (PKG_FOUND)
-    list(REMOVE_ITEM PKG_INCLUDE_DIRS /usr/include)
-    target_include_directories(${target} INTERFACE ${PKG_INCLUDE_DIRS})
+    foreach(PKG_INCLUDE_DIR IN LISTS PKG_INCLUDE_DIRS)
+      if (PKG_INCLUDE_DIR STREQUAL "/usr/include" AND NOT HOST_THUNK_SYSROOT AND NOT CMAKE_SYSROOT)
+        continue()
+      endif()
+      host_thunk_add_sysroot_include(${target} "${PKG_INCLUDE_DIR}")
+    endforeach()
   elseif (ARGN)
-    target_include_directories(${target} INTERFACE ${ARGN})
+    foreach(FALLBACK_INCLUDE_DIR IN LISTS ARGN)
+      host_thunk_add_sysroot_include(${target} "${FALLBACK_INCLUDE_DIR}")
+    endforeach()
   endif()
 endfunction()


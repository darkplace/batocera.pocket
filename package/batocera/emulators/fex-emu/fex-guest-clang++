#!/bin/sh
unset CCC_OVERRIDE_OPTIONS CFLAGS CXXFLAGS CPPFLAGS LDFLAGS TARGET_CFLAGS TARGET_CXXFLAGS TARGET_LDFLAGS

set -- "$@"
filtered_args=
for arg in "$@"; do
	case "$arg" in
		-march=*|-mcpu=*|-mtune=*|-mabi=*)
			continue
			;;
	esac
	filtered_args="${filtered_args}
${arg}"
done

set --
old_ifs=$IFS
IFS='
'
for arg in $filtered_args; do
	set -- "$@" "$arg"
done
IFS=$old_ifs

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for compiler in \
	"$script_dir/clang++.br_real" \
	"$script_dir/clang++-20.br_real"
do
	if [ -x "$compiler" ]; then
		exec "$compiler" "$@"
	fi
done

if [ -x "$script_dir/fex-system-clang++" ]; then
	exec "$script_dir/fex-system-clang++" "$@"
fi

for compiler in \
	/proc/1/root/usr/bin/clang++-21 \
	/proc/1/root/usr/sbin/clang++-21 \
	/proc/1/root/bin/clang++-21 \
	/proc/1/root/usr/bin/clang++ \
	/proc/1/root/usr/sbin/clang++ \
	/proc/1/root/bin/clang++ \
	/proc/self/root/usr/bin/clang++-21 \
	/proc/self/root/usr/sbin/clang++-21 \
	/proc/self/root/bin/clang++-21 \
	/proc/self/root/usr/bin/clang++ \
	/proc/self/root/usr/sbin/clang++ \
	/proc/self/root/bin/clang++ \
	/usr/bin/clang++-21 \
	/usr/sbin/clang++-21 \
	/bin/clang++-21 \
	/usr/bin/clang++ \
	/usr/sbin/clang++ \
	/bin/clang++
do
	if [ -x "$compiler" ]; then
		exec "$compiler" "$@"
	fi
done

echo "fex-guest-clang++: no real host clang++ found" >&2
exit 127

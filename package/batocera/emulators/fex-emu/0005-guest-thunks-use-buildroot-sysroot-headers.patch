--- a/ThunkLibs/GuestLibs/CMakeLists.txt
+++ b/ThunkLibs/GuestLibs/CMakeLists.txt
@@ -11,13 +11,41 @@
 function(target_include_directories_from_pkgconfig target pkg)
   pkg_check_modules(PKG QUIET ${pkg})
   if (PKG_FOUND)
-    list(REMOVE_ITEM PKG_INCLUDE_DIRS /usr/include)
-    target_include_directories(${target} INTERFACE ${PKG_INCLUDE_DIRS})
+    foreach(PKG_INCLUDE_DIR IN LISTS PKG_INCLUDE_DIRS)
+      if (PKG_INCLUDE_DIR STREQUAL "/usr/include" AND NOT GUEST_THUNK_SYSROOT)
+        continue()
+      endif()
+      guest_thunk_add_sysroot_include(${target} "${PKG_INCLUDE_DIR}")
+    endforeach()
   elseif (ARGN)
-    target_include_directories(${target} INTERFACE ${ARGN})
+    foreach(FALLBACK_INCLUDE_DIR IN LISTS ARGN)
+      guest_thunk_add_sysroot_include(${target} "${FALLBACK_INCLUDE_DIR}")
+    endforeach()
   endif()
 endfunction()
 
+set(GUEST_THUNK_SYSROOT "" CACHE PATH "Sysroot containing guest thunk parsing headers")
+
+function(guest_thunk_add_sysroot_include TARGET INCLUDE_DIR)
+  if (GUEST_THUNK_SYSROOT AND INCLUDE_DIR MATCHES "^/usr(/|$)")
+    set(SYSROOT_INCLUDE "${GUEST_THUNK_SYSROOT}${INCLUDE_DIR}")
+    if (EXISTS "${SYSROOT_INCLUDE}")
+      target_include_directories(${TARGET} INTERFACE "${SYSROOT_INCLUDE}")
+      return()
+    endif()
+  endif()
+
+  if (GUEST_THUNK_SYSROOT AND INCLUDE_DIR MATCHES "/sysroot(/usr(/.*)?)$")
+    set(SYSROOT_INCLUDE "${GUEST_THUNK_SYSROOT}${CMAKE_MATCH_1}")
+    if (EXISTS "${SYSROOT_INCLUDE}")
+      target_include_directories(${TARGET} INTERFACE "${SYSROOT_INCLUDE}")
+      return()
+    endif()
+  endif()
+
+  if (EXISTS "${INCLUDE_DIR}")
+    target_include_directories(${TARGET} INTERFACE "${INCLUDE_DIR}")
+  endif()
+endfunction()
+
+function(guest_thunk_add_common_window_includes TARGET)
+  guest_thunk_add_sysroot_include(${TARGET} /usr/include)
+  guest_thunk_add_sysroot_include(${TARGET} /usr/include/X11)
+  guest_thunk_add_sysroot_include(${TARGET} /usr/include/xcb)
+endfunction()
+

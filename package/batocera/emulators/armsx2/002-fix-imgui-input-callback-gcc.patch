From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Mon, 27 Apr 2026 00:00:00 +0000
Subject: [PATCH] imgui: fix input callback ternary for GCC

GCC rejects the conditional operator when one operand is the input
callback lambda and the other is nullptr.  Convert the non-capturing
lambda to ImGuiInputTextCallback explicitly through a typed local.
---
 ARMSX2/app/src/main/cpp/pcsx2/ImGui/ImGuiFullscreen.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/ARMSX2/app/src/main/cpp/pcsx2/ImGui/ImGuiFullscreen.cpp b/ARMSX2/app/src/main/cpp/pcsx2/ImGui/ImGuiFullscreen.cpp
index 1111111..2222222 100644
--- a/ARMSX2/app/src/main/cpp/pcsx2/ImGui/ImGuiFullscreen.cpp
+++ b/ARMSX2/app/src/main/cpp/pcsx2/ImGui/ImGuiFullscreen.cpp
@@ -2587,9 +2587,11 @@ void ImGuiFullscreen::DrawInputDialog()
 		ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.4f, 0.4f, 0.4f, 1.0f));
 		ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
 
-		ImGui::InputText("##input", &s_input_dialog_text, flags,
-			(s_input_dialog_filter_type != InputFilterType::None) ? input_callback : nullptr,
-			(s_input_dialog_filter_type != InputFilterType::None) ? static_cast<void*>(&s_input_dialog_filter_type) : nullptr);
+		const bool use_input_filter = (s_input_dialog_filter_type != InputFilterType::None);
+		const ImGuiInputTextCallback callback = use_input_filter ? static_cast<ImGuiInputTextCallback>(input_callback) : nullptr;
+		void* callback_data = use_input_filter ? static_cast<void*>(&s_input_dialog_filter_type) : nullptr;
+
+		ImGui::InputText("##input", &s_input_dialog_text, flags, callback, callback_data);
 
 		ImGui::PopStyleColor(5);
 		ImGui::PopStyleVar(3);
-- 
2.50.1


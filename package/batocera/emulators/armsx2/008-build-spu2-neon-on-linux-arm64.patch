From 4c12304837f12eb90d186ea01bed165d999d164a Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Tue, 14 Jul 2026 14:35:00 +000
Subject: [PATCH] cmake: build SPU2 NEON backend on Linux arm64

InternalReset calls RegisterNEONBackend on every AArch64 platform, but the
implementation was only added to Android and iOS builds. Include the backend
for every ARM64 target so the Linux Qt executable links as well.
---
 pcsx2/CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pcsx2/CMakeLists.txt b/pcsx2/CMakeLists.txt
index 940b6cc66..b10c234dd 100644
--- a/pcsx2/CMakeLists.txt
+++ b/pcsx2/CMakeLists.txt
@@ -1115,8 +1115,8 @@ if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
 	set(ARMSX2_IOS TRUE)
 endif()
 
-# NEON-optimised SPU2 mixer/reverb: shared by all arm64 mobile targets.
-if(ANDROID OR ARMSX2_IOS)
+# NEON-optimised SPU2 mixer/reverb: shared by all arm64 targets.
+if(ARCH_ARM64)
 	list(APPEND pcsx2SPU2Sources
 		SPU2/spu2_neon.cpp)
 	list(APPEND pcsx2SPU2Headers
-- 
2.51.2

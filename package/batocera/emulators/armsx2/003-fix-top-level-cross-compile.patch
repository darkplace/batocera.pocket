From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Tue, 14 Jul 2026 00:00:00 +000
Subject: [PATCH] cmake: accept target geometry presets for cross builds

ARMSX2 now selects the architecture from CMAKE_SYSTEM_PROCESSOR upstream, but
its Linux page-size and cache-line probes still try to execute a target ARM64
binary on the x86_64 Buildroot host. Honor package-supplied target values.

Signed-off-by: suckbluefrog <suckbluefrog@proton.me>
---
 cmake/Pcsx2Utils.cmake | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/cmake/Pcsx2Utils.cmake b/cmake/Pcsx2Utils.cmake
index dd02a69aa..aba61d306 100644
--- a/cmake/Pcsx2Utils.cmake
+++ b/cmake/Pcsx2Utils.cmake
@@ -228,6 +228,13 @@ function(disable_compiler_warnings_for_target target)
 endfunction()
 
 function(detect_page_size)
+	# Cross builds cannot execute the target probe. Allow the package to supply
+	# the known target page size instead.
+	if(DEFINED HOST_PAGE_SIZE)
+		message(STATUS "Host page size (preset): ${HOST_PAGE_SIZE}")
+		return()
+	endif()
+
 	message(STATUS "Determining host page size")
 	set(detect_page_size_file ${CMAKE_BINARY_DIR}${CMAKE_FILES_DIRECTORY}/CMakeTmp/src.c)
 	file(WRITE ${detect_page_size_file} "
@@ -254,6 +261,13 @@ int main() {
 endfunction()
 
 function(detect_cache_line_size)
+	# Cross builds cannot execute the target probe. Allow the package to supply
+	# the known target cache line size instead.
+	if(DEFINED HOST_CACHE_LINE_SIZE)
+		message(STATUS "Host cache line size (preset): ${HOST_CACHE_LINE_SIZE}")
+		return()
+	endif()
+
 	message(STATUS "Determining host cache line size")
 	set(detect_cache_line_size_file ${CMAKE_BINARY_DIR}${CMAKE_FILES_DIRECTORY}/CMakeTmp/src.c)
 	file(WRITE ${detect_cache_line_size_file} "
-- 
2.50.1

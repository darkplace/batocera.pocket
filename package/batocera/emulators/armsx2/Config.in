config BR2_PACKAGE_ARMSX2
    bool "armsx2"
    depends on BR2_aarch64
    depends on BR2_PACKAGE_HAS_UDEV
    depends on BR2_PACKAGE_XORG7
    depends on BR2_PACKAGE_HAS_LIBGL || BR2_PACKAGE_BATOCERA_VULKAN
    depends on BR2_PACKAGE_BATOCERA_TARGET_SM8X50 || BR2_PACKAGE_BATOCERA_TARGET_SM8250 || BR2_PACKAGE_BATOCERA_TARGET_QCS6490 || BR2_PACKAGE_BATOCERA_TARGET_RK3588
    select BR2_PACKAGE_ALSA_LIB
    select BR2_PACKAGE_BATOCERA_QT6
    select BR2_PACKAGE_DBUS
    select BR2_PACKAGE_ECM
    select BR2_PACKAGE_FMT
    select BR2_PACKAGE_FONTCONFIG
    select BR2_PACKAGE_FREETYPE
    select BR2_PACKAGE_KDDOCKWIDGETS
    select BR2_PACKAGE_LIBAIO
    select BR2_PACKAGE_LIBBACKTRACE
    select BR2_PACKAGE_LIBCURL
    select BR2_PACKAGE_LIBGTK3
    select BR2_PACKAGE_LIBPCAP
    select BR2_PACKAGE_LIBPNG
    select BR2_PACKAGE_LIBSAMPLERATE
    select BR2_PACKAGE_LIBSOUNDTOUCH
    select BR2_PACKAGE_PLUTOSVG
    select BR2_PACKAGE_PORTAUDIO
    select BR2_PACKAGE_SDL3
    select BR2_PACKAGE_SDL3_OPENGLES if BR2_PACKAGE_HAS_LIBGLES
    select BR2_PACKAGE_SDL3_OPENGL if BR2_PACKAGE_HAS_LIBGL
    select BR2_PACKAGE_SDL3_X11
    select BR2_PACKAGE_SHADERC if BR2_PACKAGE_BATOCERA_VULKAN
    select BR2_PACKAGE_VULKAN_HEADERS if BR2_PACKAGE_BATOCERA_VULKAN
    select BR2_PACKAGE_VULKAN_LOADER if BR2_PACKAGE_BATOCERA_VULKAN
    select BR2_PACKAGE_WAYLAND_PROTOCOLS if BR2_PACKAGE_WAYLAND
    select BR2_PACKAGE_WEBP
    select BR2_PACKAGE_XLIB_LIBX11 if BR2_PACKAGE_XORG7
    select BR2_PACKAGE_XLIB_LIBXEXT if BR2_PACKAGE_XORG7
    select BR2_PACKAGE_XLIB_LIBXI if BR2_PACKAGE_XORG7
    select BR2_PACKAGE_XLIB_LIBXRANDR if BR2_PACKAGE_XORG7
    select BR2_PACKAGE_XLIB_LIBXRENDER if BR2_PACKAGE_XORG7
    select BR2_PACKAGE_WXWIDGETS
    select BR2_PACKAGE_YAML_CPP
    select BR2_PACKAGE_ZLIB
    help
      ARMSX2 is a PCSX2 fork with a native ARM64 JIT for PlayStation 2 emulation.

      https://github.com/ARMSX2/ARMSX2

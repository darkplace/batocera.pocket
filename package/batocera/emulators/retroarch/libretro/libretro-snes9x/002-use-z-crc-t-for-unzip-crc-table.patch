diff --git a/unzip/crypt.h b/unzip/crypt.h
index 7219381..3cf0ffd 100644
--- a/unzip/crypt.h
+++ b/unzip/crypt.h
@@ -32,7 +32,7 @@
 /***********************************************************************
  * Return the next byte in the pseudo-random sequence
  */
-static int decrypt_byte(unsigned long* pkeys, const unsigned long* pcrc_32_tab)

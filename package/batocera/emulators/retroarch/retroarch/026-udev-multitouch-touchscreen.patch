+static void udev_touch_set_identity_calibration(udev_input_touch_t *touch)
+{
+   touch->calibration_enabled   = false;
+   touch->calibration_matrix[0] = 1.0f;
+   touch->calibration_matrix[1] = 0.0f;
+   touch->calibration_matrix[2] = 0.0f;
+   touch->calibration_matrix[3] = 0.0f;
+   touch->calibration_matrix[4] = 1.0f;
+   touch->calibration_matrix[5] = 0.0f;
+}
+
+static void udev_touch_read_calibration(struct udev *udev,
+      udev_input_touch_t *touch, dev_t devnum)
+{
+   struct udev_device *udev_dev = NULL;
+   const char *matrix           = NULL;
+   float values[6];
+
+   udev_touch_set_identity_calibration(touch);
+
+   if (!udev)
+      return;
+
+   udev_dev = udev_device_new_from_devnum(udev, 'c', devnum);
+   if (!udev_dev)
+      return;
+
+   matrix = udev_device_get_property_value(
+         udev_dev, "LIBINPUT_CALIBRATION_MATRIX");
+   if (matrix && sscanf(matrix, "%f %f %f %f %f %f",
+            &values[0], &values[1], &values[2],
+            &values[3], &values[4], &values[5]) == 6)
+   {
+      memcpy(touch->calibration_matrix, values, sizeof(values));
+      touch->calibration_enabled = true;
+      RARCH_DBG("[udev] Touch calibration matrix: %s\n", matrix);
+   }
+
+   udev_device_unref(udev_dev);
+}

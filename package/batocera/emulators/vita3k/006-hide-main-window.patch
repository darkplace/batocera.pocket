From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Thu, 16 Jul 2026 00:00:00 +000
Subject: [PATCH] qt: hide the main window while a game is active

---
diff --git a/vita3k/gui-qt/src/main_window.cpp b/vita3k/gui-qt/src/main_window.cpp
index 4701380..6fcfe65 100644
--- a/vita3k/gui-qt/src/main_window.cpp
+++ b/vita3k/gui-qt/src/main_window.cpp
@@ -252,6 +252,7 @@ void MainWindow::closeEvent(QCloseEvent *event) {
 
     save_window_state();
     QMainWindow::closeEvent(event);
+    qApp->quit();
 }
 
 void MainWindow::paintEvent(QPaintEvent *event) {
@@ -423,6 +424,7 @@ void MainWindow::initialize() {
     connect(m_sdl_pump_timer, &QTimer::timeout, this, &MainWindow::pump_sdl_events);
     m_sdl_pump_timer->start();
 
+    qApp->setQuitOnLastWindowClosed(false);
     setup_toolbar();
 
     connect(m_ui->welcome_dialog_action, &QAction::triggered, this, [this]() {
@@ -1047,6 +1049,9 @@ std::optional<AppLaunchRequest> MainWindow::boot_game_once(const AppLaunchReques
     if (m_settings_dialog)
         m_settings_dialog->set_storage_path_locked(true);
     refresh_emulation_actions();
     refresh_status_bar();
+
+    // Only show the game window while a game is running.
+    hide();
     return std::nullopt;
 }
 
@@ -1088,6 +1093,7 @@ void MainWindow::on_game_closed() {
     refresh_status_bar();
 
     if (!m_is_app_closing) {
+        show();
         raise();
         activateWindow();
     }
@@ -1210,6 +1216,9 @@ void MainWindow::show_live_area(const std::string &title_id) {
     m_fullscreen = emuenv.cfg.boot_apps_full_screen;
     m_ui->toolbar_fullscreen->setIcon(m_fullscreen ? m_icon_fullscreen_off : m_icon_fullscreen_on);
     m_ui->toolbar_fullscreen->setText(m_fullscreen ? tr("Exit Fullscreen") : tr("Fullscreen"));
 
+    // Only show the LiveArea window while it is active.
+    hide();
+
     connect(m_live_area_widget, &LiveAreaWidget::play_clicked,
         this, &MainWindow::on_live_area_play);
 }
@@ -1239,6 +1248,7 @@ void MainWindow::on_live_area_closed() {
         delete closed_window;
 
     if (!m_is_app_closing) {
+        show();
         raise();
         activateWindow();
     }

#!/bin/sh

CALIBRATION="/userdata/system/configs/rsinput/rsinput-calibration.conf"
GPCAL_AUTOSTART="/userdata/system/.config/autostart/GPcal.sh"
PARAM_DIR="/sys/module/rsinput/parameters"
LOG="/userdata/system/logs/gamepadcalibration.log"
LAUNCHER_SRC="/usr/share/gpcal/launcher/Gamepad_Calibration.sh"
LAUNCHER_ICON_SRC="/usr/share/gpcal/launcher/images/gamepad-calibration.svg"
LAUNCHER_DST="/userdata/roms/emulator/Gamepad_Calibration.sh"
LAUNCHER_ICON_DST="/userdata/roms/emulator/images/gamepad-calibration.svg"
LAUNCHER_GAMELIST="/userdata/roms/emulator/gamelist.xml"

ensure_launcher() {
	mkdir -p /userdata/roms/emulator/images

	if [ -f "${LAUNCHER_SRC}" ]; then
		cp -f "${LAUNCHER_SRC}" "${LAUNCHER_DST}" 2>/dev/null || true
		chmod 0755 "${LAUNCHER_DST}" 2>/dev/null || true
	fi

	if [ -f "${LAUNCHER_ICON_SRC}" ]; then
		cp -f "${LAUNCHER_ICON_SRC}" "${LAUNCHER_ICON_DST}" 2>/dev/null || true
	fi

	if [ ! -f "${LAUNCHER_GAMELIST}" ]; then
		cat > "${LAUNCHER_GAMELIST}" <<'EOF'
<?xml version="1.0"?>
<gameList>
</gameList>
EOF
	fi

	if ! grep -q './Gamepad_Calibration.sh' "${LAUNCHER_GAMELIST}" 2>/dev/null; then
		awk '/<\/gameList>/ {
			print "  <game>";
			print "    <path>./Gamepad_Calibration.sh</path>";
			print "    <name>Gamepad Calibration</name>";
			print "    <image>./images/gamepad-calibration.svg</image>";
			print "  </game>";
		} { print }' "${LAUNCHER_GAMELIST}" > "${LAUNCHER_GAMELIST}.tmp" &&
			mv "${LAUNCHER_GAMELIST}.tmp" "${LAUNCHER_GAMELIST}"
	fi
}

apply_calibration() {
	local key
	local value
	local i

	if [ ! -f "${CALIBRATION}" ] && [ ! -f "${GPCAL_AUTOSTART}" ]; then
		return 0
	fi

	mkdir -p "$(dirname "${LOG}")"
	for i in $(seq 1 20); do
		[ -d "${PARAM_DIR}" ] && break
		sleep 0.25
	done

	if [ ! -d "${PARAM_DIR}" ]; then
		echo "RSInput calibration parameters are not available at ${PARAM_DIR}" >> "${LOG}"
		return 0
	fi

	if [ -f "${CALIBRATION}" ]; then
		echo "Applying RSInput gamepad calibration from ${CALIBRATION}" >> "${LOG}"
		while IFS='=' read -r key value; do
			case "${key}" in
				''|\#*)
					continue
					;;
			esac

			if ! valid_calibration_key "${key}"; then
				echo "Ignoring unknown RSInput calibration key: ${key}" >> "${LOG}"
				continue
			fi

			write_calibration_value "${key}" "${value}"
		done < "${CALIBRATION}"
	fi

	if [ -f "${GPCAL_AUTOSTART}" ]; then
		echo "Applying RSInput gamepad calibration from ${GPCAL_AUTOSTART}" >> "${LOG}"
		apply_gpcal_autostart
	fi
}

valid_calibration_key() {
	case "$1" in
		axis_leftx_min|axis_leftx_max|axis_leftx_center|axis_leftx_deadzone|axis_leftx_antideadzone|\
		axis_lefty_min|axis_lefty_max|axis_lefty_center|axis_lefty_deadzone|axis_lefty_antideadzone|\
		axis_rightx_min|axis_rightx_max|axis_rightx_center|axis_rightx_deadzone|axis_rightx_antideadzone|\
		axis_righty_min|axis_righty_max|axis_righty_center|axis_righty_deadzone|axis_righty_antideadzone|\
		trigger_left_max|trigger_left_deadzone|trigger_left_antideadzone|\
		trigger_right_max|trigger_right_deadzone|trigger_right_antideadzone|\
		update_params)
			return 0
			;;
	esac

	return 1
}

write_calibration_value() {
	local key="$1"
	local value="$2"
	local num

	valid_calibration_key "${key}" || return 0

	num="${value#-}"
	case "${num}" in
		''|*[!0-9]*)
			echo "Ignoring invalid RSInput calibration value: ${key}=${value}" >> "${LOG}"
			return 0
			;;
	esac

	[ -w "${PARAM_DIR}/${key}" ] || return 0
	printf '%s' "${value}" > "${PARAM_DIR}/${key}" 2>> "${LOG}" || true
}

apply_gpcal_autostart() {
	local cmd
	local value
	local redirect
	local target
	local extra
	local key

	while read -r cmd value redirect target extra; do
		[ "${cmd}" = "echo" ] || continue
		[ "${redirect}" = ">" ] || continue
		[ -z "${extra}" ] || continue
		case "${target}" in
			"${PARAM_DIR}"/*)
				key="${target##*/}"
				write_calibration_value "${key}" "${value}"
				;;
		esac
	done < "${GPCAL_AUTOSTART}"
}

case "$1" in
	start|restart|reload)
		ensure_launcher
		apply_calibration
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac

exit 0

# Ayn Odin 3 default values

# Preferred output
global.videooutput=DSI-1

# Rotate DRM for splash
display.rotate.DSI=1

# Rotate Wayland/Sway
display.rotate.DSI-1=1

# The UCM profile has mutually exclusive Headphones and DisplayPort variants.
# Let the Odin 3 display/audio hotplug helper select the matching variant.
audio.profile=auto

# Default settings
display.brightness=60

# OLED Screen Protection — pixel refresher only on Odin 3 (no mura sysfs / shifter hook)
#display.oledcare=0
#display.oledcare.detect=1
#display.oledcare.static_timeout=30
#display.oledcare.refresher=1
#display.oledcare.refresher_duration=3
#display.oledcare.refresher_passes=3

system.battery.charge_limit=100

# CPU scaling governor. Mainline schedutil keeps the mid cluster pinned near max
# at idle on this SoC (Android's WALT/Perf-HAL tuning is not ported), wasting
# power and heat. ondemand scales down properly at idle and pairs with the quiet
# auto fan curve. Users can still override to performance/schedutil in the menu.
system.cpu.governor=ondemand

global.hud_custom=position=bottom-left\nbackground_alpha=0.9\nlegacy_layout=false\ncustom_text=%GAMENAME%\ncustom_text=%SYSTEMNAME%\ncustom_text=%EMULATORCORE%\nfps\ngpu_name\nengine_version\nvulkan_driver\nresolution\nram\ngpu_stats\nncpu_stats\ncpu_temp\ncore_load\nbattery_icon\nbattery_watt\ngpu_core_clock

# default suspend on handled boards
system.suspendmode=suspend

# Retroid Pocket Mini V2 default values

# DRM rotation
display.rotate.DSI=1

# Wayland output rotation (Sway/LabWC)
display.rotate.DSI-1=1

# default suspend on handled boards
system.suspendmode=suspend

# CPU scaling governor. Mainline schedutil keeps the mid cluster pinned near max
# at idle on this SoC (Android's WALT/Perf-HAL tuning is not ported), wasting
# power and heat. ondemand scales down properly at idle and pairs with the quiet
# auto fan curve. Users can still override to performance/schedutil in the menu.
system.cpu.governor=ondemand

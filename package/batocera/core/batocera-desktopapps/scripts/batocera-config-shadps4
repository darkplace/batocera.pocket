#!/bin/bash


# Enlarge toolkit UI on handhelds; keep native 1080p framebuffer.
command -v batocera-ui-scale >/dev/null 2>&1 && eval "$(batocera-ui-scale env)"
if test -z "${DISPLAY}"
then
    export DISPLAY=$(getLocalXDisplay)
fi

# Define the directory paths
configPath="/userdata/system/configs/shadps4"
dlcPath="/userdata/roms/ps4/DLC"

# Check if the directory exists, and create it if it doesn't
if [ ! -d "$configPath" ]; then
    mkdir -p "$configPath"
    if [ $? -eq 0 ]; then
        echo "Directory created successfully."
    else
        echo "Failed to create directory."
        exit 1
    fi
fi

if [ ! -d "$dlcPath" ]; then
    mkdir -p "$dlcPath"
    if [ $? -eq 0 ]; then
        echo "Directory created successfully."
    else
        echo "Failed to create directory."
        exit 1
    fi
fi

# Nested emulatorlauncher -rom config clears outer evmapy stick→mouse and has
# no pad args to rebuild it. Use pad mouse-mode for this config UI session.
restore_pad_mouse() {
    command -v batocera-mouse-mode >/dev/null 2>&1 && batocera-mouse-mode disable >/dev/null 2>&1 || true
    command -v batocera-mouse >/dev/null 2>&1 && batocera-mouse hide >/dev/null 2>&1 || true
}
trap restore_pad_mouse EXIT HUP INT TERM
command -v batocera-mouse >/dev/null 2>&1 && batocera-mouse show >/dev/null 2>&1 || true
command -v batocera-mouse-mode >/dev/null 2>&1 && batocera-mouse-mode enable >/dev/null 2>&1 || true

# Re-assert after nested gameStart hooks (they used to kill mouse-mode).
(
    sleep 1
    command -v batocera-mouse >/dev/null 2>&1 && batocera-mouse show >/dev/null 2>&1 || true
    command -v batocera-mouse-mode >/dev/null 2>&1 && batocera-mouse-mode enable >/dev/null 2>&1 || true
) &

emulatorlauncher -system ps4 -rom config -emulator shadps4
rc=$?
restore_pad_mouse
trap - EXIT HUP INT TERM
exit "${rc}"

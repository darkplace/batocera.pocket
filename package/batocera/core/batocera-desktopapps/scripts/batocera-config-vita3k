#!/bin/bash


# Enlarge toolkit UI on handhelds; keep native 1080p framebuffer.
command -v batocera-ui-scale >/dev/null 2>&1 && eval "$(batocera-ui-scale env)"
if test -z "${DISPLAY}"
then
    export DISPLAY=$(getLocalXDisplay)
fi

# set the environment variables
XDG_CONFIG_HOME=$CFGDIR \
XDG_CACHE_HOME=/userdata/system/cache \
XDG_DATA_HOME=/userdata/saves \
XDG_DATA_DIRS=/userdata/saves \
# now run the emulator
/usr/bin/vita3k/Vita3K -F

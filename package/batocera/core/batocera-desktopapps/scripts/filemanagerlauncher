#!/bin/bash

export XDG_MENU_PREFIX=batocera-
export XDG_CONFIG_DIRS=/etc/xdg

# fix for exfat on HOME + pcmanfm
export XDG_CACHE_HOME=/tmp/xdg_cache

# Fix xterm via F4 is not previously set up
python << EOF
import configparser
F = '/userdata/system/.config/libfm/libfm.conf'
c = configparser.ConfigParser()
c.read(F)
try:
   t = c['config']['terminal']
except:
   t = None
if (not t or t == ''):
   with open(F, 'w') as wf:
     c['config']['terminal'] = 'xterm'
     c.write(wf)
EOF

# Enlarge toolkit UI on handhelds; keep native 1080p framebuffer.
command -v batocera-ui-scale >/dev/null 2>&1 && eval "$(batocera-ui-scale env)"

restore_mouse() {
    command -v batocera-mouse-mode >/dev/null 2>&1 && batocera-mouse-mode disable >/dev/null 2>&1 || true
    batocera-mouse hide
}
trap restore_mouse EXIT HUP INT TERM

batocera-backglass disable
# F1 has no evmapy stick→mouse mapping; enable pad mouse-mode for the session.
batocera-mouse show
if command -v batocera-mouse-mode >/dev/null 2>&1; then
    batocera-mouse-mode enable >/dev/null 2>&1 || true
fi
DISPLAY=${DISPLAY:-:0.0} pcmanfm /userdata
restore_mouse
trap - EXIT HUP INT TERM
batocera-backglass enable

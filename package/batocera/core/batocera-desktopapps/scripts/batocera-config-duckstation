#!/bin/bash


# Enlarge toolkit UI on handhelds; keep native 1080p framebuffer.
command -v batocera-ui-scale >/dev/null 2>&1 && eval "$(batocera-ui-scale env)"
# Check if DISPLAY is not set
if [ -z "${DISPLAY}" ]; then
    DISPLAY=$(getLocalXDisplay)
fi

# Check if Wayland is available
if [ -n "${WAYLAND_DISPLAY}" ]; then
    QT_QPA_PLATFORM=wayland
else
    QT_QPA_PLATFORM=xcb
fi

XDG_CONFIG_HOME=/userdata/system/configs \
LD_LIBRARY_PATH=/usr/stenzek-shaderc/lib:/usr/lib \
QT_QPA_PLATFORM="$QT_QPA_PLATFORM" \
batocera-config-gpu-wrapper /usr/bin/duckstation-qt

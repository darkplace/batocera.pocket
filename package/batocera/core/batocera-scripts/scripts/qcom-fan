#!/usr/bin/env python3
"""
Qualcomm PWM fan helper for Batocera.

Automatic fan modes (selectable from the Batocera Control Deck / CLI):
  qcom-fan silent      quiet-first curve (higher temps, minimal noise)
  qcom-fan auto        balanced default
  qcom-fan aggressive  cool-first curve (spins earlier/harder)
  qcom-fan manual / set N   fixed speed
  qcom-fan stop        fan off

The default automatic curve can be overridden in:
  /userdata/system/configs/fan.conf

# temperatures are in Celsius
# fan speeds are from 0-100 percent of max speed
# syntax is: temp_threshold=fan_speed
# default (handheld-friendly: quiet under normal emulation, stays <=40%
# until ~72C, only ramps hard near the thermal ceiling):
# 48=0
# 56=15
# 64=25
# 72=40
# 80=55
# 85=80
# 90=100

The chosen mode/speed is persisted across reboots in:
  /userdata/system/configs/fan.state
so `qcom-fan boot` (run from the init script) can restore what the user last
selected (auto / manual N% / off) instead of always forcing auto.
"""

import glob
import json
import os
import signal
import subprocess
import sys
import time

DEBUG = 0
# Poll quickly: Control Deck / load spikes can jump 40C+ in a second. A 15s
# interval left the fan stuck low while the UI already showed dangerous temps.
CHECK_INTERVAL = 1
CHECK_INTERVAL_HOT = 1
HOT_TEMP_C = 65
MANUAL_INTERVAL = 0.2
# At early boot the hwmon/cooling fan node may not be registered/writable yet
# when the init script fires. Poll for it this long (seconds) before giving up,
# so the auto daemon survives the boot race instead of dying and falling back
# to a stale manual PWM. Init should run after S11share (S12qcom-fan); we still
# wait for /userdata/system so fan.state / fan.conf are readable before the
# first curve decision.
READY_TIMEOUT = 60
READY_INTERVAL = 1
USERDATA_WAIT_TIMEOUT = 60
# Fast-rise / slow-fall control temperature. Opening Control Deck spikes cores
# to 80-100C then the reading collapses to ~50-60C within seconds; without
# hold the fan drops to near-idle while the UI still shows "hot". Hold the
# peak briefly, then decay slowly so cooling stays on until the SoC is actually
# comfortable again.
TEMP_RISE_ALPHA = 0.7
TEMP_FALL_ALPHA = 0.08
TEMP_PEAK_HOLD_S = 12
CONFIG_FILE = "/userdata/system/configs/fan.conf"
STATE_FILE = "/userdata/system/configs/fan.state"
PID_FILE = "/var/run/qcom-fan.pid"
MANUAL_PID_FILE = "/var/run/qcom-fan-manual.pid"
MANUAL_TARGET_FILE = "/var/run/qcom-fan.manual"
PWM_MAX = 255
# Named automatic fan curves selectable from the Control Deck / CLI. Each curve
# is a list of "temp=percent" high -> low thresholds (get_fanspeed returns the
# first entry whose temp is reached).
#   - silent:     prioritise noise; stays off until it's genuinely warm and
#                 never screams. Accepts slightly higher idle/light-load temps.
#   - auto:       balanced default (quiet under typical emulation, ramps hard
#                 only near the thermal ceiling).
#   - aggressive: prioritise temps; clearly audible from ~40C and strong by
#                 ~55-60C so a "hot" Control Deck reading never pairs with a
#                 near-idle fan.
FAN_CURVES = {
    "silent":     ["92=100", "86=65", "80=40", "74=22", "66=10", "58=0"],
    "auto":       ["90=100", "85=80", "80=55", "72=40", "64=25", "56=15", "48=0"],
    # Tuned for handheld UX: at ~60C the fan must be obviously running.
    "aggressive": ["75=100", "68=90", "60=75", "52=55", "45=40", "38=25", "32=15"],
}
# Modes that run the automatic (curve-driven) daemon.
AUTO_MODES = ("auto", "silent", "aggressive")
# Back-compat alias: the plain automatic curve.
DEFAULT_FAN_CONFIG = FAN_CURVES["auto"]


def read_file(path):
    try:
        with open(path, "r") as fp:
            return fp.read().strip()
    except Exception:
        return ""


def write_file(path, value):
    with open(path, "w") as fp:
        fp.write(str(value))


def save_state(mode, target=None):
    """Persist the user's fan choice so it survives reboots.

    mode: "auto" | "manual" | "off"
    target: percent (only meaningful for "manual")
    """
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        lines = ["mode={}".format(mode)]
        if mode == "manual" and target is not None:
            lines.append("target={}".format(int(clamp(int(target), 0, 100))))
        write_file(STATE_FILE, "\n".join(lines) + "\n")
    except Exception:
        pass


def load_state():
    mode = None
    target = None
    try:
        with open(STATE_FILE, "r") as fp:
            for line in fp:
                line = line.strip()
                if not line or line[0] == "#" or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                key = key.strip()
                value = value.strip()
                if key == "mode":
                    mode = value
                elif key == "target":
                    target = parse_int(value)
    except Exception:
        pass
    return mode, target


def parse_int(value):
    try:
        return int(str(value).strip())
    except Exception:
        return None


def clamp(value, minimum, maximum):
    return max(minimum, min(maximum, value))


def is_writable(path):
    return bool(path and os.path.exists(path) and os.access(path, os.W_OK))


def get_fanspeed(tempval, configlist):
    for curconfig in configlist:
        curpair = curconfig.split("=")
        tempcfg = float(curpair[0])
        fancfg = int(float(curpair[1]))
        if tempval >= tempcfg:
            return fancfg
    return 0


def load_config(fname):
    newconfig = []
    try:
        with open(fname, "r") as fp:
            for curline in fp:
                tmpline = curline.strip()
                if not tmpline or tmpline[0] == "#":
                    continue
                tmppair = tmpline.split("=")
                if len(tmppair) != 2:
                    continue
                try:
                    tempval = float(tmppair[0])
                    fanval = int(float(tmppair[1]))
                except Exception:
                    continue
                if tempval < 0 or tempval > 100 or fanval < 0 or fanval > 100:
                    continue
                newconfig.append("{:5.1f}={}".format(tempval, fanval))
        if newconfig:
            newconfig.sort(reverse=True)
    except Exception:
        return []
    return newconfig


def find_hwmon_fan():
    candidates = []
    for base in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        fan_inputs = sorted(glob.glob(os.path.join(base, "fan*_input")))
        pwms = [
            path for path in sorted(glob.glob(os.path.join(base, "pwm[0-9]*")))
            if not path.endswith("_enable")
        ]
        if not fan_inputs and not pwms:
            continue
        name = read_file(os.path.join(base, "name"))
        score = 0
        if "fan" in name.lower():
            score += 20
        if fan_inputs:
            score += 5
        if pwms:
            score += 5
        if any(is_writable(path) for path in pwms):
            score += 5
        candidates.append({
            "score": score,
            "base": base,
            "name": name,
            "fan_inputs": fan_inputs,
            "pwms": pwms,
        })
    if not candidates:
        return None
    candidates.sort(key=lambda item: item["score"], reverse=True)
    return candidates[0]


def find_cooling_fan():
    candidates = []
    for base in sorted(glob.glob("/sys/class/thermal/cooling_device*")):
        ctype = read_file(os.path.join(base, "type"))
        if "fan" not in ctype.lower():
            continue
        cur_path = os.path.join(base, "cur_state")
        max_path = os.path.join(base, "max_state")
        if not os.path.exists(cur_path) or not os.path.exists(max_path):
            continue
        candidates.append({"base": base, "type": ctype, "cur": cur_path, "max": max_path})
    return candidates[0] if candidates else None


def get_temp():
    temps = []
    for path in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
        value = parse_int(read_file(path))
        if value is None:
            continue
        if value > 1000:
            value = value / 1000
        if value > 0:
            temps.append(float(value))
    return max(temps) if temps else None


def pid_matches_daemon(pid, modes=None):
    if pid == os.getpid():
        return False
    if modes is None:
        modes = ("start", "manual-daemon")
    try:
        with open("/proc/{}/cmdline".format(pid), "rb") as fp:
            raw = fp.read().decode("utf-8", "ignore")
    except Exception:
        return False
    tokens = [tok for tok in raw.split("\0") if tok]
    if not tokens:
        return False
    # Must be the actual helper (a token whose basename is exactly "qcom-fan"),
    # NOT the init script "/etc/init.d/S*qcom-fan" nor any unrelated process that
    # merely mentions the string. This is critical: at boot rcS runs
    # `/bin/sh /etc/init.d/S12qcom-fan start`, whose cmdline contains both
    # "qcom-fan" and the token "start", so the old substring match flagged the
    # init shell itself as a running "start" daemon -> start_daemon() bailed out
    # ("already running") and never spawned the real auto daemon.
    if not any(os.path.basename(tok) == "qcom-fan" for tok in tokens):
        return False
    return any(tok in modes for tok in tokens)


def daemon_pids(modes=None):
    pids = []
    for pidfile in (PID_FILE, MANUAL_PID_FILE):
        pid = parse_int(read_file(pidfile))
        if pid and pid_matches_daemon(pid, modes):
            pids.append(pid)
    for path in glob.glob("/proc/[0-9]*"):
        pid = parse_int(os.path.basename(path))
        if pid and pid not in pids and pid_matches_daemon(pid, modes):
            pids.append(pid)
    return pids


def auto_running():
    return len(daemon_pids(("start",))) > 0


def manual_running():
    return len(daemon_pids(("manual-daemon",))) > 0


def daemon_running():
    return auto_running() or manual_running()


def remove_path(path):
    try:
        os.unlink(path)
    except Exception:
        pass


def stop_daemon(reset_speed=False, modes=None):
    pids = daemon_pids(modes)
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        except Exception:
            pass
    deadline = time.time() + 2
    while time.time() < deadline and any(pid_matches_daemon(pid, modes) for pid in pids):
        time.sleep(0.05)
    for pid in pids:
        if pid_matches_daemon(pid, modes):
            try:
                os.kill(pid, signal.SIGKILL)
            except Exception:
                pass
    if modes is None or "start" in modes:
        remove_path(PID_FILE)
    if modes is None or "manual-daemon" in modes:
        remove_path(MANUAL_PID_FILE)
    if modes is None or "manual-daemon" in modes:
        remove_path(MANUAL_TARGET_FILE)
    if reset_speed:
        raw_set_speed(0, quiet=True)


def helper_path():
    return "/usr/bin/qcom-fan" if os.path.exists("/usr/bin/qcom-fan") else os.path.abspath(sys.argv[0])


def start_daemon():
    if auto_running():
        return True
    try:
        subprocess.Popen(
            [helper_path(), "start"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except Exception:
        return False


def start_manual_daemon(percent):
    write_file(MANUAL_TARGET_FILE, percent)
    if manual_running():
        return True
    try:
        subprocess.Popen(
            [helper_path(), "manual-daemon"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except Exception:
        return False


def read_status():
    hwmon = find_hwmon_fan()
    cooling = find_cooling_fan()
    rpm = None
    pwm = None
    percent = None
    enable = None
    control = False
    name = ""
    pwm_path = ""
    cooling_path = ""

    if hwmon:
        name = hwmon["name"] or os.path.basename(hwmon["base"])
        if hwmon["fan_inputs"]:
            rpm = parse_int(read_file(hwmon["fan_inputs"][0]))
        if hwmon["pwms"]:
            pwm_path = hwmon["pwms"][0]
            pwm = parse_int(read_file(pwm_path))
            if pwm is not None:
                percent = round(clamp(pwm, 0, PWM_MAX) * 100 / PWM_MAX)
            enable = parse_int(read_file(pwm_path + "_enable"))
            control = is_writable(pwm_path)

    if percent is None and cooling:
        cur = parse_int(read_file(cooling["cur"]))
        max_state = parse_int(read_file(cooling["max"]))
        if cur is not None and max_state and max_state > 0:
            percent = round(clamp(cur, 0, max_state) * 100 / max_state)
        control = control or is_writable(cooling["cur"])
        if not name:
            name = cooling["type"] or os.path.basename(cooling["base"])
        cooling_path = cooling["cur"]

    mode = ""
    manual_target = parse_int(read_file(MANUAL_TARGET_FILE))
    smode, _ = load_state()
    if auto_running():
        # Reflect the named auto curve (silent/auto/aggressive) so the Control
        # Deck and CLI can show/toggle the exact mode the user picked.
        mode = smode if smode in AUTO_MODES else "auto"
    elif manual_running() or manual_target is not None:
        mode = "manual"
    elif smode == "off":
        # User chose Off: keep reporting "off" even if pwm_enable still reads as
        # kernel "driver auto" (2) after we parked the PWM at 0.
        mode = "off"
    elif enable == 2:
        mode = "driver auto"
    elif control:
        mode = "manual"
    elif rpm is not None or percent is not None:
        mode = "read only"

    return {
        "available": bool(hwmon or cooling),
        "control": control,
        "name": name,
        "rpm": rpm,
        "pwm": pwm,
        "percent": percent,
        "mode": mode,
        "target_percent": manual_target,
        "pwm_path": pwm_path,
        "cooling_path": cooling_path,
    }


def format_label(status):
    parts = []
    if status.get("rpm") is not None:
        parts.append("{} RPM".format(status["rpm"]))
    if status.get("percent") is not None:
        parts.append("{}%".format(status["percent"]))
    if status.get("mode") == "manual" and status.get("target_percent") is not None:
        parts.append("target {}%".format(status["target_percent"]))
    if status.get("mode"):
        parts.append(status["mode"])
    return " ".join(parts) if parts else "N/A"


def parse_speed_value(value, current):
    try:
        if value.startswith(("+", "-")):
            percent = current + int(float(value))
        else:
            percent = int(float(value))
    except Exception:
        return None
    return clamp(percent, 0, 100)


def raw_set_speed(percent, quiet=False):
    status = read_status()
    if not status["available"] or not status["control"]:
        if not quiet:
            print("No writable fan control found.", file=sys.stderr)
        return 1

    percent = clamp(percent, 0, 100)
    if status.get("pwm_path") and is_writable(status["pwm_path"]):
        enable_path = status["pwm_path"] + "_enable"
        if is_writable(enable_path):
            try:
                write_file(enable_path, "2")
            except Exception:
                pass
        write_file(status["pwm_path"], round(percent * PWM_MAX / 100))
    elif status.get("cooling_path") and is_writable(status["cooling_path"]):
        max_state = parse_int(read_file(os.path.join(os.path.dirname(status["cooling_path"]), "max_state")))
        if not max_state or max_state <= 0:
            return 1
        write_file(status["cooling_path"], round(percent * max_state / 100))
    else:
        return 1

    if not quiet:
        print(percent)
    return 0


def manual_target():
    value = parse_int(read_file(MANUAL_TARGET_FILE))
    if value is None:
        return None
    return clamp(value, 0, 100)


def manual_check():
    write_file(MANUAL_PID_FILE, os.getpid())
    hwmon = find_hwmon_fan()
    cooling = find_cooling_fan()
    pwm_path = hwmon["pwms"][0] if hwmon and hwmon["pwms"] else ""
    enable_path = pwm_path + "_enable" if pwm_path else ""
    cooling_path = cooling["cur"] if cooling else ""
    max_state = parse_int(read_file(cooling["max"])) if cooling else None

    while True:
        target = manual_target()
        if target is None:
            return 0
        current = 0
        if pwm_path:
            pwm = parse_int(read_file(pwm_path))
            if pwm is not None:
                current = round(clamp(pwm, 0, PWM_MAX) * 100 / PWM_MAX)
        elif cooling_path and max_state and max_state > 0:
            cur_state = parse_int(read_file(cooling_path))
            if cur_state is not None:
                current = round(clamp(cur_state, 0, max_state) * 100 / max_state)

        if current < target:
            if pwm_path and is_writable(pwm_path):
                if is_writable(enable_path):
                    try:
                        write_file(enable_path, "2")
                    except Exception:
                        pass
                try:
                    write_file(pwm_path, round(target * PWM_MAX / 100))
                except Exception:
                    pass
            elif cooling_path and is_writable(cooling_path) and max_state and max_state > 0:
                try:
                    write_file(cooling_path, round(target * max_state / 100))
                except Exception:
                    pass
        time.sleep(MANUAL_INTERVAL)


def set_speed(value, stop_first=True, quiet=False):
    status = read_status()
    if not status["available"] or not status["control"]:
        if not quiet:
            print("No writable fan control found.", file=sys.stderr)
        return 1

    current = status["target_percent"] if status["target_percent"] is not None else status["percent"]
    current = current if current is not None else 0
    percent = parse_speed_value(value, current)
    if percent is None:
        if not quiet:
            print("Usage: qcom-fan set <0-100|+N|-N>", file=sys.stderr)
        return 1

    if stop_first:
        stop_daemon(reset_speed=False, modes=("start",))

    write_file(MANUAL_TARGET_FILE, percent)
    raw_set_speed(percent, quiet=True)
    if stop_first:
        start_manual_daemon(percent)
        save_state("manual", percent)

    if not quiet:
        print(percent)
    return 0


def userdata_ready():
    """True once batocera share is mounted and configs can be read/written."""
    return os.path.isdir("/userdata/system")


def wait_userdata(timeout=USERDATA_WAIT_TIMEOUT):
    waited = 0
    while not userdata_ready() and waited < timeout:
        time.sleep(READY_INTERVAL)
        waited += READY_INTERVAL
    return userdata_ready()


def active_curve():
    """Resolve the curve the auto daemon should follow.

    Priority: a user custom curve in fan.conf wins; otherwise the named curve
    for the persisted mode (silent/auto/aggressive); otherwise plain auto.
    """
    tmpconfig = load_config(CONFIG_FILE)
    if tmpconfig:
        return tmpconfig
    mode, _ = load_state()
    if mode in FAN_CURVES:
        return list(FAN_CURVES[mode])
    return list(FAN_CURVES["auto"])


def poll_sleep(temp_c, block, prevblock):
    """Always poll fast — thermal safety first on handhelds."""
    return CHECK_INTERVAL_HOT if (
        (temp_c is not None and temp_c >= HOT_TEMP_C) or block > prevblock
    ) else CHECK_INTERVAL


class TempTracker:
    """Instant on heat, slow to forget — matches what users see in Control Deck."""

    def __init__(self):
        self.smoothed = None
        self.peak = None
        self.peak_at = 0.0

    def update(self, current):
        now = time.time()
        if current is None:
            return self.smoothed
        if self.smoothed is None:
            self.smoothed = current
            self.peak = current
            self.peak_at = now
            return current
        if current >= self.smoothed:
            self.smoothed = (TEMP_RISE_ALPHA * current) + ((1.0 - TEMP_RISE_ALPHA) * self.smoothed)
        else:
            self.smoothed = (TEMP_FALL_ALPHA * current) + ((1.0 - TEMP_FALL_ALPHA) * self.smoothed)
        if self.peak is None or current >= self.peak:
            self.peak = current
            self.peak_at = now
        elif (now - self.peak_at) > TEMP_PEAK_HOLD_S:
            # After hold, decay peak toward smoothed.
            self.peak = max(self.smoothed, self.peak - 1.5)
            self.peak_at = now
        # Control on the higher of smoothed and held peak.
        return max(self.smoothed, self.peak if self.peak is not None else self.smoothed)


def temp_check():
    # Prefer reading fan.state after userdata is mounted (S11share). Init is
    # ordered as S12qcom-fan, but keep this wait so a misplaced early start
    # still picks up silent/aggressive instead of freezing on plain auto.
    wait_userdata()

    # Wait (bounded) for the fan control node to appear. Avoids the boot race
    # where init starts us before hwmon/cooling is registered, which used to
    # make the auto daemon exit immediately and leave the fan stuck.
    status = read_status()
    waited = 0
    while (not status["available"] or not status["control"]) and waited < READY_TIMEOUT:
        time.sleep(READY_INTERVAL)
        waited += READY_INTERVAL
        status = read_status()
    if not status["available"] or not status["control"]:
        print("Error: no writable fan control found.", file=sys.stderr)
        return 1

    tracker = TempTracker()
    prevblock = 0
    while True:
        # Re-resolve every loop: fan.state may appear after a late userdata mount,
        # and Control Deck can change silent/auto/aggressive without restarting us.
        fanconfig = active_curve()
        raw = get_temp()
        if raw is None:
            time.sleep(CHECK_INTERVAL)
            continue
        val = tracker.update(raw)
        block = get_fanspeed(val, fanconfig)
        try:
            raw_set_speed(block, quiet=True)
            if DEBUG:
                print("Set fan speed {}% for temp {:5.1f}C (raw {:5.1f}C)".format(block, val, raw))
        except Exception:
            pass
        delay = poll_sleep(val, block, prevblock)
        prevblock = block
        time.sleep(delay)


def restore_boot_state():
    """Restore the last user selection at boot (called from the init script).

    Falls back to the automatic curve when no state is stored, so a fresh
    install behaves exactly like before.
    """
    wait_userdata()
    mode, target = load_state()
    if mode == "manual" and target is not None:
        return set_speed(str(int(clamp(int(target), 0, 100))), stop_first=True, quiet=True)
    if mode == "off":
        stop_daemon(reset_speed=True)
        return 0
    stop_daemon(reset_speed=False, modes=("manual-daemon",))
    return 0 if start_daemon() else 1


def write_pid():
    try:
        write_file(PID_FILE, os.getpid())
    except Exception:
        pass


def remove_pid(signum=None, frame=None):
    for path in (PID_FILE, MANUAL_PID_FILE):
        try:
            if parse_int(read_file(path)) == os.getpid():
                os.unlink(path)
        except Exception:
            pass
    sys.exit(0)


def print_temp():
    temp = get_temp()
    if temp is None:
        return 1
    print("Temp: {:5.1f}C".format(temp))
    return 0


def main():
    if len(sys.argv) == 1:
        return print_temp()

    command = sys.argv[1]
    if command == "start":
        stop_daemon(reset_speed=False, modes=("manual-daemon",))
        signal.signal(signal.SIGTERM, remove_pid)
        signal.signal(signal.SIGINT, remove_pid)
        write_pid()
        return temp_check()
    if command == "manual-daemon":
        stop_daemon(reset_speed=False, modes=("start",))
        signal.signal(signal.SIGTERM, remove_pid)
        signal.signal(signal.SIGINT, remove_pid)
        return manual_check()
    if command == "stop":
        stop_daemon(reset_speed=True)
        save_state("off")
        return 0
    if command == "daemon-stop":
        # Shutdown/reboot path (init S06 stop): just tear down the daemon WITHOUT
        # touching fan.state, so the user's persisted choice (auto / manual N% /
        # off) survives the next boot. `stop` above is the *user* "turn it off"
        # action and is the only one allowed to persist "off".
        stop_daemon(reset_speed=False)
        return 0
    if command == "manual":
        stop_daemon(reset_speed=False, modes=("start",))
        return 0
    if command in AUTO_MODES:
        # auto / silent / aggressive: persist the chosen curve then (re)spawn the
        # automatic daemon, which reads the mode back via active_curve().
        stop_daemon(reset_speed=False)
        save_state(command)
        ok = start_daemon()
        return 0 if ok else 1
    if command == "boot":
        return restore_boot_state()

    status = read_status()
    if command == "available":
        return 0 if status["available"] else 1
    if command in ("status", "label", "speed"):
        print(format_label(status))
        return 0 if status["available"] else 1
    if command == "json":
        print(json.dumps(status, sort_keys=True))
        return 0 if status["available"] else 1
    if command == "percent":
        if status["mode"] == "manual" and status["target_percent"] is not None:
            print(status["target_percent"])
            return 0
        if status["percent"] is None:
            return 1
        print(status["percent"])
        return 0
    if command == "rpm":
        if status["rpm"] is None:
            return 1
        print(status["rpm"])
        return 0
    if command == "mode":
        if not status["mode"]:
            return 1
        print(status["mode"])
        return 0
    if command == "set" and len(sys.argv) > 2:
        return set_speed(sys.argv[2])

    print("Usage: qcom-fan [start|boot|stop|daemon-stop|auto|silent|aggressive|manual|available|status|label|json|percent|rpm|mode|set <0-100|+N|-N>]", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())

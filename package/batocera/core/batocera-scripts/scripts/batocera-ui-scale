#!/bin/sh
# Resolve / apply a UI scale factor for desktop Tools / Apps on handhelds.
#
# Prefer Wayland-native scaling: temporarily raise the Sway *output* scale while
# a config UI / file manager runs, then restore it. Games keep scale 1.0.
#
# Toolkit env (QT_SCALE_FACTOR / GDK_*) is still exported for apps that honor
# it on Wayland (many Qt UIs). Do NOT force XWayland — that breaks OSK / mouse
# mode wired for native Wayland on Odin.
#
# Priority for the factor:
#   1. BATOCERA_UI_SCALE (env override)
#   2. system.ui.scale (batocera.conf)
#   3. global.dpi / 96 (batocera.conf)
#   4. board default (sm8550/sm8750 → 1.2)
#   5. 1.0
#
# Usage:
#   batocera-ui-scale              # print factor
#   batocera-ui-scale factor       # print factor
#   batocera-ui-scale env          # toolkit exports only (no compositor change)
#   batocera-ui-scale chromium-arg # --force-device-scale-factor=N if >1
#   batocera-ui-scale push-output  # raise Sway output scale (refcount)
#   batocera-ui-scale pop-output   # restore when last pusher exits
#   batocera-ui-scale begin        # push-output + compositor-safe env (no QT double-scale)

set -eu

STATE_FILE="${BATOCERA_UI_SCALE_STATE:-/var/run/batocera-ui-scale.output}"

is_handheld_board() {
    arch=""
    if [ -r /usr/share/batocera/batocera.arch ]; then
        arch="$(tr -d '\0\r\n' </usr/share/batocera/batocera.arch 2>/dev/null || true)"
    fi
    case "${arch}" in
        sm8550|sm8750|sm8250|qcs6490)
            return 0
            ;;
    esac

    model=""
    compatible=""
    if [ -r /sys/firmware/devicetree/base/model ]; then
        model="$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null || true)"
    fi
    if [ -r /sys/firmware/devicetree/base/compatible ]; then
        compatible="$(tr -d '\0' </sys/firmware/devicetree/base/compatible 2>/dev/null || true)"
    fi
    case "${model} ${compatible}" in
        *"AYN Odin"*|*"ayn,odin"*|*"AYN Thor"*|*"ayn,thor"*|*"Retroid"*|*"retroid"*)
            return 0
            ;;
    esac
    return 1
}

conf_get() {
    key="$1"
    if command -v batocera-settings-get >/dev/null 2>&1; then
        batocera-settings-get "${key}" 2>/dev/null || true
    fi
}

normalize_factor() {
    printf '%s' "$1" | grep -Eq '^[0-9]+([.][0-9]+)?$' || return 1
    awk -v s="$1" 'BEGIN {
        if (s+0 < 1) s=1
        if (s+0 > 3) s=3
        printf "%g\n", s+0
    }'
}

resolve_factor() {
    val=""

    if [ -n "${BATOCERA_UI_SCALE:-}" ]; then
        val="${BATOCERA_UI_SCALE}"
    else
        val="$(conf_get system.ui.scale)"
    fi

    if [ -z "${val}" ]; then
        dpi="$(conf_get global.dpi)"
        if printf '%s' "${dpi}" | grep -Eq '^[0-9]+([.][0-9]+)?$'; then
            val="$(awk -v d="${dpi}" 'BEGIN { printf "%g\n", (d+0)/96.0 }')"
        fi
    fi

    if [ -z "${val}" ] && is_handheld_board; then
        # ~1080p on a ~6–7" panel: mild enlarge for touch without clipping Qt menus.
        val="1.2"
    fi

    if [ -z "${val}" ]; then
        val="1"
    fi

    normalize_factor "${val}" || echo "1"
}

gdk_pair_for() {
    factor="$1"
    awk -v s="${factor}" 'BEGIN {
        if (s+0 <= 1.01) { print "1 1"; exit }
        g = int(s+0.999999)
        if (g < 1) g = 1
        if (g > 3) g = 3
        dpi = s / g
        printf "%d %g\n", g, dpi
    }'
}

print_env() {
    # mode: toolkit (default) | compositor
    # compositor = Sway output already scaled; do NOT also set QT/GDK scale
    # or Qt menus become ~factor² and unusable on handhelds.
    mode="${1:-toolkit}"
    factor="$(resolve_factor)"

    printf 'export BATOCERA_UI_SCALE=%s\n' "${factor}"

    if [ "${mode}" = "compositor" ]; then
        # Neutralize leaked toolkit scale from a parent shell.
        printf 'export QT_SCALE_FACTOR=1\n'
        printf 'export QT_AUTO_SCREEN_SCALE_FACTOR=0\n'
        printf 'unset QT_FONT_DPI\n'
        printf 'unset GDK_SCALE\n'
        printf 'unset GDK_DPI_SCALE\n'
        printf 'export BATOCERA_ARCH_PLASMA_OUTPUT_SCALE=%s\n' "${factor}"
        return 0
    fi

    gdk="$(gdk_pair_for "${factor}")"
    gdk_scale="$(printf '%s' "${gdk}" | awk '{print $1}')"
    gdk_dpi="$(printf '%s' "${gdk}" | awk '{print $2}')"

    # Toolkit-only path (no sway push): used by Chromium args / legacy callers.
    if [ -z "${QT_SCALE_FACTOR:-}" ]; then
        printf 'export QT_SCALE_FACTOR=%s\n' "${factor}"
        printf 'export QT_AUTO_SCREEN_SCALE_FACTOR=0\n'
        printf 'export QT_ENABLE_HIGHDPI_SCALING=1\n'
    fi
    if [ -z "${QT_FONT_DPI:-}" ]; then
        qt_dpi="$(awk -v s="${factor}" 'BEGIN { printf "%d\n", (s+0)*96 }')"
        printf 'export QT_FONT_DPI=%s\n' "${qt_dpi}"
    fi
    if [ -z "${GDK_SCALE:-}" ]; then
        printf 'export GDK_SCALE=%s\n' "${gdk_scale}"
    fi
    if [ -z "${GDK_DPI_SCALE:-}" ]; then
        printf 'export GDK_DPI_SCALE=%s\n' "${gdk_dpi}"
    fi
    if [ -z "${BATOCERA_ARCH_PLASMA_OUTPUT_SCALE:-}" ]; then
        printf 'export BATOCERA_ARCH_PLASMA_OUTPUT_SCALE=%s\n' "${factor}"
    fi
}

print_chromium_arg() {
    factor="$(resolve_factor)"
    awk -v s="${factor}" 'BEGIN {
        if (s+0 > 1.01)
            printf "--force-device-scale-factor=%g\n", s+0
    }'
}

ensure_swaysock() {
    if [ -n "${SWAYSOCK:-}" ] && [ -S "${SWAYSOCK}" ]; then
        return 0
    fi
    # SSH / ES child envs often omit SWAYSOCK; Batocera keeps the IPC under /run.
    for cand in \
        /run/sway-ipc.0.sock \
        /run/sway-ipc.sock \
        /var/run/sway-ipc.0.sock \
        /var/run/sway-ipc.sock
    do
        if [ -S "${cand}" ]; then
            SWAYSOCK="${cand}"
            export SWAYSOCK
            return 0
        fi
    done
    # Last resort: any sway-ipc socket.
    for cand in /run/sway-ipc.*.sock /var/run/sway-ipc.*.sock; do
        if [ -S "${cand}" ]; then
            SWAYSOCK="${cand}"
            export SWAYSOCK
            return 0
        fi
    done
    return 1
}

sway_ready() {
    command -v swaymsg >/dev/null 2>&1 || return 1
    ensure_swaysock
}

focused_output() {
    swaymsg -t get_outputs 2>/dev/null | python3 -c '
import json,sys
try:
    outs=json.load(sys.stdin)
except Exception:
    sys.exit(1)
for o in outs:
    if o.get("focused"):
        print(o.get("name",""))
        sys.exit(0)
for o in outs:
    if o.get("active"):
        print(o.get("name",""))
        sys.exit(0)
' 2>/dev/null || true
}

current_output_scale() {
    output="$1"
    swaymsg -t get_outputs 2>/dev/null | python3 -c '
import json,sys
name=sys.argv[1]
outs=json.load(sys.stdin)
for o in outs:
    if o.get("name")==name:
        print(o.get("scale",1))
        break
' "${output}" 2>/dev/null || echo "1"
}

read_state() {
    OUTPUT=""
    PREV_SCALE="1"
    DEPTH="0"
    if [ -f "${STATE_FILE}" ]; then
        # shellcheck disable=SC1090
        . "${STATE_FILE}"
    fi
}

write_state() {
    mkdir -p "$(dirname "${STATE_FILE}")"
    cat > "${STATE_FILE}" <<EOF
OUTPUT='${OUTPUT}'
PREV_SCALE='${PREV_SCALE}'
DEPTH='${DEPTH}'
EOF
}

push_output() {
    factor="$(resolve_factor)"
    if ! awk -v s="${factor}" 'BEGIN { exit !(s+0 > 1.01) }'; then
        return 0
    fi
    if ! sway_ready; then
        echo "batocera-ui-scale: sway not available; skip output scale" >&2
        return 0
    fi

    read_state
    if [ "${DEPTH}" -gt 0 ] 2>/dev/null; then
        DEPTH=$((DEPTH + 1))
        write_state
        return 0
    fi

    output="$(focused_output)"
    if [ -z "${output}" ]; then
        echo "batocera-ui-scale: no sway output; skip" >&2
        return 0
    fi

    prev="$(current_output_scale "${output}")"
    prev="$(normalize_factor "${prev}" 2>/dev/null || echo "1")"

    if ! swaymsg "output ${output} scale ${factor}" >/dev/null 2>&1; then
        echo "batocera-ui-scale: failed to set ${output} scale ${factor}" >&2
        return 0
    fi

    OUTPUT="${output}"
    PREV_SCALE="${prev}"
    DEPTH="1"
    write_state
}

pop_output() {
    if ! sway_ready; then
        rm -f "${STATE_FILE}"
        return 0
    fi
    if [ ! -f "${STATE_FILE}" ]; then
        return 0
    fi

    read_state
    if [ -z "${DEPTH}" ] || [ "${DEPTH}" -le 0 ] 2>/dev/null; then
        rm -f "${STATE_FILE}"
        return 0
    fi

    DEPTH=$((DEPTH - 1))
    if [ "${DEPTH}" -gt 0 ]; then
        write_state
        return 0
    fi

    if [ -n "${OUTPUT}" ]; then
        swaymsg "output ${OUTPUT} scale ${PREV_SCALE}" >/dev/null 2>&1 || \
            swaymsg "output ${OUTPUT} scale 1" >/dev/null 2>&1 || true
    fi
    rm -f "${STATE_FILE}"
}

cmd="${1:-factor}"
case "${cmd}" in
    factor|"")
        resolve_factor
        ;;
    env)
        print_env
        ;;
    chromium-arg|chromium)
        print_chromium_arg
        ;;
    push-output|push)
        push_output
        ;;
    pop-output|pop)
        pop_output
        ;;
    begin)
        # Raise compositor scale; emit compositor-safe env (no QT/GDK double-scale).
        push_output
        print_env compositor
        ;;
    -h|--help|help)
        sed -n '2,30p' "$0"
        ;;
    *)
        echo "Usage: $0 [factor|env|chromium-arg|push-output|pop-output|begin]" >&2
        exit 2
        ;;
esac

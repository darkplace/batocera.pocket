#!/bin/sh

PIDFILE="/var/run/batocera-nightmode-watch.pid"

is_running() {
    [ -f "${PIDFILE}" ] || return 1
    kill -0 "$(cat "${PIDFILE}" 2>/dev/null)" 2>/dev/null
}

case "$1" in
    start)
        [ -x /usr/bin/batocera-nightmode ] || exit 0
        if is_running; then
            exit 0
        fi
        /usr/bin/batocera-nightmode watch >/dev/null 2>&1 &
        echo "$!" > "${PIDFILE}"
        ;;
    stop)
        if is_running; then
            kill "$(cat "${PIDFILE}")" 2>/dev/null || true
        fi
        rm -f "${PIDFILE}"
        [ -x /usr/bin/batocera-nightmode ] && /usr/bin/batocera-nightmode stop >/dev/null 2>&1
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    status)
        if is_running; then
            echo "running"
            exit 0
        fi
        echo "stopped"
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0

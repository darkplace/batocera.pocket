From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suckbluefrog <suckbluefrog@proton.me>
Date: Fri, 10 Jul 2026 00:00:00 +000
Subject: [PATCH] aurora: fetch Dawn dependencies without shallow clones

Dawn's fetch_dawn_dependencies.py defaults to shallow fetches and does
not fail when a git fetch or checkout fails. Some Chromium mirrors do
not allow fetching every pinned dependency SHA with --depth=1, which can
leave an empty dependency checkout and fail later during code generation.

Patch the downloaded Dawn source before it is configured so the helper
uses full clones.
---
 extern/aurora/cmake/AuroraDawnProvider.cmake             | 4 ++++
 extern/aurora/cmake/patches/force-dawn-no-shallow.cmake  | 21 +++++++++++++++++++++
 2 files changed, 25 insertions(+)
 create mode 100644 extern/aurora/cmake/patches/force-dawn-no-shallow.cmake

diff --git a/extern/aurora/cmake/AuroraDawnProvider.cmake b/extern/aurora/cmake/AuroraDawnProvider.cmake
index 1d4cf0b..b9bce13 100644
--- a/extern/aurora/cmake/AuroraDawnProvider.cmake
+++ b/extern/aurora/cmake/AuroraDawnProvider.cmake
@@ -138,6 +138,10 @@ if (_aurora_dawn_provider STREQUAL "vendor")
     FetchContent_Declare(dawn
       URL "https://github.com/google/dawn/archive/${AURORA_DAWN_REF}.tar.gz"
       DOWNLOAD_EXTRACT_TIMESTAMP FALSE
+      PATCH_COMMAND
+        ${CMAKE_COMMAND}
+        -DDAWN_PATCH_SOURCE_DIR=<SOURCE_DIR>
+        -P "${CMAKE_CURRENT_LIST_DIR}/patches/force-dawn-no-shallow.cmake"
       EXCLUDE_FROM_ALL
     )
     FetchContent_MakeAvailable(dawn)
diff --git a/extern/aurora/cmake/patches/force-dawn-no-shallow.cmake b/extern/aurora/cmake/patches/force-dawn-no-shallow.cmake
new file mode 100644
index 0000000..a0f5f94
--- /dev/null
+++ b/extern/aurora/cmake/patches/force-dawn-no-shallow.cmake
@@ -0,0 +1,21 @@
+if(NOT DEFINED DAWN_PATCH_SOURCE_DIR)
+  message(FATAL_ERROR "DAWN_PATCH_SOURCE_DIR is required")
+endif()
+
+set(_third_party_cmake "${DAWN_PATCH_SOURCE_DIR}/third_party/CMakeLists.txt")
+file(READ "${_third_party_cmake}" _content)
+
+if(_content MATCHES "--no-shallow")
+  return()
+endif()
+
+set(_needle [=[            "${PROJECT_SOURCE_DIR}/tools/fetch_dawn_dependencies.py"
+            --directory ${PROJECT_SOURCE_DIR}]=])
+set(_replacement [=[            "${PROJECT_SOURCE_DIR}/tools/fetch_dawn_dependencies.py"
+            --no-shallow
+            --directory ${PROJECT_SOURCE_DIR}]=])
+
+string(REPLACE "${_needle}" "${_replacement}" _patched "${_content}")
+if(_patched STREQUAL _content)
+  message(FATAL_ERROR "Could not patch Dawn dependency fetch command")
+endif()
+file(WRITE "${_third_party_cmake}" "${_patched}")
-- 
2.50.0


config BR2_PACKAGE_OPENGOAL
	bool "opengoal"
	depends on BR2_aarch64 || BR2_x86_64
	depends on BR2_HOSTARCH = "x86_64"
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	depends on !BR2_STATIC_LIBS
	depends on BR2_USE_MMU
	depends on BR2_PACKAGE_PULSEAUDIO_HAS_ATOMIC
	select BR2_PACKAGE_BOX64 if BR2_aarch64
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_PULSEAUDIO
	help
	  OpenGOAL runtime, extractor, and compiler for the Jak and
	  Daxter series.

	  On aarch64 targets, this package builds the x86_64 Linux
	  OpenGOAL binaries from source and runs them through Box64.
	  Requires a user-supplied original PS2 game ISO at runtime.

	  https://github.com/open-goal/jak-project

comment "opengoal needs a glibc C++ toolchain, dynamic libs, wchar, threads, and an x86_64 build host"
	depends on (!BR2_aarch64 && !BR2_x86_64) || BR2_HOSTARCH != "x86_64" || \
		!BR2_TOOLCHAIN_USES_GLIBC || !BR2_INSTALL_LIBSTDCPP || BR2_STATIC_LIBS || \
		!BR2_TOOLCHAIN_HAS_THREADS || !BR2_USE_WCHAR || !BR2_USE_MMU || \
		!BR2_PACKAGE_PULSEAUDIO_HAS_ATOMIC
